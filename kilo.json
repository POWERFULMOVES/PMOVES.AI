{
  "$schema": "https://kilo.ai/schemas/project.json",
  "default_agent": "kilocode-glm",
  "model": "zai/glm-5-turbo",
  "small_model": "zai/glm-4-air",
  "instructions": [
    ".claude/CLAUDE.md",
    "AGENTS.md",
    ".kilocode/rules/kilorules.md",
    ".kilocodemodes",
    ".kilo/agent/**/*.md"
  ],
  "provider": {
    "zai": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "timeout": 300000,
        "apiKey": "${Z_AI_API_KEY}"
      },
      "models": {
        "glm-5-turbo": { "name": "GLM-5 Turbo" },
        "glm-5.1": { "name": "GLM-5.1" },
        "glm-4.7": { "name": "GLM-4.7" },
        "glm-4.6": { "name": "GLM-4.6" },
        "glm-4.6v": { "name": "GLM-4.6V (Vision)" },
        "glm-4-air": { "name": "GLM-4 Air (Fast)" }
      },
      "whitelist": ["glm-*"]
    },
    "minimax": {
      "options": {
        "baseURL": "https://api.minimax.chat/v1",
        "timeout": 300000,
        "apiKey": "${MINIMAX_API_KEY}"
      },
      "models": {
        "minimax-m2.7": { "name": "MiniMax-M2.7 (1M Context)" },
        "minimax-m2.1": { "name": "MiniMax-M2.1 (100K Context)" }
      },
      "whitelist": ["minimax-*"]
    }
  },
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "environment": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "zai-web-search": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": { "Authorization": "Bearer ${Z_AI_API_KEY}" }
    },
    "zai-web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": { "Authorization": "Bearer ${Z_AI_API_KEY}" }
    },
    "zai-zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": { "Authorization": "Bearer ${Z_AI_API_KEY}" }
    }
  },
  "skills": {
    "paths": [".kilocode/skills"],
    "urls": []
  },
  "permission": {
    "bash": "allow",
    "edit": {
      "**": "allow"
    },
    "read": "allow",
    "zai-vision_*": "allow",
    "zai-web-search_*": "allow",
    "zai-web-reader_*": "allow",
    "zai-zread_*": "allow"
  }
}
