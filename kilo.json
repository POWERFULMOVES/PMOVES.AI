{
  "$schema": "https://kilo.ai/schemas/project.json",
  "default_agent": "kilocode-glm",
  "model": "zai/glm-5-turbo",
  "small_model": "zai/glm-4-air",
  "instructions": [
    ".claude/CLAUDE.md",
    "AGENTS.md",
    ".kilocode/rules/kilorules.md",
    ".kilocodemodes",
    ".kilo/agent/**/*.md"
  ],
  "provider": {
    "zai": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "timeout": 300000,
        "apiKey": "${Z_AI_API_KEY}"
      },
      "models": {
        "glm-5-turbo": { "name": "GLM-5 Turbo (Agentic)" },
        "glm-5.1": { "name": "GLM-5.1 (Long-Horizon)" },
        "glm-5v-turbo": { "name": "GLM-5V Turbo (Vision+Coding)" },
        "glm-4-air": { "name": "GLM-4 Air (Fast/Edge)" }
      },
      "whitelist": ["glm-*"]
    },
    "minimax": {
      "options": {
        "baseURL": "https://api.minimax.chat/v1",
        "timeout": 300000,
        "apiKey": "${MINIMAX_API_KEY}"
      },
      "models": {
        "minimax-m2.7": { "name": "MiniMax-M2.7 (1M Context)" },
        "minimax-m2.1": { "name": "MiniMax-M2.1 (100K Context)" }
      },
      "whitelist": ["minimax-*"]
    }
  },
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": ["npx", "-y", "@z_ai/mcp-server"],
      "environment": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "zai-web-search": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": { "Authorization": "Bearer ${Z_AI_API_KEY}" }
    },
    "zai-web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": { "Authorization": "Bearer ${Z_AI_API_KEY}" }
    },
    "zai-zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": { "Authorization": "Bearer ${Z_AI_API_KEY}" }
    },
    "docker": {
      "type": "local",
      "command": ["docker", "run", "--rm", "-i", "--mount", "type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock", "mcp/docker"],
      "environment": {}
    },
    "pmoves-cipher": {
      "type": "remote",
      "url": "http://localhost:8105/mcp/sse",
      "headers": { "Authorization": "Bearer ${CIPHER_API_TOKEN}" }
    },
    "tailscale": {
      "type": "local",
      "command": ["npx", "-y", "tailscale-mcp@latest"],
      "environment": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}"
      }
    },
    "huggingface": {
      "type": "local",
      "command": ["npx", "-y", "@anthropic-ai/huggingface-mcp@latest"],
      "environment": {
        "HF_API_KEY": "${HF_TOKEN}"
      }
    }
  },
  "skills": {
    "paths": [".kilocode/skills"],
    "urls": []
  },
  "permission": {
    "bash": "allow",
    "edit": {
      "**": "allow"
    },
    "read": "allow",
    "browser": "allow",
    "zai-vision_*": "allow",
    "zai-web-search_*": "allow",
    "zai-web-reader_*": "allow",
    "zai-zread_*": "allow",
    "docker_*": "allow",
    "pmoves-cipher_*": "allow",
    "tailscale_*": "allow",
    "huggingface_*": "allow"
  }
}
