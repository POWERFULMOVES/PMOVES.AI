{
  "$schema": "https://kilo.ai/schemas/project.json",
  "default_agent": "kilocode-glm",
  "model": "zai/glm-5.2",
  "small_model": "zai/glm-4-air",
  "instructions": [
    ".claude/CLAUDE.md",
    "AGENTS.md",
    ".kilocode/rules/kilorules.md",
    ".kilocodemodes",
    ".kilo/agent/**/*.md"
  ],
  "provider": {
    "zai": {
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4/",
        "timeout": 300000,
        "apiKey": "${Z_AI_API_KEY}"
      },
      "models": {
        "glm-5.2": {
          "name": "GLM-5.2 (Latest)"
        },
        "glm-5-turbo": {
          "name": "GLM-5 Turbo (Agentic)"
        },
        "glm-5.1": {
          "name": "GLM-5.1 (Reasoning)"
        },
        "glm-5v-turbo": {
          "name": "GLM-5V Turbo (Vision+Coding)"
        },
        "glm-4.7": {
          "name": "GLM-4.7 (Balanced Coding)"
        },
        "glm-4-air": {
          "name": "GLM-4 Air (Fast)"
        }
      },
      "whitelist": [
        "glm-*"
      ]
    },
    "minimax": {
      "options": {
        "baseURL": "https://api.minimax.chat/v1",
        "timeout": 300000,
        "apiKey": "${MINIMAX_API_KEY}"
      },
      "models": {
        "minimax-m2.7": {
          "name": "MiniMax-M2.7 (1M Context)"
        },
        "minimax-m2.1": {
          "name": "MiniMax-M2.1 (100K Context)"
        }
      },
      "whitelist": [
        "minimax-*"
      ]
    }
  },
  "enabled_providers": [
    "zai",
    "minimax"
  ],
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "zai-web-search": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "zai-web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "zai-zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "pmoves-cipher": {
      "type": "remote",
      "url": "http://${TS_Z890}:8105/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${CIPHER_API_TOKEN}"
      }
    },
    "tailscale": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tailscale-mcp@2026.4.10-1"
      ],
      "environment": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
        "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
      }
    },
    "huggingface": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@llmindset/hf-mcp-server@0.3.30"
      ],
      "environment": {
        "HF_TOKEN": "${HF_TOKEN}"
      }
    },
    "agent-zero": {
      "type": "remote",
      "url": "http://${TS_Z890}:8081/mcp/t-${AGENT_ZERO_MCP_TOKEN}/sse"
    },
    "pmoves-nats-fleet": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "./pmoves-nats-mcp",
        "run",
        "python",
        "-m",
        "nats_mcp.server"
      ],
      "environment": {
        "NATS_URL": "${NATS_URL}"
      }
    },
    "pmoves-supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-postgrest@0.1.1",
        "--apiUrl",
        "http://localhost:8000/rest/v1",
        "--apiKey",
        "${SUPABASE_SERVICE_KEY}",
        "--schema",
        "public",
        "${SUPABASE_REST_URL:-http://localhost:8000/rest/v1}",
        "${SUPABASE_SERVICE_ROLE_KEY:-${SUPABASE_SERVICE_KEY}}",
        "${SUPABASE_SERVICE_ROLE_KEY:-${SUP\u2026EY}}"
      ]
    },
    "supabase-db": {
      "type": "local",
      "command": [
        "uvx",
        "postgres-mcp@0.3.0",
        "--access-mode=unrestricted"
      ],
      "environment": {
        "DATABASE_URI": "${SUPABASE_DB_URI}"
      }
    },
    "pmoves-docker-gateway-sse": {
      "type": "remote",
      "url": "http://localhost:8090/sse",
      "headers": {
        "Authorization": "Bearer ${CIPHER_API_TOKEN}"
      }
    },
    "archon": {
      "type": "remote",
      "url": "http://${TS_Z890}:8051",
      "disabled": true
    },
    "hostinger": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "pmz-hostinger",
        "hostinger-api-mcp"
      ],
      "environment": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    }
  },
  "skills": {
    "paths": [
      ".kilocode/skills"
    ],
    "urls": []
  },
  "permission": {
    "bash": "allow",
    "edit": {
      "**": "allow"
    },
    "read": "allow",
    "zai-vision_*": "allow",
    "zai-web-search_*": "allow",
    "zai-web-reader_*": "allow",
    "zai-zread_*": "allow",
    "pmoves-cipher_*": "allow",
    "tailscale_*": "allow",
    "huggingface_*": "allow",
    "agent-zero_*": "allow",
    "pmoves-nats-fleet_*": "allow",
    "pmoves-supabase_*": "allow",
    "supabase-db_*": "allow",
    "pmoves-docker-gateway-sse_*": "allow",
    "archon_*": "allow",
    "hostinger_*": "allow"
  }
}
