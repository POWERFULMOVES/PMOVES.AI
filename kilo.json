{
  "$schema": "https://app.kilo.ai/config.json",
  "default_agent": "kilocode-glm",
  "model": "zai-coding-plan/glm-5.3",
  "small_model": "zai-coding-plan/glm-5.3-flash",
  "instructions": [
    ".claude/CLAUDE.md",
    "AGENTS.md",
    ".kilocode/rules/kilorules.md",
    ".kilocodemodes",
    ".kilo/agent/**/*.md"
  ],
  "provider": {
    "zai-coding-plan": {
      "env": [
        "Z_AI_API_KEY"
      ],
      "options": {
        "timeout": 300000
      },
      "whitelist": [
        "glm-5.3",
        "glm-5.3-flash"
      ]
    },
    "minimax-coding-plan": {
      "env": [
        "MINIMAX_TOKEN_PLAN_API_KEY"
      ],
      "options": {
        "timeout": 300000
      },
      "whitelist": [
        "MiniMax-M3",
        "MiniMax-M2.7"
      ]
    },
    "kilo": {
      "options": {
        "timeout": 300000
      }
    }
  },
  "enabled_providers": [
    "zai-coding-plan",
    "minimax-coding-plan",
    "kilo"
  ],
  "mcp": {
    "zai-vision": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    },
    "zai-web-search": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "zai-web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "zai-zread": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer ${Z_AI_API_KEY}"
      }
    },
    "pmoves-cipher": {
      "type": "remote",
      "url": "http://${TS_Z890}:8105/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${CIPHER_API_TOKEN}"
      }
    },
    "tailscale": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "tailscale-mcp@2026.4.10-1"
      ],
      "environment": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
        "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
      }
    },
    "huggingface": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@llmindset/hf-mcp-server@0.3.30"
      ],
      "environment": {
        "HF_TOKEN": "${HF_TOKEN}"
      }
    },
    "agent-zero": {
      "type": "remote",
      "url": "http://${TS_Z890}:8081/mcp/t-${AGENT_ZERO_MCP_TOKEN}/sse"
    },
    "pmoves-nats-fleet": {
      "type": "local",
      "command": [
        "uv",
        "--directory",
        "./pmoves-nats-mcp",
        "run",
        "python",
        "-m",
        "nats_mcp.server"
      ],
      "environment": {
        "NATS_URL": "${NATS_URL}"
      }
    },
    "pmoves-supabase": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@supabase/mcp-server-postgrest@0.1.1",
        "--apiUrl",
        "${SUPABASE_REST_URL:-http://localhost:8000/rest/v1}",
        "--apiKey",
        "${ANON_KEY}",
        "--schema",
        "public"
      ],
      "enabled": false
    },
    "supabase-db": {
      "type": "local",
      "command": [
        "uvx",
        "postgres-mcp@0.3.0",
        "--access-mode=restricted"
      ],
      "environment": {
        "DATABASE_URI": "${SUPABASE_DB_URI}"
      }
    },
    "pmoves-docker-gateway-sse": {
      "type": "remote",
      "url": "http://localhost:8090/sse",
      "headers": {
        "Authorization": "Bearer ${CIPHER_API_TOKEN}"
      }
    },
    "archon": {
      "type": "remote",
      "url": "http://${TS_Z890}:8051",
      "enabled": false
    },
    "hostinger": {
      "type": "local",
      "command": [
        "docker",
        "exec",
        "-i",
        "pmz-hostinger",
        "hostinger-api-mcp"
      ],
      "environment": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    }
  },
  "skills": {
    "paths": [
      ".kilocode/skills"
    ],
    "urls": []
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff": "allow",
      "git diff --stat": "allow",
      "git diff --name-only": "allow",
      "git diff --name-status": "allow",
      "git diff --cached": "allow",
      "git diff --cached --stat": "allow",
      "git diff --staged": "allow",
      "git diff --staged --stat": "allow",
      "git diff HEAD": "allow",
      "git diff HEAD --stat": "allow",
      "git diff origin/main...HEAD": "allow",
      "git diff origin/main...HEAD --stat": "allow",
      "git diff origin/main...HEAD --name-only": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git branch -v": "allow",
      "git branch -vv": "allow",
      "git branch --show-current": "allow",
      "git worktree list *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "pwd *": "allow",
      "*\"*": "ask",
      "*'*": "ask",
      "*{*": "ask",
      "*[*": "ask",
      "*$*": "ask",
      "*`*": "ask",
      "*>*": "ask",
      "git diff *-/*": "ask",
      "git diff *--o/*": "ask",
      "git log *-/*": "ask",
      "git log *--o/*": "ask",
      "git show *-/*": "ask",
      "git show *--o/*": "ask",
      "*.example*": "ask",
      "git stash *": "deny",
      "git diff *--ou*": "deny",
      "git log *--ou*": "deny",
      "git show *--ou*": "deny",
      "git branch *-d*": "deny",
      "git branch *-D*": "deny",
      "git branch *-f*": "deny",
      "git branch *-m*": "deny",
      "git branch *-M*": "deny",
      "rg *--pre*": "deny",
      "make *--eval*": "deny",
      "make -E*": "deny",
      "make * -E*": "deny",
      "make -f*": "deny",
      "make * -f*": "deny",
      "make *--file*": "deny",
      "make *--makefile*": "deny",
      "env": "deny",
      "env *": "deny",
      "printenv": "deny",
      "printenv *": "deny",
      "*/proc/*/environ*": "deny",
      "*env.tier-*": "deny",
      "* .env": "deny",
      "* .env *": "deny",
      "* .env.*": "deny",
      "*/.env": "deny",
      "*/.env *": "deny",
      "*/.env.*": "deny",
      "*=.env": "deny",
      "*=.env *": "deny",
      "*=.env.*": "deny",
      "*env.shared": "deny",
      "*env.shared *": "deny",
      "*env.shared.bak*": "deny",
      "*env.shared~*": "deny"
    },
    "edit": {
      "**": "allow",
      ".git": "deny",
      ".git/*": "deny",
      "*/.git": "deny",
      "*/.git/*": "deny",
      "-*": "deny",
      "*/-*": "deny"
    },
    "read": {
      "*": "allow",
      "pmoves/env.*": "deny",
      "*/env.shared*": "deny",
      "*env.tier-*": "deny",
      "*.example": "allow"
    },
    "external_directory": {
      "*": "ask",
      "/proc/*": "deny"
    },
    "zai-vision_*": "allow",
    "zai-web-search_*": "allow",
    "zai-web-reader_*": "allow",
    "zai-zread_*": "allow",
    "pmoves-cipher_*": "allow",
    "tailscale_*": "allow",
    "huggingface_*": "allow",
    "agent-zero_*": "allow",
    "pmoves-nats-fleet_*": "allow",
    "pmoves-supabase_*": "allow",
    "supabase-db_*": "allow",
    "pmoves-docker-gateway-sse_*": "allow",
    "archon_*": "allow",
    "hostinger_*": "allow"
  }
}
