# Cloudflare Pages security headers.
# Applied on every request. Tighten as real endpoints / analytics land.
#
# IMPORTANT (CSP): Cloudflare Pages *appends* matching _headers rules — it does
# not let a more-specific path override a less-specific one. Two Content-Security-Policy
# headers are enforced as their intersection (most restrictive) by the browser. So CSP
# is NOT set on /* here; it is set per-document-route instead:
#   - /            → strict marketing policy
#   - /hyperdim/*  → looser policy the WebGL viewer needs (eval + cdnjs/unpkg)
#   - /embeds/beats-constellation/* → stricter canvas-embed policy (no eval, no CDN hosts)
#   - /stage/*     → strict A2UI surface policy (vendored bundle, no eval, no inline)
# CSP only affects document responses; the document routes are /, /hyperdim/*,
# /embeds/beats-constellation/*, and /stage/*
# (everything else in _redirects is a 30x redirect or an off-site link).

/*
  # --- Security (shared, no CSP — see note above) ---
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  # SAMEORIGIN (not DENY): the homepage embeds same-origin /hyperdim/ viewers in iframes.
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# --- Marketing document (strict CSP) ---
#   - default-src 'self' blocks everything unless explicitly allowed.
#   - 'self' covers index.html, styles.css, main.js, assets/.
#   - frame-ancestors 'self' lets the site frame itself (same-origin embeds).
#   - frame-src 'self' lets the homepage embed the /hyperdim/ viewers; YouTube kept for optional video.
#   - Inline <style> and <script> disallowed here — the marketing page ships external files only.
#   - TODO(founder): when Cloudflare Web Analytics is enabled, add
#     https://static.cloudflareinsights.com to script-src and the matching connect-src host.
# connect-src includes LOOPBACK-ONLY origins for the DL-3.3 persona demo
# (?agent= resolves accents via the local BoTZ Gateway :8054; Showtime :9225
# drives the live flip). These are the *visitor's* loopback — harmless for the
# public, functional on-net. persona-theme.js additionally restricts ?gw=
# overrides to loopback, so no remote host can ever be fetched.
/
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self' mailto:; frame-ancestors 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self' data:; connect-src 'self' http://localhost:8054 http://127.0.0.1:8054 http://localhost:9225 http://127.0.0.1:9225; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; upgrade-insecure-requests

# --- Hyperdimensions WebGL viewer (sandboxed to its own path) ---
# Self-contained webtoy: three.js (unpkg importmap), CodeMirror + math.js (cdnjs), an inline
# <script type="module">, and it compiles user-entered surface functions with `new Function`
# — so it genuinely needs 'unsafe-eval' and 'unsafe-inline'. Scoping this loose policy to
# /hyperdim/* keeps the eval-capable surface off the rest of the site (defense in depth).
/hyperdim/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://unpkg.com; font-src 'self' data:; connect-src 'self' https://unpkg.com; worker-src 'self' blob:; object-src 'none'

# --- Beats Constellation embed (self-contained canvas; stricter than hyperdim) ---
# Single-file canvas star-chart: inline <script type="module"> + inline <style>, no external
# hosts, no eval/new Function. Needs 'unsafe-inline' for the inline tags only — deliberately
# NO 'unsafe-eval' and no CDN hosts, so it's tighter than /hyperdim/*.
/embeds/beats-constellation/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://esm.sh; font-src 'self' data:; connect-src 'self' https://esm.sh; object-src 'none'

# --- Stage (A2UI rooms-on-a-stage, DL-4.1) ---
# Vendored @a2ui/lit bundle (no CDN, no eval — verified in stage/vendor/README.md).
# Component styles use constructable stylesheets (CSP-exempt), but the theme's
# additionalStyles land as style="" attributes via Lit styleMap — measured under
# this exact policy, strict style-src blanks the card surfaces. So ONLY the
# attribute channel is opened (style-src-attr); style-src stays 'self', meaning
# no <style> injection and no external sheets. script-src stays strict 'self'.
# connect-src includes the same LOOPBACK-ONLY origins as the root policy for the
# DL-4.2 persona demo (?agent= → BoTZ Gateway :8054 accents; Showtime :9225 live
# flip) — the *visitor's* loopback: harmless off-net, functional on-net, and
# persona-theme.js restricts ?gw= overrides to loopback.
/stage/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; frame-ancestors 'self'; img-src 'self' data:; style-src 'self'; style-src-attr 'unsafe-inline'; script-src 'self'; font-src 'self' data:; connect-src 'self' http://localhost:8054 http://127.0.0.1:8054 http://localhost:9225 http://127.0.0.1:9225; object-src 'none'

# --- Long-cache static assets ---
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=3600, must-revalidate

/main.js
  Cache-Control: public, max-age=3600, must-revalidate
