# Kilocode plugin — ignore bootstrap artifacts, keep tracked content
# .kilo/ has agent/ + command/ + hooks/; .kilocode/ has rules/ + skills/
# Pattern: ignore the whole dir, negate the tracked subdirs (future-proofs new artifact types)
.kilo/*
!.kilo/agent/
!.kilo/command/
!.kilo/hooks/
.kilocode/*
!.kilocode/rules/
!.kilocode/skills/
Z.AI_MAX_Plan_Developer_Reference.html

# Runtime state files (not version-controlled)
pmoves/services/agent-zero/.a0-upstream-version
memory/audit/

# Local document edits (ODS lock files)
document/

# Bulk subtitle/transcript files
*.vtt
# Raw transcript files (bulk, not version-controlled)
research/transcripts/

# Docker MCP toolkit local artifacts (not for repo)
profiles.json
update.finished
.kimi/mcp.json
.kimi/mcp.json.pre-toolkit-connect.bak

