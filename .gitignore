# PMOVES.AI gitignore

# =============================================================================
# Python venvs (machine-local; canonical bringup venv is pmoves/.venv-pmoves/
# via `make -C pmoves venv-bringup` — see pmoves/scripts/create_venv.sh)
# =============================================================================
.venv/
/venv/
pmoves/.venv-pmoves/

# =============================================================================
# AutoClaw / AutoGLM local workspace state (machine-local, not PMOVES code)
# =============================================================================
HEARTBEAT.md
IDENTITY.md
SOUL.md
TOOLS.md
USER.md
.openclaw/
.opencode/
/config/

# =============================================================================
# Codex CLI workspace (machine-local agent scratch — not source)
# =============================================================================
.codex/

# =============================================================================
# UNFCU separation/grievance record (private; attorney-review draft per file header)
# =============================================================================
pmoves/docs/operations/UNFCU_RECORD_OF_CLAIMS.md

# =============================================================================
# Infrastructure Secrets (relay keys, QR configs, audits — NEVER COMMIT)
# =============================================================================
rustdesk-*-qr.png
**/rustdesk-*-qr.png
pmoves/docs/security/FLEET_AUDIT_*.md
pmoves/scripts/fleet/.enrollment-ledger.jsonl

# =============================================================================
# Environment & Secrets (NEVER COMMIT)
# =============================================================================
.env
.env.*
!.env.example
!.env.shared.example
!.env.shared.sh
!.env.template
!.env.tier-*
env.tier-*
# Runtime-populated credential files (never commit populated values)
pmoves/env.shared
pmoves/env.mesh-bind.local
pmoves/.supabase.status.env
pmoves/env.supa.runtime
# Bootstrap-generated env fragments + supabase env (can carry live secrets)
pmoves/env.*.additions
pmoves/env.supabase
secrets/
!pmoves/integrations/**/secrets/
!pmoves/integrations/**/secrets/labels.yaml
*.pem
*.key
!*.key.example

# =============================================================================
# CHIT Geometry Packets
# =============================================================================
pmoves/data/chit/env.cgp.json

# =============================================================================
# Temporary check directories (moved to /tmp/pmoves-check-backup-*)
# =============================================================================
PMOVES-BoTZ-check/
PMOVES-DoX-check/
PMOVES-HiRAG-check/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!pmoves/ui/lib/
!pmoves/ui/lib/rooms.ts
!pmoves/ui/lib/__tests__/
!pmoves/ui/lib/__tests__/rooms.test.ts
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# =============================================================================
# Node.js
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# Claude Code local settings (user-specific permissions, never commit)
# =============================================================================
.claude/settings.local.json
# Per-node MCP-config backups created by `docker mcp client connect` flow
.claude/mcp.json.pre-toolkit-connect.bak
.mcp.json.pre-toolkit-connect.bak
*.pre-mcp-bootstrap.bak

# Docker MCP Toolkit's per-node Claude Code MCP registration. Generated by
# `docker mcp client connect claude-code --profile <name>` and contains
# host-specific env paths (LOCALAPPDATA, ProgramData, ProgramFiles on Windows;
# different on Linux/macOS). Never commit — each node generates its own via
# `make mcp-toolkit-connect`.
.mcp.json

# Claude Code local backup files (created automatically before destructive edits;
# operator-private rollback safety net. Pattern matches .bak suffix anywhere under .claude/).
.claude/*.bak
.claude/**/*.bak

# =============================================================================
# IDE
# =============================================================================
.idea/
# .vscode/ is intentionally committed — team-wide workspace config, tasks, and agent defaults
# Personal/user-specific VSCode files go in .vscode/*.code-workspace (add those to gitignore if needed)
.history/
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# Logs & Databases
# =============================================================================
*.log
*.db
*.sqlite
*.sqlite3
pmoves/data/agent-zero/memory/
pmoves/data/agent-zero/logs/
pmoves/data/open-notebook/surreal_data/

