# PMOVES.AI gitignore

# =============================================================================
# Infrastructure Secrets (relay keys, QR configs, audits — NEVER COMMIT)
# =============================================================================
rustdesk-*-qr.png
**/rustdesk-*-qr.png
pmoves/docs/security/FLEET_AUDIT_*.md
pmoves/scripts/fleet/.enrollment-ledger.jsonl

# =============================================================================
# Environment & Secrets (NEVER COMMIT)
# =============================================================================
.env
.env.*
!.env.example
!.env.shared.example
!.env.shared.sh
!.env.template
!.env.tier-*
env.tier-*
# Runtime-populated credential files (never commit populated values)
pmoves/env.shared
pmoves/env.mesh-bind.local
pmoves/.supabase.status.env
pmoves/env.supa.runtime
secrets/
!pmoves/integrations/**/secrets/
!pmoves/integrations/**/secrets/labels.yaml
*.pem
*.key
!*.key.example

# =============================================================================
# CHIT Geometry Packets
# =============================================================================
pmoves/data/chit/env.cgp.json

# =============================================================================
# Temporary check directories (moved to /tmp/pmoves-check-backup-*)
# =============================================================================
PMOVES-BoTZ-check/
PMOVES-DoX-check/
PMOVES-HiRAG-check/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!pmoves/ui/lib/
!pmoves/ui/lib/rooms.ts
!pmoves/ui/lib/__tests__/
!pmoves/ui/lib/__tests__/rooms.test.ts
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# =============================================================================
# Node.js
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================================================
# Claude Code local settings (user-specific permissions, never commit)
# =============================================================================
.claude/settings.local.json

# =============================================================================
# IDE
# =============================================================================
.idea/
.vscode/
.history/
*.swp
*.swo
*~
.DS_Store

# =============================================================================
# Logs & Databases
# =============================================================================
*.log
*.db
*.sqlite
*.sqlite3
pmoves/data/agent-zero/memory/
pmoves/data/agent-zero/logs/
pmoves/data/open-notebook/surreal_data/

# =============================================================================
# Docker
# =============================================================================
.dockerignore
.docker/

# =============================================================================
# Temporary Files
# =============================================================================
tmp/
temp/
*.tmp
*.temp

# =============================================================================
# Build Outputs (generated by services and packages)
# =============================================================================
pmoves/services/a2ui-renderer/dist/
pmoves/services/a2ui-renderer/node_modules/
pmoves/packages/chit/dist/
pmoves/packages/chit/node_modules/

# =============================================================================
# Cipher MCP Bridge
# =============================================================================
pmoves-cipher-mcp/.venv/
pmoves-cipher-mcp/__pycache__/
pmoves-cipher-mcp/uv.lock

# =============================================================================
# Orphaned submodule directories (gitlink removed, physical dir remains)
# =============================================================================
# pmoves-e2b-mcp-server/ moved to submodule
pmoves/vendor/
research/A2UI/

# =============================================================================
# Runtime Data (generated by services, never commit)
# =============================================================================
pmoves/jellyfin-ai/cache/
pmoves/jellyfin-ai/media/
pmoves/jellyfin-ai/output/
pmoves/jellyfin-ai/logs/
pmoves/jellyfin-ai/neo4j/
pmoves/jellyfin-ai/qwen/
pmoves/jellyfin-ai/redis/
pmoves/jellyfin-ai/config/cache/
pmoves/jellyfin-ai/config/data/
pmoves/jellyfin-ai/config/.aspnet/
pmoves/jellyfin-ai/config/.cache/
pmoves/jellyfin-ai/config/.jellyfin-config
pmoves/jellyfin-ai/config/log/
pmoves/jellyfin-ai/config/*.xml
pmoves/jellyfin-ai/config/*.json
!pmoves/jellyfin-ai/config/www/
pmoves/pmoves/PR_EVIDENCE/
pmoves/docs/logs/pr_monitor_*.json
pmoves/docs/logs/pr_monitor_*.md
pmoves/docs/logs/pr_trim_*.json
pmoves/docs/logs/ci_queue_guard_latest.json
pmoves/docs/logs/branch_divergence_*.txt
pmoves/docs/logs/graphiti_signed_latest.json
pmoves/docs/logs/claude_review_latest.cgp.json

# =============================================================================
# DAO Documentation (managed separately)
# =============================================================================
CATACLYSM_STUDIOS_INC/PMOVES DAO/

# =============================================================================
# Environment Backups (auto-generated)
# =============================================================================
pmoves/env.jellyfin-ai
pmoves/env.supa.runtime.bak.*


# =============================================================================
# Terraform
# =============================================================================
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraform/
*.tfstate
*.tfstate.*

# Windows
desktop.ini

# =============================================================================
# Shell artifacts
# =============================================================================
Wrote
pr_body.md
Thumbs.db
NUL

# Git worktrees
.worktrees/
.claude/worktrees/


# Binary artifacts in repo root only
/*.pdf
/*.docx

# Coverage reports
.coverage
.harness/workspace/
.harness/offloads/
.harness/threads/
.a0proj/

# Kilocode plugin — ignore bootstrap artifacts, keep tracked content
# .kilo/ has agent/ + command/; .kilocode/ has rules/ + skills/
# Pattern: ignore the whole dir, negate the tracked subdirs (future-proofs new artifact types)
.kilo/*
!.kilo/agent/
!.kilo/command/
.kilocode/*
!.kilocode/rules/
!.kilocode/skills/
