{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(curl:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(make -C pmoves fleet-*:*)",
      "Bash(make -C pmoves up-*:*)",
      "Bash(make -C pmoves down-*:*)",
      "Bash(make -C pmoves ps-*:*)",
      "Bash(make -C pmoves logs-*:*)",
      "Bash(make -C pmoves volume-*:*)",
      "Bash(make -C pmoves verify-*:*)",
      "Bash(make -C pmoves env-*:*)",
      "Bash(make -C pmoves secrets-*:*)",
      "Bash(make -C pmoves docs-*:*)",
      "Bash(make -C pmoves docker-prune:*)",
      "Bash(make -C pmoves z890-host-setup:*)",
      "Bash(make -C pmoves z890-host-verify:*)",
      "Bash(make -C pmoves z890-host-remove:*)",
      "Bash(make -C pmoves diag-z890:*)",
      "Bash(make -C pmoves gha-runner-4090-*:*)",
      "Bash(docker pull hello-world:*)",
      "Bash(docker run --rm --network host alpine:*)",
      "Bash(docker update --restart no pmoves-4090-runner-*:*)",
      "Bash(docker stop pmoves-4090-runner-*:*)",
      "Bash(docker start pmoves-4090-runner-*:*)",
      "Bash(docker exec pmoves-4090-runner-*:*)",
      "Bash(docker logs pmoves-4090-runner-*:*)",
      "Bash(docker inspect pmoves-4090-runner-*:*)",
      "Bash(curl -sf http://127.0.0.1:8111:*)",
      "Bash(curl -sf http://localhost:8111:*)",
      "Bash(docker exec pmoves-nats-leaf-1:*)",
      "Bash(docker exec pmoves-container-agent-1:*)",
      "Bash(netsh interface portproxy show:*)",
      "Bash(make -C pmoves laptop-harden:*)",
      "Bash(make -C pmoves laptop-harden-verify:*)",
      "Bash(make -C pmoves laptop-harden-remove:*)",
      "Bash(docker update --restart no gha-runner-ai-lab:*)",
      "Bash(docker update --restart no gha-runner-hotfix:*)",
      "Bash(docker update --restart no gha-runner-vps:*)",
      "Bash(docker stop gha-runner-ai-lab:*)",
      "Bash(docker stop gha-runner-hotfix:*)",
      "Bash(docker stop gha-runner-vps:*)",
      "Bash(docker start gha-runner-ai-lab:*)",
      "Bash(docker start gha-runner-hotfix:*)",
      "Bash(docker start gha-runner-vps:*)",
      "Bash(docker exec gha-runner-ai-lab:*)",
      "Bash(docker exec gha-runner-hotfix:*)",
      "Bash(docker exec gha-runner-vps:*)",
      "Bash(docker logs gha-runner-ai-lab:*)",
      "Bash(docker logs gha-runner-hotfix:*)",
      "Bash(docker logs gha-runner-vps:*)",
      "Bash(docker inspect gha-runner-ai-lab:*)",
      "Bash(docker inspect gha-runner-hotfix:*)",
      "Bash(docker inspect gha-runner-vps:*)",
      "Bash(docker exec pmoves-nats-1 nats sub *.test.*:*)",
      "Bash(docker exec pmoves-nats-1 nats sub test.*:*)",
      "Bash(docker exec pmoves-nats-1 nats pub test.*:*)",
      "Bash(docker exec pmoves-nats-1 nats pub *.test.*:*)",
      "Bash(docker run --rm --network host natsio/nats-box:* nats pub test.*:*)",
      "Bash(docker run --rm --network host natsio/nats-box:* nats sub test.*:*)",
      "Bash(docker exec pmoves-agent-zero-1:*)",
      "Bash(docker exec pmoves-nats-1 nats stream:*)",
      "Bash(docker exec pmoves-nats-1 nats account info:*)",
      "Bash(docker exec pmoves-nats-1 nats server info:*)"
    ],
    "deny": [
      "Bash(docker compose up -d:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker system prune -a:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf /:*)"
    ],
    "additionalDirectories": [
      "D:/pinokio"
    ]
  },
  "worktree": {
    "symlinkDirectories": [
      ".claude/hooks",
      ".claude/context",
      ".claude/learnings",
      ".claude/commands",
      ".claude/skills",
      ".claude/agents"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/damage-control/bash-tool-damage-control.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/damage-control/edit-tool-damage-control.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "uv run --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/governance/claim-collision-pre.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/damage-control/write-tool-damage-control.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "uv run --quiet \"$CLAUDE_PROJECT_DIR/.claude/hooks/governance/claim-collision-pre.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-tool-sign-trail.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/kilo-brief-check.sh\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/shift-crew-trail.sh\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-review-chit.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pr-skill-reminder.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/env-known-roads-reminder.sh\"",
            "timeout": 8
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-keyword-surfacer.sh\"",
            "timeout": 8
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-env-check.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[pmoves-agent] Sub-agent completed: $(cat | jq -r '.agent_type // \"unknown\"')\" >&2",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "supabase@claude-plugins-official": false,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "playground@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "huggingface-skills@claude-plugins-official": true
  }
}
