{
  "_pinned_versions_note": "Dependencies pinned to exact versions on 2026-05-14 to prevent supply chain attacks (F-07). Re-pin after auditing new releases before upgrading. hostinger-api-mcp=0.2.1, tailscale-mcp=2026.4.10-1",
  "mcpServers": {
    "pmoves-cipher": {
      "command": "uv",
      "args": ["--directory", "./pmoves-cipher-mcp", "run", "python", "-m", "cipher_mcp.server"],
      "env": {
        "CIPHER_URL": "http://localhost:8105",
        "NATS_URL": "nats://nats:pmoves@nats:4222"
      }
    },
    "docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--mount",
        "type=bind,src=//var/run/docker.sock,dst=/var/run/docker.sock",
        "mcp/docker"
      ]
    },
    "hostinger-mcp": {
      "command": "npx",
      "args": [
        "hostinger-api-mcp@0.2.1"
      ],
      "env": {
        "API_TOKEN": "${HOSTINGER_API_KEY}"
      }
    },
    "tailscale": {
      "command": "npx",
      "args": [
        "tailscale-mcp@2026.4.10-1"
      ],
      "env": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
        "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
      }
    }
  }
}
