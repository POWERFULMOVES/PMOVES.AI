{
  "mcpServers": {
    "pmoves-cipher": {
      "type": "sse",
      "url": "http://localhost:8096/sse"
    },
    "docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--mount",
        "type=bind,src=//var/run/docker.sock,dst=/var/run/docker.sock",
        "mcp/docker"
      ]
    },
    "hostinger-mcp": {
      "command": "npx",
      "args": [
        "hostinger-api-mcp@latest"
      ],
      "env": {
        "API_TOKEN": "${HOSTINGER_API_KEY}"
      }
    },
    "tailscale": {
      "command": "npx",
      "args": [
        "tailscale-mcp@latest"
      ],
      "env": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
        "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
      }
    }
  }
}
