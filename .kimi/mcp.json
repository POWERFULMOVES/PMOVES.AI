{
  "mcpServers": {
    "pmoves-cipher": {
      "type": "sse",
      "url": "http://${TS_Z890}:8105/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${CIPHER_API_TOKEN}"
      },
      "description": "Agent memory (Neo4j knowledge graph)"
    },
    "agent-zero": {
      "type": "sse",
      "url": "http://${TS_Z890}:8081/mcp/t-${AGENT_ZERO_MCP_TOKEN}/sse",
      "description": "Agent Zero orchestrator (SSE with MCP token auth)"
    },
    "docker": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "--mount",
        "type=bind,src=/var/run/docker.sock,dst=/var/run/docker.sock",
        "mcp/docker"
      ],
      "env": {
        "MSYS_NO_PATHCONV": "1"
      },
      "description": "Docker container inspection via local Docker socket"
    },
    "pmoves-docker-gateway": {
      "type": "sse",
      "url": "http://localhost:8090/sse",
      "headers": {
        "Authorization": "Bearer ${MCP_GATEWAY_AUTH_TOKEN}"
      },
      "description": "Docker MCP Toolkit gateway (stdio) for Claude/Kimi/OpenCode/Crush",
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run",
        "--profile",
        "pmoves_5090_web"
      ]
    },
    "pmoves-nats-fleet": {
      "command": "uv",
      "args": [
        "--directory",
        "./pmoves-nats-mcp",
        "run",
        "python",
        "-m",
        "nats_mcp.server"
      ],
      "env": {
        "NATS_URL": "${NATS_URL}"
      },
      "description": "NATS fleet messaging bridge"
    },
    "pmoves-e2b": {
      "command": "npx",
      "args": [
        "-y",
        "@e2b/mcp-server"
      ],
      "env": {
        "E2B_API_KEY": "${E2B_API_KEY}"
      },
      "description": "E2B sandbox code execution via PMOVES forked E2B MCP (E2B_API_KEY from secrets funnel)"
    },
    "pmoves-supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-postgrest@0.1.1",
        "--apiUrl",
        "${SUPABASE_REST_URL:-http://localhost:8000/rest/v1}",
        "--apiKey",
        "${SUPABASE_SERVICE_ROLE_KEY:-${SUP\u2026EY}}",
        "--schema",
        "public"
      ],
      "description": "Supabase PostgREST API"
    },
    "huggingface": {
      "command": "npx",
      "args": [
        "-y",
        "@llmindset/hf-mcp-server@0.3.30"
      ],
      "env": {
        "HF_TOKEN": "${HF_TOKEN}"
      },
      "description": "HuggingFace model/paper/space search"
    },
    "archon": {
      "description": "Archon knowledge / task orchestrator (REST-only MCP, no standard transport \u2014 disabled by default)",
      "type": "http",
      "url": "http://${TS_Z890}:8051",
      "disabled": true
    },
    "supabase-db": {
      "description": "Supabase Postgres database",
      "command": "uvx",
      "args": [
        "postgres-mcp@0.3.0",
        "--access-mode=unrestricted"
      ],
      "env": {
        "DATABASE_URI": "${SUPABASE_DB_URI}"
      }
    },
    "tailscale": {
      "description": "Tailscale network administration",
      "command": "npx",
      "args": [
        "-y",
        "tailscale-mcp@2026.4.10-1"
      ],
      "env": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
        "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
      }
    },
    "hostinger": {
      "description": "Hostinger VPS API (requires pmz-hostinger container)",
      "command": "docker",
      "args": [
        "exec",
        "-i",
        "pmz-hostinger",
        "hostinger-api-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
      }
    }
  }
}
