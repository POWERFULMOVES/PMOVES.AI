+    $localPy = Get-PmovesPythonArgv -Root $root
+    $localTool = Join-Path $root 'pmoves\tools\claude_backend.py'
+    if (-not $localPy -or -not (Test-Path -LiteralPath $localTool)) {
+        Write-Warning '[claude-pmoves] backend=local: local backend refused -- no python / claude_backend.py to run the preflight.'
+        exit 1
+    }
+    $localPre = @(if ($localPy.Count -gt 1) { $localPy[1..($localPy.Count - 1)] })   # @(): see Test-PmovesPythonRuns
+    # Same 5.1 stderr-under-'Stop' guard as the backend selector above: the
+    # tool's WARN lines go to stderr and must not become terminating errors.
