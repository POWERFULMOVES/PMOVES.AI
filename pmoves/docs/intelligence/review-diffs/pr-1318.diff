+  v_spark_id UUID;
+  v_rocm_id UUID;
+BEGIN
+  SELECT id INTO v_spark_id FROM pmoves_core.model_providers WHERE name = 'ollama_spark';
+  SELECT id INTO v_rocm_id FROM pmoves_core.model_providers WHERE name = 'llamacpp_rocm';
