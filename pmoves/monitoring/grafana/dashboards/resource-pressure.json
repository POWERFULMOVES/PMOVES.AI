      "fieldConfig": {"defaults": {"unit": "Bps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 20000000}, {"color": "red", "value": 50000000}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 9}
    }
