{
  "version": 1,
  "note": "Canonical inventory of PMOVES MCP servers. Used by pmoves/tools/mcp_config_generator.py to produce client-native config snippets for Claude, Kimi, KiloCode, Hermes, and Crush. Server entries support an optional 'disabled: true' field to mark servers that should be emitted as disabled in generated configs, and an optional 'endpoint_pinned: true' field meaning the entry's 'endpoint' is what the entry IS rather than a default the caller's --endpoint may override (used by local/fleet sibling pairs that must both be emitted).",
  "defaults": {
    "cipher_local_url": "http://localhost:8105/mcp/sse",
    "cipher_fleet_url": "http://${TS_Z890}:8105/mcp/sse",
    "agent_zero_local_url": "http://localhost:8081/mcp/t-${AGENT_ZERO_MCP_TOKEN}/sse",
    "agent_zero_fleet_url": "http://${TS_Z890}:8081/mcp/t-${AGENT_ZERO_MCP_TOKEN}/sse",
    "archon_local_url": "http://localhost:8051",
    "archon_fleet_url": "http://${TS_Z890}:8051",
    "docker_gateway_port": 8090
  },
  "groups": {
    "core_pmoves": {
      "description": "Native PMOVES MCP servers available on every node or via the fleet tailnet.",
      "servers": [
        {
          "key": "pmoves-cipher",
          "description": "Agent memory (Neo4j knowledge graph)",
          "transport": "sse",
          "endpoint": "fleet",
          "endpoint_prefix": "cipher",
          "headers": {
            "Authorization": "Bearer ${CIPHER_API_TOKEN}"
          }
        },
        {
          "key": "pmoves-cipher-local",
          "description": "Local agent memory on this node (cipher is published on loopback, so the fleet URL is unreachable cross-node)",
          "transport": "sse",
          "endpoint": "local",
          "endpoint_pinned": true,
          "endpoint_prefix": "cipher",
          "headers": {
            "Authorization": "Bearer ${CIPHER_API_TOKEN}"
          },
          "clients": [
            "hermes",
            "claude"
          ]
        },
        {
          "key": "agent-zero",
          "description": "Agent Zero orchestrator (SSE with MCP token auth)",
          "transport": "sse",
          "endpoint": "local",
          "endpoint_prefix": "agent_zero"
        },
        {
          "key": "archon",
          "description": "Archon knowledge / task orchestrator (REST-only MCP, no standard transport — disabled by default)",
          "transport": "http",
          "endpoint": "local",
          "endpoint_prefix": "archon",
          "disabled": true
        },
        {
          "key": "pmoves-nats-fleet",
          "description": "NATS fleet messaging bridge",
          "transport": "stdio",
          "command": "uv",
          "args": [
            "--directory",
            "./pmoves-nats-mcp",
            "run",
            "python",
            "-m",
            "nats_mcp.server"
          ],
          "env": {
            "NATS_URL": "${NATS_URL}"
          }
        },
        {
          "key": "pmoves-supabase",
          "description": "Supabase PostgREST API",
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@supabase/mcp-server-postgrest@0.1.1",
            "--apiUrl",
            "${SUPABASE_REST_URL:-http://localhost:8000/rest/v1}",
            "--apiKey",
            "${SUPABASE_SERVICE_ROLE_KEY:-${SUPABASE_SERVICE_KEY}}",
            "--schema",
            "public"
          ]
        },
        {
          "key": "supabase-db",
          "description": "Supabase Postgres database",
          "transport": "stdio",
          "command": "uvx",
          "args": [
            "postgres-mcp@0.3.0",
            "--access-mode=unrestricted"
          ],
          "env": {
            "DATABASE_URI": "${SUPABASE_DB_URI}"
          }
        },
        {
          "key": "huggingface",
          "description": "HuggingFace model/paper/space search",
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "@llmindset/hf-mcp-server@0.3.30"
          ],
          "env": {
            "HF_TOKEN": "${HF_TOKEN}"
          }
        },
        {
          "key": "tailscale",
          "description": "Tailscale network administration",
          "transport": "stdio",
          "command": "npx",
          "args": [
            "-y",
            "tailscale-mcp@2026.4.10-1"
          ],
          "env": {
            "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
            "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
          }
        },
        {
          "key": "hostinger",
          "description": "Hostinger VPS API (requires pmz-hostinger container)",
          "transport": "stdio",
          "command": "docker",
          "args": [
            "exec",
            "-i",
            "pmz-hostinger",
            "hostinger-api-mcp"
          ],
          "env": {
            "HOSTINGER_API_TOKEN": "${HOSTINGER_API_TOKEN}"
          }
        },
        {
          "key": "composio",
          "description": "Composio hosted MCP gateway - SaaS toolkits behind one server; exact per-toolkit server URL + COMPOSIO_API_KEY come from the operator's Composio dashboard via the secrets funnel (never committed)",
          "transport": "sse",
          "endpoint": "external",
          "url": "https://mcp.composio.dev",
          "headers": {
            "X-API-Key": "${COMPOSIO_API_KEY}"
          },
          "disabled": true,
          "_note": "Operator-approved 2026-08-27, registered but NOT served to any client. `clients: []` is the fail-closed switch -- ServerSpec.applies_to() in mcp_config_generator.py returns `client in self.clients`, so an empty list matches nothing. `disabled: true` alone does NOT keep it out: that key is a Cline/Roo convention absent from Claude Code's .mcp.json schema, so the renderer passes it straight through -- verified, with COMPOSIO_API_KEY set the unscoped entry WAS emitted into the Claude config. Populate `clients` only after the toolkit URL, transport and header name are verified against the Composio dashboard AND COMPOSIO_API_KEY is registered in the canonical CHIT secrets manifest plus the client launcher allowlists.",
          "clients": []
        }
      ]
    },
    "docker_toolkit": {
      "description": "Docker MCP Toolkit gateway exposing the canonical PMOVES profile.",
      "profile": "pmoves_5090_web",
      "servers": [
        {
          "key": "pmoves-docker-gateway",
          "description": "Docker MCP Toolkit gateway (stdio) for Claude/Kimi/OpenCode/Crush",
          "transport": "stdio",
          "command": "docker",
          "args": [
            "mcp",
            "gateway",
            "run",
            "--profile",
            "pmoves_5090_web"
          ],
          "clients": [
            "claude",
            "kimi",
            "opencode",
            "crush"
          ]
        },
        {
          "key": "pmoves-docker-gateway-sse",
          "description": "Docker MCP Toolkit gateway (SSE) for Hermes/KiloCode remote clients",
          "transport": "sse",
          "endpoint": "local",
          "url": "http://localhost:8090/sse",
          "headers": {
            "Authorization": "Bearer ${MCP_GATEWAY_AUTH_TOKEN}"
          },
          "clients": [
            "hermes",
            "kilocode"
          ]
        }
      ]
    }
  }
}
