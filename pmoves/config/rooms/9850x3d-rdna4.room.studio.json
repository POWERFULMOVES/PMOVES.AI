        {
          "target": "notebook-page",
          "delivery": "append",
          "path": "pages/rdna4-audits",
          "artifact_type": "text"
        }
      ],
      "guardrails": {
        "require_approval": false,
        "max_runtime_sec": 300,
        "fail_open": true,
        "one_active_run": true
      },
      "enabled": true,
      "tags": ["gpu", "rocm", "rdna4", "audit"]
    }
  ],
  "hardware_requirements": {
