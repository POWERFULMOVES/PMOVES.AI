{
  "room_id": "hermes-agent.room.control",
  "version": "1.0.0",
  "display_name": "HERMES Agent Control Room",
  "description": "Cross-platform gateway control room for Hermes Agent (NousResearch) integration. Manages profiles, skills, cron jobs, gateway instances, and NATS bridge telemetry. Stage: rehearsal.",
  "agent_id": "hermes-agent",
  "alter": "hermes-agent",
  "room_type": "gateway",
  "owner_mode": "alter",
  "shell": {
    "theme": {
      "theme_id": "hermes-stage",
      "accent_color": "#047857",
      "skin": "gradient-pulse",
      "icon": "sparkles"
    },
    "layout": {
      "default_route": "/dashboard/hermes",
      "panels": [
        {
          "panel_id": "hermes-gateway-main",
          "kind": "webview",
          "position": "left",
          "size": 45,
          "pinned": true
        },
        {
          "panel_id": "hermes-terminal-panel",
          "kind": "terminal",
          "position": "right",
          "size": 35,
          "pinned": true
        },
        {
          "panel_id": "hermes-telemetry",
          "kind": "chat",
          "position": "bottom",
          "size": 20,
          "pinned": false
        }
      ]
    }
  },
  "apps": [
    {
      "app_id": "hermes-gateway-webui",
      "kind": "webview",
      "route": "/hermes/gateway",
      "provider": "hermes-agent-local",
      "action_namespace": "hermes_agent",
      "capabilities": [
        "gateway",
        "skills",
        "cron",
        "delegation",
        "memory"
      ],
      "config": {
        "port": 7700,
        "profile": "pmoves-hermes",
        "start_script": "hermes gateway run",
        "health_endpoint": "/api/health"
      },
      "pinned": true
    },
    {
      "app_id": "hermes-mcp-bridge",
      "kind": "api",
      "route": "/hermes/mcp",
      "provider": "hermes-mcp",
      "action_namespace": "mcp_bridge",
      "capabilities": [
        "mcp-serve",
        "tool-discovery",
        "nats-relay"
      ],
      "config": {
        "mcp_command": "hermes mcp serve",
        "nats_subject_prefix": "hermes.mcp",
        "profile": "pmoves-hermes"
      },
      "pinned": true
    },
    {
      "app_id": "hermes-skill-curator",
      "kind": "chat",
      "route": "/hermes/skills",
      "provider": "hermes-agent-local",
      "action_namespace": "skill_curation",
      "capabilities": [
        "skills",
        "curator",
        "publish"
      ],
      "config": {
        "skill_namespace": "pmoves",
        "hub_source": "https://github.com/POWERFULMOVES/hermes-skills-pmoves",
        "auto_curate": true
      },
      "pinned": false
    },
    {
      "app_id": "openshell-gateway",
      "kind": "gateway",
      "route": "/hermes/openshell",
      "provider": "hermes-agent-local",
      "action_namespace": "openshell_policy",
      "capabilities": [
        "policy-gate",
        "egress-control",
        "secret-mask",
        "multi-user"
      ],
      "config": {
        "policy_file": "config/openshell-policy.yaml",
        "masking_enabled": true,
        "audit_log": "logs/openshell-audit.log"
      },
      "pinned": false
    }
  ],
  "notebook": {
    "provider": "open-notebook",
    "workspace_ref": "hermes-agent-session",
    "thread_ref": "hermes-log",
    "default_page": "hermes-status",
    "sync": {
      "mode": "session-only",
      "writeback_targets": [
        "entries"
      ],
      "artifact_prefix": "rooms/hermes-agent"
    }
  },
  "persona": {
    "signature_ref": "hermes-agent",
    "voice": "analytical",
    "glyph": "\u2727",
    "resonance": [
      "gateway-control",
      "skill-curation",
      "cross-platform",
      "hermes-bridge",
      "nats-relay"
    ]
  },
  "skill_bindings": [
    {
      "binding_id": "hermes-gateway-launch",
      "skill_id": "hermes-agent-integration",
      "room_id": "hermes-agent.room.control",
      "display_name": "Launch HERMES Gateway",
      "intent": [
        "hermes",
        "gateway",
        "launch",
        "bridge"
      ],
      "activation": {
        "invocation_mode": "explicit",
        "trigger_phrases": [
          "launch hermes",
          "start hermes gateway",
          "bridge hermes"
        ],
        "requires_selection": false
      },
      "surface": {
        "app_id": "hermes-gateway-webui",
        "target": "toolbar",
        "route": "/hermes/gateway"
      },
      "execution": {
        "mode": "workflow",
        "run_as": "agent",
        "stream": "status",
        "max_steps": 8
      },
      "context": {
        "sources": [
          "room-state",
          "persona",
          "nats-events"
        ],
        "include_last_turns": 3,
        "notebook_writeback": true,
        "artifact_types": [
          "text",
          "json"
        ]
      },
      "outputs": [
        {
          "target": "chat-response",
          "delivery": "notify",
          "artifact_type": "text"
        },
        {
          "target": "nats-publish",
          "delivery": "event",
          "artifact_type": "json",
          "subject": "hermes.gateway.launched.v1"
        }
      ],
      "guardrails": {
        "require_approval": false,
        "max_runtime_sec": 180,
        "fail_open": true,
        "one_active_run": true
      },
      "enabled": true,
      "tags": [
        "hermes",
        "gateway",
        "launch"
      ]
    }
  ],
  "p7": {
    "launch_subject": "p7.nats.launch",
    "session_subject": "p7.nats.session",
    "stage": "rehearsal",
    "suits": [
      "hermes-gateway",
      "mcp-bridge",
      "skill-curator"
    ]
  },
  "team_refs": [
    "orchestration",
    "gateway",
    "hermes"
  ],
  "service_refs": [
    "hermes-agent",
    "nats",
    "mcp",
    "cipher-memory"
  ],
  "launcher_refs": [
    "hermes-agent"
  ],
  "policies": {
    "model_routing": "local",
    "publish": {
      "allow_nats_emit": true,
      "allow_external_publish": false,
      "allowed_subjects": [
        "p7.nats.launch",
        "p7.nats.session",
        "hermes.gateway.launched.v1",
        "hermes.mcp.toolcall.v1",
        "hermes.skill.curated.v1",
        "room.session.updated.v1"
      ]
    },
    "memory": {
      "graphiti": false,
      "notebook_writeback": true,
      "chit_handoff": true
    }
  },
  "telemetry": {
    "graphiti_phase": "HERMES Agent Control Room",
    "room_events_subject": "room.session.updated.v1",
    "healthcheck_route": "/api/health"
  },
  "provenance": {
    "source": "pmoves/config/rooms/catalog.json",
    "updated_at": "2026-06-04T00:00:00Z",
    "related_docs": [
      "pmoves/docs/ROOM_MANIFEST_CONTRACT.md",
      "pmoves/docs/AGENTS/HERMES_AGENT_INTEGRATION.md",
      ".claude/skills/hermes-agent-integration/SKILL.md",
      ".claude/agents/hermes-agent.md"
    ]
  },
  "sandbox_policy": {
    "enabled": true,
    "description": "OpenShell-inspired policy-based egress controls for agent sandboxes",
    "egress_rules": [
      {
        "service": "telegram",
        "allowed": true,
        "scope": "bot_api_only"
      },
      {
        "service": "discord",
        "allowed": true,
        "scope": "bot_api_only"
      },
      {
        "service": "slack",
        "allowed": true,
        "scope": "webhook_api_only"
      },
      {
        "service": "github",
        "allowed": true,
        "scope": "api_only"
      },
      {
        "service": "nats",
        "allowed": true,
        "scope": "internal_mesh_only"
      },
      {
        "service": "openrouter",
        "allowed": true,
        "scope": "inference_only"
      },
      {
        "service": "ollama",
        "allowed": true,
        "scope": "localhost_only"
      },
      {
        "service": "web",
        "allowed": true,
        "scope": "search_and_extract"
      }
    ],
    "forbidden_patterns": [
      "*.internal.pmoves.ai",
      "127.0.0.1:*",
      "localhost:*"
    ],
    "masking": {
      "enabled": true,
      "description": "Environment variable masking -- secrets hidden inside sandbox, substituted at egress",
      "variables": [
        "GITHUB_TOKEN",
        "NATS_AUTH_TOKEN",
        "OPENROUTER_API_KEY",
        "ELEVENLABS_API_KEY",
        "DISCORD_BOT_TOKEN",
        "TELEGRAM_BOT_TOKEN"
      ]
    }
  },
  "multi_user": {
    "enabled": true,
    "description": "Alice/Bob-style per-user sandbox instances inspired by NousResearch OpenShell demo",
    "onboard_script": "scripts/hermes-onboard-user.sh",
    "max_users_per_node": 10,
    "user_isolation": {
      "skills": "per_user",
      "memory": "per_user",
      "sandbox": "per_user",
      "env_vars": "per_user"
    }
  }
}