{
  "room_id": "ageless-beauty.room.practice",
  "version": "0.1.0",
  "stage": "draft",
  "display_name": "Ageless Beauty — Practice",
  "description": "Nurse practitioner's own practice floor: interactive nutrition database, conformant care-team agents, exercise 'good beat' tuning, and ministry-resonant reflection surfaces. Decision support only — the NP reviews every patient-facing output.",
  "agent_id": "hermes-agent",
  "alter": "ageless-beauty-navigator",
  "room_type": "hybrid",
  "owner_mode": "alter",
  "access": {
    "visibility": "unlisted"
  },
  "shell": {
    "theme": {
      "theme_id": "ageless-beauty",
      "accent_color": "#4ac6ff",
      "skin": "steel-blue-energy-gold",
      "icon": "sparkle"
    },
    "layout": {
      "default_route": "/practice/nutrition",
      "panels": [
        {
          "panel_id": "nutrition-database",
          "kind": "custom",
          "position": "left",
          "size": 50,
          "pinned": true
        },
        {
          "panel_id": "care-team-console",
          "kind": "custom",
          "position": "right",
          "size": 30,
          "pinned": true
        },
        {
          "panel_id": "devotion-reflection",
          "kind": "custom",
          "position": "bottom",
          "size": 20,
          "pinned": false
        }
      ]
    }
  },
  "apps": [
    {
      "app_id": "nutritional-db",
      "kind": "browser",
      "route": "/practice/nutrition",
      "provider": "nutritional-db",
      "action_namespace": "nutrition",
      "capabilities": ["search", "food-detail", "meal-analyze", "interaction-check"],
      "pinned": true,
      "status": "planned"
    },
    {
      "app_id": "good-beat-tracker",
      "kind": "browser",
      "route": "/practice/beat",
      "provider": "nutritional-db",
      "action_namespace": "beat",
      "capabilities": ["zone-lookup", "weekly-trend", "goal-tune"],
      "pinned": false,
      "status": "planned"
    },
    {
      "app_id": "reflection-journal",
      "kind": "browser",
      "route": "/practice/reflection",
      "provider": "open-notebook",
      "action_namespace": "reflection",
      "capabilities": ["prompt-of-the-day", "journal-entry", "theme-browse"],
      "pinned": false,
      "status": "planned"
    }
  ],
  "notebook": {
    "provider": "open-notebook",
    "workspace_ref": "ageless-beauty",
    "thread_ref": "practice-log",
    "default_page": "today",
    "sync": {
      "mode": "mirrored",
      "writeback_targets": ["entries"],
      "artifact_prefix": "rooms/ageless-beauty"
    }
  },
  "persona": {
    "signature_ref": "hermes-agent",
    "voice": "measured",
    "glyph": "✦",
    "resonance": ["nutrition", "movement", "stewardship-of-body", "rest", "gratitude"]
  },
  "skill_bindings": [
    {
      "binding_id": "nutrition-lookup",
      "skill_id": "pmoves/nutrition-lookup",
      "room_id": "ageless-beauty.room.practice",
      "display_name": "Look Up a Food",
      "intent": ["nutrition", "food", "macros", "ingredients"],
      "surface": {"app_id": "nutritional-db", "target": "toolbar", "route": "/practice/nutrition"},
      "execution": {"mode": "workflow", "run_as": "agent", "stream": "status", "max_steps": 4},
      "context": {"sources": ["user-intent", "room-state"], "include_last_turns": 2, "artifact_types": ["json"]},
      "outputs": [{"target": "chat-response", "delivery": "notify", "artifact_type": "text"}],
      "guardrails": {"require_approval": false, "max_runtime_sec": 60, "fail_open": false, "one_active_run": true},
      "enabled": true,
      "tags": ["nutrition", "database"]
    },
    {
      "binding_id": "meal-plan-draft",
      "skill_id": "pmoves/meal-plan-draft",
      "room_id": "ageless-beauty.room.practice",
      "display_name": "Draft a Meal Plan (NP reviews)",
      "intent": ["meal plan", "weekly menu", "nutrition goal"],
      "surface": {"app_id": "nutritional-db", "target": "toolbar", "route": "/practice/nutrition"},
      "execution": {"mode": "workflow", "run_as": "agent", "stream": "status", "max_steps": 6},
      "context": {"sources": ["user-intent", "room-state", "notebook-selection"], "include_last_turns": 3, "notebook_writeback": true, "artifact_types": ["json", "text"]},
      "outputs": [{"target": "chat-response", "delivery": "notify", "artifact_type": "text"}, {"target": "notebook", "delivery": "writeback", "artifact_type": "json"}],
      "guardrails": {"require_approval": true, "max_runtime_sec": 300, "fail_open": false, "one_active_run": true},
      "enabled": true,
      "tags": ["nutrition", "draft", "np-review"]
    },
    {
      "binding_id": "devotion-prompt",
      "skill_id": "pmoves/devotion-prompt",
      "room_id": "ageless-beauty.room.practice",
      "display_name": "Reflection Prompt",
      "intent": ["devotion", "reflection", "meditation", "scripture"],
      "surface": {"app_id": "reflection-journal", "target": "toolbar", "route": "/practice/reflection"},
      "execution": {"mode": "workflow", "run_as": "agent", "stream": "status", "max_steps": 2},
      "context": {"sources": ["curated-corpus"], "include_last_turns": 0, "notebook_writeback": false, "artifact_types": ["text"]},
      "outputs": [{"target": "chat-response", "delivery": "notify", "artifact_type": "text"}],
      "guardrails": {"require_approval": false, "max_runtime_sec": 30, "fail_open": false, "one_active_run": true, "curated_only": true},
      "enabled": true,
      "tags": ["reflection", "ministry", "curated"]
    },
    {
      "binding_id": "care-summary-for-np",
      "skill_id": "pmoves/care-summary-for-np",
      "room_id": "ageless-beauty.room.practice",
      "display_name": "Summarize for Practitioner Review",
      "intent": ["summary", "care review", "patient beat"],
      "surface": {"app_id": "care-team-console", "target": "toolbar", "route": "/practice/console"},
      "execution": {"mode": "workflow", "run_as": "agent", "stream": "status", "max_steps": 5},
      "context": {"sources": ["notebook-thread", "room-state"], "include_last_turns": 5, "notebook_writeback": false, "artifact_types": ["json", "text"]},
      "outputs": [{"target": "chat-response", "delivery": "notify", "artifact_type": "text"}, {"target": "nats-event", "delivery": "emit", "subject": "care.review.ready.v1", "artifact_type": "json"}],
      "guardrails": {"require_approval": true, "max_runtime_sec": 120, "fail_open": false, "one_active_run": true},
      "enabled": true,
      "tags": ["care-team", "np-review"]
    }
  ],
  "team_refs": ["wellness"],
  "service_refs": ["nutritional-db", "open-notebook", "nats", "cipher"],
  "launcher_refs": [],
  "policies": {
    "model_routing": "hybrid",
    "publish": {
      "allow_nats_emit": true,
      "allow_external_publish": false,
      "allowed_subjects": ["care.review.ready.v1", "room.session.updated.v1"]
    },
    "memory": {
      "graphiti": false,
      "notebook_writeback": true,
      "chit_handoff": true,
      "phi_stays_local": true
    }
  },
  "telemetry": {
    "graphiti_phase": "Ageless Beauty Practice",
    "room_events_subject": "room.session.updated.v1",
    "healthcheck_route": "/healthz"
  },
  "provenance": {
    "source": "pmoves/docs/operations/AGELESS_BEAUTY_WORKORDER.md",
    "updated_at": "2026-09-10T08:09:00Z",
    "related_docs": [
      "pmoves/docs/ROOM_MANIFEST_CONTRACT.md",
      "pmoves/docs/operations/AGELESS_BEAUTY_WORKORDER.md"
    ]
  }
}
