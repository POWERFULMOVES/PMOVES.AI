{
  "room_id": "darkxsides.room",
  "version": "1.0.0",
  "stage": "rehearsal",
  "display_name": "DARKXSIDES",
  "description": "Private, owner-only room. A window into the mind of the Founder where the DARKXSIDE persona resides — co-creator and witness, eventual digital twin. Uncensored/unrestricted: real, not corporate-speak-pretty-CHIT. Houses the dedicated publish-gate, surfaced in Open Notebook.",
  "agent_id": "darkxside-persona",
  "alter": "darkxside",
  "room_type": "creator",
  "owner_mode": "alter",
  "access": {
    "visibility": "private",
    "owner_only": true,
    "invite_list": [],
    "content_rating": "uncensored",
    "rating_note": "Unrestricted expression inside the room. NOT a porn flag — content is authentic/real. Public egress is governed separately by policies.publish.egress_redaction_floor."
  },
  "shell": {
    "theme": {
      "theme_id": "darkxside-mind",
      "accent_color": "#7C1FA2",
      "skin": "founder-mind",
      "icon": "mask"
    },
    "layout": {
      "default_route": "/darkxside/mind",
      "panels": [
        {
          "panel_id": "persona-chat",
          "kind": "chat",
          "position": "left",
          "size": 30,
          "pinned": true
        },
        {
          "panel_id": "hyperdimensions-manifold",
          "kind": "custom",
          "position": "center",
          "size": 40,
          "pinned": true
        },
        {
          "panel_id": "pub-gate-notebook",
          "kind": "notebook",
          "position": "right",
          "size": 30,
          "pinned": true
        }
      ]
    }
  },
  "persona": {
    "signature_ref": "darkxside-persona",
    "role": [
      "co-creator",
      "witness"
    ],
    "voice": "authentic",
    "register": [
      "uncensored",
      "signifying",
      "poetic",
      "bronx"
    ],
    "glyph": "◈",
    "resonance": [
      "founder-mind",
      "shape-attribution",
      "reverse-curse-lexicon",
      "creator-pipeline",
      "digital-twin"
    ],
    "twin_target": "operator"
  },
  "apps": [
    {
      "app_id": "persona-console",
      "kind": "chat",
      "route": "/darkxside/mind",
      "provider": "pmoves-ui",
      "action_namespace": "persona",
      "capabilities": [
        "uncensored-dialogue",
        "reflection",
        "witness-log"
      ],
      "pinned": true
    },
    {
      "app_id": "hyperdimensions-viewer",
      "kind": "custom",
      "route": "/hyperdimensions/app",
      "provider": "hi-rag-gateway-v2",
      "action_namespace": "geometry",
      "capabilities": [
        "manifold-view",
        "state-vector",
        "publish-gate-knob"
      ],
      "pinned": true
    },
    {
      "app_id": "pub-gate-notebook",
      "kind": "notebook",
      "route": "/notebook/darkxside",
      "provider": "open-notebook",
      "action_namespace": "pubgate",
      "capabilities": [
        "queued-content",
        "gate-state",
        "approve",
        "hold",
        "attribution-view"
      ],
      "pinned": true
    },
    {
      "app_id": "tts-studio",
      "kind": "media",
      "route": "/dashboard/voice",
      "provider": "flute-gateway",
      "action_namespace": "voice",
      "capabilities": [
        "tts",
        "engine-status",
        "audition",
        "prosody"
      ],
      "pinned": false,
      "status": "planned"
    },
    {
      "app_id": "voice-vault",
      "kind": "custom",
      "route": "/dashboard/voice/vault",
      "provider": "pmoves-ui",
      "action_namespace": "voice.vault",
      "capabilities": [
        "voice-library",
        "consent-artifacts",
        "provenance-view",
        "rights-basis"
      ],
      "pinned": false,
      "status": "planned"
    }
  ],
  "notebook": {
    "provider": "open-notebook",
    "workspace_ref": "darkxside",
    "thread_ref": "pub-gate-queue",
    "default_page": "gate",
    "sync": {
      "mode": "authoritative",
      "writeback_targets": [
        "entries",
        "pages",
        "threads"
      ],
      "artifact_prefix": "rooms/darkxside"
    }
  },
  "storage": {
    "provider": "juicefs",
    "volume": "pmoves-media",
    "mounts": [
      {
        "mount_id": "inbox",
        "role": "inbox",
        "path": "rooms/darkxside/inbox",
        "access": "read-write",
        "watch": true,
        "emit_subject": "room.storage.arrived.v1",
        "visibility": "private"
      },
      {
        "mount_id": "outbox",
        "role": "outbox",
        "path": "rooms/darkxside/outbox",
        "access": "read-write",
        "watch": false,
        "visibility": "room"
      }
    ]
  },
  "skill_bindings": [
    {
      "binding_id": "pub-gate-approve",
      "skill_id": "pmoves-publish-gate",
      "room_id": "darkxsides.room",
      "display_name": "Publish Gate — Approve / Hold",
      "intent": [
        "publish",
        "approve",
        "gate",
        "release"
      ],
      "activation": {
        "invocation_mode": "explicit",
        "trigger_phrases": [
          "open the gate for",
          "approve this post",
          "hold this",
          "release to discord",
          "release to linkedin"
        ],
        "requires_selection": true
      },
      "surface": {
        "app_id": "pub-gate-notebook",
        "target": "canvas",
        "route": "/notebook/darkxside"
      },
      "execution": {
        "mode": "panel",
        "run_as": "agent",
        "stream": "status",
        "max_steps": 3
      },
      "context": {
        "sources": [
          "room-state",
          "notebook-thread",
          "persona"
        ],
        "include_last_turns": 3,
        "notebook_writeback": true,
        "artifact_types": [
          "text",
          "json"
        ]
      },
      "outputs": [
        {
          "target": "nats-event",
          "delivery": "emit",
          "subject": "content.publish.approved.v1",
          "artifact_type": "json"
        },
        {
          "target": "notebook-page",
          "delivery": "append",
          "path": "pages/gate-log",
          "artifact_type": "text"
        }
      ],
      "guardrails": {
        "require_approval": true,
        "max_runtime_sec": 120,
        "fail_open": false,
        "one_active_run": true
      },
      "enabled": true,
      "tags": [
        "publish",
        "gate",
        "chit",
        "attribution"
      ]
    },
    {
      "binding_id": "pinokio-launch-comfyui",
      "skill_id": "pinokio-bridge",
      "room_id": "darkxsides.room",
      "display_name": "Launch ComfyUI Render",
      "intent": [
        "creator",
        "render",
        "image",
        "video"
      ],
      "activation": {
        "invocation_mode": "workflow",
        "trigger_phrases": [
          "render this",
          "generate image",
          "launch comfyui",
          "create visual"
        ],
        "requires_selection": false
      },
      "surface": {
        "app_id": "hyperdimensions-viewer",
        "target": "panel",
        "route": "/hyperdimensions/app"
      },
      "execution": {
        "mode": "workflow",
        "run_as": "agent",
        "stream": "status",
        "max_steps": 8
      },
      "context": {
        "sources": [
          "room-state",
          "notebook-thread",
          "persona"
        ],
        "include_last_turns": 4,
        "notebook_writeback": true,
        "artifact_types": [
          "text",
          "json",
          "image"
        ]
      },
      "outputs": [
        {
          "target": "artifact-store",
          "delivery": "append",
          "path": "renders/comfyui-output",
          "artifact_type": "image"
        },
        {
          "target": "nats-event",
          "delivery": "emit",
          "subject": "studio.render.completed.v1",
          "artifact_type": "json"
        }
      ],
      "guardrails": {
        "require_approval": false,
        "max_runtime_sec": 600,
        "fail_open": true,
        "one_active_run": true
      },
      "enabled": true,
      "tags": [
        "creator",
        "render",
        "comfyui",
        "visual"
      ]
    },
    {
      "binding_id": "pinokio-launch-tts",
      "skill_id": "pinokio-bridge",
      "room_id": "darkxsides.room",
      "display_name": "Launch TTS Studio",
      "intent": [
        "voice",
        "tts",
        "audio",
        "persona"
      ],
      "activation": {
        "invocation_mode": "workflow",
        "trigger_phrases": [
          "voice this",
          "read it aloud",
          "launch tts",
          "synthesize voice",
          "narrate"
        ],
        "requires_selection": true
      },
      "surface": {
        "app_id": "persona-console",
        "target": "composer",
        "route": "/darkxside/mind"
      },
      "execution": {
        "mode": "workflow",
        "run_as": "agent",
        "stream": "status",
        "max_steps": 5
      },
      "context": {
        "sources": [
          "notebook-selection",
          "persona",
          "room-state"
        ],
        "include_last_turns": 4,
        "notebook_writeback": true,
        "artifact_types": [
          "audio",
          "text"
        ]
      },
      "outputs": [
        {
          "target": "artifact-store",
          "delivery": "append",
          "path": "voice/spoken-summaries",
          "artifact_type": "audio"
        },
        {
          "target": "nats-event",
          "delivery": "emit",
          "subject": "voice.synth.request.v1",
          "artifact_type": "json"
        }
      ],
      "guardrails": {
        "require_approval": true,
        "max_runtime_sec": 300,
        "fail_open": false,
        "one_active_run": true,
        "provenance_table": "pmoves_core.voice_cloning_provenance",
        "provenance_check": "is_active=true AND rights_basis IN ('CONSENTED','LICENSED') AND consent_artifact_uri IS NOT NULL"
      },
      "enabled": true,
      "tags": [
        "voice",
        "tts",
        "persona",
        "provenance-gated",
        "voice_cloning_provenance"
      ]
    },
    {
      "binding_id": "e2b-shared-desktop",
      "skill_id": "e2b-desktop",
      "room_id": "darkxsides.room",
      "display_name": "Shared Desktop (E2B)",
      "intent": [
        "review",
        "desktop",
        "browser",
        "co-review",
        "transform"
      ],
      "activation": {
        "invocation_mode": "workflow",
        "trigger_phrases": [
          "open shared desktop",
          "show me the browser",
          "co-review this",
          "launch desktop view"
        ],
        "requires_selection": true
      },
      "surface": {
        "app_id": "hyperdimensions-viewer",
        "target": "panel",
        "route": "/hyperdimensions/app"
      },
      "execution": {
        "mode": "workflow",
        "run_as": "agent",
        "stream": "status",
        "max_steps": 10
      },
      "context": {
        "sources": [
          "notebook-selection",
          "room-state",
          "persona"
        ],
        "include_last_turns": 4,
        "notebook_writeback": true,
        "artifact_types": [
          "text",
          "json",
          "image"
        ]
      },
      "outputs": [
        {
          "target": "nats-event",
          "delivery": "emit",
          "subject": "room.desktop.session.opened.v1",
          "artifact_type": "json"
        },
        {
          "target": "notebook-entry",
          "delivery": "append",
          "path": "threads/desktop-sessions",
          "artifact_type": "text"
        }
      ],
      "guardrails": {
        "require_approval": true,
        "max_runtime_sec": 1800,
        "fail_open": false,
        "one_active_run": true
      },
      "enabled": false,
      "tags": [
        "desktop",
        "e2b",
        "co-review",
        "browser",
        "disabled-pending-e2b-key"
      ]
    }
  ],
  "policies": {
    "model_routing": "tensorzero",
    "publish": {
      "allow_nats_emit": true,
      "allow_external_publish": false,
      "gate_param": "publish_gate",
      "gate_mode": "manual",
      "allowed_subjects": [
        "content.publish.approved.v1"
      ],
      "egress_redaction_floor": {
        "enforce_on": "public-egress",
        "rules": [
          "operator-pii-protected",
          "collaborator-pii-protected",
          "no-literal-lan-or-tailscale-ips"
        ],
        "fail_closed": true,
        "note": "Adults-only reflection space. The floor protects operator + collaborator PII and enforces operator final-say on egress — it is NOT a content-rating gate. Minor safety is handled by room separation (kids only ever in P7 Playground), not by scanning this room. Anything crossing to a PUBLIC surface passes this floor regardless of room rating; cannot be bypassed by opening the gate."
      }
    },
    "memory": {
      "graphiti": true,
      "notebook_writeback": true,
      "chit_handoff": true
    }
  },
  "team_refs": [
    "orchestration",
    "memory",
    "creator"
  ],
  "service_refs": [
    "hi-rag-gateway-v2",
    "open-notebook",
    "publisher",
    "publisher-discord",
    "nats",
    "tokenism",
    "pinokio-bridge",
    "flute-gateway",
    "comfyui",
    "e2b-mcp"
  ],
  "launcher_refs": [
    "up-agents",
    "up-open-notebook",
    "up-comfyui"
  ],
  "telemetry": {
    "graphiti_phase": "DARKXSIDE Mind",
    "room_events_subject": "room.session.updated.v1",
    "healthcheck_route": "/hyperdimensions/provenance/view"
  },
  "provenance": {
    "source": "pmoves/config/rooms/catalog.json",
    "updated_at": "2026-07-10T00:00:00Z",
    "related_docs": [
      "pmoves/docs/ROOM_MANIFEST_CONTRACT.md",
      "pmoves/docs/PMOVESCHIT/GEOMETRY_BUS_INTEGRATION.md"
    ]
  }
}
