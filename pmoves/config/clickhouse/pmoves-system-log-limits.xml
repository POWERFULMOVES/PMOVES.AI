<?xml version="1.0"?>
<!--
  PMOVES ClickHouse system-log limits (2026-08-02).
  Root cause of the C:/D: disk-fill incident: ClickHouse ran with default config
  (Debug logging + NO system-log TTL). The self-telemetry tables (text_log,
  metric_log, asynchronous_metric_log, trace_log) grew unbounded (text_log hit
  173M rows, asynchronous_metric_log 618M), and their constant background-merge
  churn wrote ~2.4 GB/min — ballooning the dynamic Docker vhdx until the host
  drive filled. This drop-in caps it:
    - logger level -> warning  (kills the ~148M Debug-row flood at the source)
    - short TTLs on every system.*_log table (self-prune, bounded footprint)
  TensorZero's own tables are unaffected. Fleet-wide: mount on every node that
  runs TensorZero + ClickHouse.
-->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>
    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </text_log>
    <metric_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </metric_log>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <trace_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </trace_log>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
</clickhouse>
