<?xml version="1.0"?>
<!--
  PMOVES ClickHouse system-log limits (2026-08-02).
  Root cause of the C:/D: disk-fill incident: ClickHouse ran with default config
  (Debug logging + NO system-log TTL). The self-telemetry tables (text_log,
  metric_log, asynchronous_metric_log, trace_log) grew unbounded (text_log hit
  173M rows, asynchronous_metric_log 618M), and their constant background-merge
  churn wrote ~2.4 GB/min — ballooning the dynamic Docker vhdx until the host
  drive filled. This drop-in caps it:
    - logger level -> warning  (kills the ~148M Debug-row flood at the source)
    - short TTLs on every system.*_log table (self-prune, bounded footprint)
  TensorZero's own tables are unaffected. Fleet-wide: mount on every node that
  runs TensorZero + ClickHouse.
-->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>
    <text_log>
        <level>warning</level>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </text_log>
    <!-- metric_log is DISABLED, not TTL'd (2026-10-02). It is 1136 columns wide in
         24.12, and a merge whose parts hold TTL-expired rows is forced to the
         Horizontal algorithm (MergeTask.cpp chooseMergeAlgorithm:
         `if (ctx->need_remove_expired_values) return MergeAlgorithm::Horizontal;`,
         v24.12.6.70-stable). Horizontal reads every column of every part at once;
         on a 4 GiB container each attempt hit MEMORY_LIMIT_EXCEEDED, was retried
         immediately, and the failed retries burned ~138% CPU steady while the TTL
         never landed (August rows still present a month later). About 15% of the
         failures (168/1126) were on the unexpired current-month partition: those
         merges are not TTL-forced, they fail because RSS is already pinned by the
         concurrent Horizontal metric_log merges. Both stop when metric_log goes. Nothing in PMOVES
         reads system.metric_log; Prometheus covers the same counters.
         NOTE: remove="1" stops new writes but does NOT remove the existing table
         (compare the orphaned system.*_log_N tables ClickHouse leaves behind when
         an upgrade changes a system log's schema and renames the old table aside),
         and its merges keep failing until the operator drops system.metric_log
         once, after the restart. The rename suffix INCREMENTS: the first schema
         change yields name_0, the next name_1 while name_0 still exists, and so
         on (SystemLog.cpp prepareTable, v24.12.6.70-stable, lines 548-551, which
         loop ++suffix while table_name + "_" + toString(suffix) already exists).
         The orphan set varies per node and upgrade history, so discover it
         rather than assume a list:
           SELECT name FROM system.tables WHERE database='system' AND match(name, '_log_[0-9]+$')
         and drop what that returns. The _log_ anchor is deliberate: every default
         system log table name ends in _log (SystemLog.h LIST_OF_ALL_SYSTEM_LOGS),
         so this matches only renamed-aside log tables and never a non-log system
         table that happens to end in digits (system.mysql_binlogs, say). It holds
         only while no <table> override renames a log to a name not ending in _log;
         none does today (checked on z890 2026-10-05). Example: z890 on 2026-10-03 measured
         error_log_0, processors_profile_log_0, query_metric_log_0 (no query_log_0). -->
    <metric_log remove="1"/>
    <asynchronous_metric_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </asynchronous_metric_log>
    <trace_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </trace_log>
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <!-- Remaining system.*_log sections that are enabled by default in this image.
         ClickHouse has no wildcard, so each enabled table needs its own TTL or it
         keeps unlimited growth. Only enabled tables are listed — adding a block for
         a disabled table would inadvertently enable it. -->
    <error_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </error_log>
    <query_metric_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </query_metric_log>
    <processors_profile_log>
        <ttl>event_date + INTERVAL 2 DAY DELETE</ttl>
    </processors_profile_log>
</clickhouse>
