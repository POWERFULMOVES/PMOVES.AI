# PMOVES-HERMES-Z890 environment template
#
# Copy these keys into the profile .env file at:
#   C:\Users\DARKXSIDE\AppData\Local\hermes\profiles\pmoves-hermes-z890\.env
#
# Do NOT commit this file or the .env with real values to the repo.

# ── Local model inference ──────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Remote GPU inference (BoTZ / 5090 / Knuckles) ──────────────────────
# Set this to the Ollama endpoint on your GPU node, e.g.:
#   BOTZ_OLLAMA_HOST=http://botz.tailscale.local:11434
#   BOTZ_OLLAMA_HOST=http://192.168.1.100:11434
# Leave unset to route everything through local CPU.
BOTZ_OLLAMA_HOST=

# Cloud fallback (canonical order: ollama_cloud → cloudflare_free → coding_plan)
# Ollama Cloud is OpenAI-compatible. Default fallback model verified in
# pmoves/tensorzero/config/tensorzero.toml: glm-5.2 at https://ollama.com/v1.
OLLAMA_CLOUD_BASE_URL=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=

# Cloudflare AI (free fallback option)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Legacy/disabled-by-default direct providers (only fill if a lane waiver is approved)
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── E2B zero-retention sandbox ─────────────────────────────────────────
E2B_API_KEY=

# ── CourtListener US case law (optional) ───────────────────────────────
COURTLISTENER_API_TOKEN=

# ── Email: Titanmail ───────────────────────────────────────────────────
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
TITAN_EMAIL=
TITAN_PASSWORD=

# ── Email: Gmail ───────────────────────────────────────────────────────
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_EMAIL=
GMAIL_PASSWORD=

# ── n8n / Archon ───────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
N8N_RUNNERS_AUTH_TOKEN=
ARCHON_API_KEY=

# ── Messaging gateway (fill in the platforms you enable) ───────────────
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
WHATSAPP_SESSION=
SIGNAL_USERNAME=
MSTEAMS_APP_ID=
MSTEAMS_APP_PASSWORD=
FACEBOOK_PAGE_TOKEN=
MESSENGER_PAGE_TOKEN=

# ── PMOVES folder / output paths (adjust to your system) ───────────────
PMOVES_WATCH_DIRS=D:\PMOVES.AI\legal-inbox;D:\PMOVES.AI\research-inbox;D:\PMOVES.AI\ops-inbox
PMOVES_WATCH_OUTPUT=D:\PMOVES.AI\folder-monitor-out
PMOVES_EMAIL_OUTPUT=D:\PMOVES.AI\email-archive
PMOVES_LEGAL_NOTEBOOK_WORKSPACE=legal-ops
PMOVES_LEGAL_FOLDER_WATCH=D:\PMOVES.AI\legal-inbox
PMOVES_LEGAL_OUTPUT=D:\PMOVES.AI\legal-out
