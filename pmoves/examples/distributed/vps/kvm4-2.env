# PMOVES-DoX - VPS Deployment (KVM4-2 Data Services)
# Deploy on: Hostinger KVM4-2 (4 vCPU, 8GB RAM)

# Network Mode
DEPLOYMENT_MODE=distributed
DISTRIBUTED_SERVICES=true

# This host (bind to all interfaces)
DOX_HOST=0.0.0.0
DOX_PORT=8484

# NATS (local to this VPS, with auth)
# Bound to 0.0.0.0 for cross-node access — TLS not required because
# Tailscale provides encryption in transit between mesh nodes.
# Access control via UFW + Tailscale ACLs.
NATS_HOST=0.0.0.0
NATS_PORT=4222
NATS_URL=nats://nats:pmoves@localhost:4222

# TensorZero (on KVM4-1 via Tailscale)
TENSORZERO_HOST=pmoves-kvm4-1
TENSORZERO_URL=http://pmoves-kvm4-1:3030

# BoTZ (on KVM4-1 via Tailscale)
BOTZ_HOST=pmoves-kvm4-1
BOTZ_GATEWAY_URL=http://pmoves-kvm4-1:2091

# Tokenism (home network via Tailscale)
TOKENISM_HOST=pmoves-home
TOKENISM_URL=http://pmoves-home:5000

# Ollama (home network via Tailscale - no local GPU)
OLLAMA_HOST=pmoves-home
OLLAMA_BASE_URL=http://pmoves-home:11434
EMBEDDING_OLLAMA_URL=http://pmoves-home:11434

# CPU-only mode (no GPU on VPS)
DEFAULT_DEVICE=cpu
SEARCH_DEVICE=cpu
DOCLING_DEVICE=cpu

# Security
SUPABASE_JWT_SECRET=your-strong-jwt-secret-here
POSTGRES_PASSWORD=your-strong-db-password

# Frontend (public HTTPS)
NEXT_PUBLIC_NATS_WS_URL=wss://dox.pmoves.io:9223

# Neo4j Graph Database (local to KVM4-2)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD}

# Prometheus Metrics (scrape from home network via Tailscale)
PROMETHEUS_PUSHGATEWAY=http://pmoves-home:9091

# Disable local services (run on home network)
# OLLAMA_HOST and TENSORZERO_HOST handle remote connections
