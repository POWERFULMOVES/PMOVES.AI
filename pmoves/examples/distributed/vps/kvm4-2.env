# PMOVES-DoX - VPS Deployment (KVM4-2 Data Services)
# Deploy on: Hostinger KVM4-2 (4 vCPU, 8GB RAM)

# Network Mode
DEPLOYMENT_MODE=distributed
DISTRIBUTED_SERVICES=true

# This host (bind to all interfaces)
DOX_HOST=0.0.0.0
DOX_PORT=8484

# NATS (local to this VPS, with TLS)
NATS_HOST=0.0.0.0
NATS_PORT=4222
NATS_URL=nats://localhost:4222
NATS_TLS_ENABLED=true
NATS_TLS_CA=/app/nats-certs/ca.crt

# TensorZero (home network via WireGuard)
TENSORZERO_HOST=10.0.0.2
TENSORZERO_URL=http://10.0.0.2:3030

# BoTZ (on KVM4-1)
BOTZ_HOST=kvm4-1.internal
BOTZ_GATEWAY_URL=http://kvm4-1.internal:2091

# Tokenism (home network)
TOKENISM_HOST=10.0.0.3
TOKENISM_URL=http://10.0.0.3:5000

# Ollama (home network - no local GPU)
OLLAMA_HOST=10.0.0.2
OLLAMA_BASE_URL=http://10.0.0.2:11434
EMBEDDING_OLLAMA_URL=http://10.0.0.2:11434

# CPU-only mode (no GPU on VPS)
DEFAULT_DEVICE=cpu
SEARCH_DEVICE=cpu
DOCLING_DEVICE=cpu

# Security
SUPABASE_JWT_SECRET=your-strong-jwt-secret-here
POSTGRES_PASSWORD=your-strong-db-password

# Frontend (public HTTPS)
NEXT_PUBLIC_NATS_WS_URL=wss://dox.pmoves.io:9223

# Neo4j Graph Database (local to KVM4-2)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD}

# Prometheus Metrics (scrape from home network Prometheus)
# Note: Ensure firewall allows 9090/tcp from VPS to home
PROMETHEUS_PUSHGATEWAY=http://10.0.0.2:9091

# Disable local services (run on home network)
# OLLAMA_HOST and TENSORZERO_HOST handle remote connections
