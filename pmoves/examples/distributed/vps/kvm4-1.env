# PMOVES-BoTZ - VPS Deployment (KVM4-1 API Gateway)
# Deploy on: Hostinger KVM4-1 (4 vCPU, 8GB RAM)

# Network Mode
DEPLOYMENT_MODE=distributed
DOCKED_MODE=false
STANDALONE_NETWORK=true

# This host
BOTZ_HOST=0.0.0.0
GATEWAY_PORT=2091
MCP_BRIDGE_PORT=8100

# Authentication (required for public VPS)
SUPABASE_JWT_SECRET=your-strong-jwt-secret-here

# TensorZero (local on this VPS or via Tailscale to home)
# Host-level port. Containers use http://tensorzero:3000 via compose network.
# Option A: Run TensorZero on VPS (CPU-only, default)
TENSORZERO_URL=http://localhost:3030
# Option B: Connect to home network TensorZero via Tailscale
# TENSORZERO_HOST=pmoves-home
# TENSORZERO_URL=http://pmoves-home:3030

# DoX (on KVM4-2 via Tailscale)
DOX_HOST=pmoves-kvm4-2
DOX_BACKEND_URL=http://pmoves-kvm4-2:8484

# Tokenism (home network via Tailscale)
TOKENISM_HOST=pmoves-home
TOKENISM_URL=http://pmoves-home:5000

# NATS (on KVM4-2 via Tailscale, with auth)
NATS_HOST=pmoves-kvm4-2
NATS_URL=nats://nats:pmoves@pmoves-kvm4-2:4222

# Hi-RAG (home network via Tailscale or disabled)
HIRAG_HOST=pmoves-home
HIRAG_URL=http://pmoves-home:8086

# Supabase (home network via Tailscale)
SUPABASE_HOST=pmoves-home
SUPABASE_URL=http://pmoves-home:3010

# Disable local Ollama (use home network GPU via Tailscale)
OLLAMA_HOST=pmoves-home
OLLAMA_BASE_URL=http://pmoves-home:11434
VL_PROVIDER=ollama
VL_MODEL=llava

# Hostinger API (for MCP tools)
# Set via CHIT secrets or shell environment — not self-referential in env_file context
# HOSTINGER_API_KEY=<set in env.shared or shell>

# CPU-only mode (no GPU on VPS)
DEFAULT_DEVICE=cpu

# Logging
LOG_LEVEL=INFO
