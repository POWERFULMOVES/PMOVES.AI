# PMOVES-BoTZ - VPS Deployment (KVM4-1 API Gateway)
# Deploy on: Hostinger KVM4-1 (4 vCPU, 8GB RAM)

# Network Mode
DEPLOYMENT_MODE=distributed
DOCKED_MODE=false
STANDALONE_NETWORK=true

# This host
BOTZ_HOST=0.0.0.0
GATEWAY_PORT=2091
MCP_BRIDGE_PORT=8100

# Authentication (required for public VPS)
SUPABASE_JWT_SECRET=your-strong-jwt-secret-here

# TensorZero (on home network via WireGuard)
# Option A: Run TensorZero on VPS (CPU-only)
# TENSORZERO_URL=http://localhost:3030
# Option B: Connect to home network TensorZero
TENSORZERO_HOST=10.0.0.2
TENSORZERO_URL=http://10.0.0.2:3030

# DoX (on KVM4-2)
DOX_HOST=kvm4-2.internal
DOX_BACKEND_URL=http://kvm4-2.internal:8484

# Tokenism (home network)
TOKENISM_HOST=10.0.0.3
TOKENISM_URL=http://10.0.0.3:5000

# NATS (on KVM4-2)
NATS_HOST=kvm4-2.internal
NATS_URL=nats://kvm4-2.internal:4222

# Hi-RAG (home network or disabled)
HIRAG_HOST=10.0.0.2
HIRAG_URL=http://10.0.0.2:8086

# Supabase (home network)
SUPABASE_HOST=10.0.0.2
SUPABASE_URL=http://10.0.0.2:3010

# Disable local Ollama (use home network GPU)
# VL Sentinel will use remote Ollama
OLLAMA_HOST=10.0.0.2
OLLAMA_BASE_URL=http://10.0.0.2:11434
VL_PROVIDER=ollama
VL_MODEL=llava

# CPU-only mode (no GPU on VPS)
DEFAULT_DEVICE=cpu

# Logging
LOG_LEVEL=INFO
