# PMOVES-Tokenism - Home Network (VPS Hybrid)
# Deploy on: Home GPU workstation (RTX 5090)
# Connected to VPS via WireGuard

# Network Mode
DEPLOYMENT_MODE=distributed

# This host (home network IP)
TOKENISM_HOST=192.168.1.10
TOKENISM_PORT=5000

# WireGuard tunnel IP (for VPS access)
WIREGUARD_IP=10.0.0.3

# NATS (on VPS KVM4-2 via WireGuard)
NATS_HOST=kvm4-2.pmoves.io  # Or internal VPS IP
NATS_URL=nats://kvm4-2.pmoves.io:4222

# TensorZero (local - GPU workstation)
TENSORZERO_HOST=localhost
TENSORZERO_URL=http://localhost:3030

# DoX (on VPS KVM4-2)
DOX_HOST=dox.pmoves.io
DOX_BACKEND_URL=https://dox.pmoves.io

# BoTZ (on VPS KVM4-1)
BOTZ_HOST=api.pmoves.io
BOTZ_GATEWAY_URL=https://api.pmoves.io

# Ollama (local GPU)
OLLAMA_HOST=localhost
OLLAMA_BASE_URL=http://localhost:11434

# GPU Settings (RTX 5090)
DEFAULT_DEVICE=cuda
SEARCH_DEVICE=cuda

# Authentication
SUPABASE_JWT_SECRET=your-strong-jwt-secret-here

# Hi-RAG (local)
HIRAG_HOST=localhost
HIRAG_URL=http://localhost:8086

# Supabase (local or VPS)
SUPABASE_HOST=localhost
SUPABASE_URL=http://localhost:3010
