# PMOVES-DoX - Tailscale Mesh Deployment
# Deploy on: 100.64.1.20 (pmoves-dox)

# Network Mode
DEPLOYMENT_MODE=distributed
DISTRIBUTED_SERVICES=true

# Tailscale sidecar
TAILSCALE_ENABLED=true
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxxx
TAILSCALE_HOSTNAME=pmoves-dox
TAILSCALE_ADVERTISE_ROUTES=172.31.0.0/16

# This host (Tailscale IP)
DOX_HOST=100.64.1.20
DOX_PORT=8484

# NATS (on primary - TLS required for cross-network)
NATS_HOST=100.64.1.10
NATS_PORT=4222
NATS_URL=nats://100.64.1.10:4222
NATS_TLS_ENABLED=true
NATS_TLS_CA=/app/nats-certs/ca.crt

# TensorZero (on primary)
TENSORZERO_HOST=100.64.1.10
TENSORZERO_URL=http://100.64.1.10:3030

# BoTZ (remote office)
BOTZ_HOST=100.64.1.30
BOTZ_GATEWAY_URL=http://100.64.1.30:2091

# Tokenism (data center)
TOKENISM_HOST=100.64.1.40
TOKENISM_URL=http://100.64.1.40:5000

# Ollama (local)
OLLAMA_HOST=localhost
OLLAMA_BASE_URL=http://localhost:11434

# GPU Settings
DEFAULT_DEVICE=cuda
SEARCH_DEVICE=cuda
DOCLING_DEVICE=cuda

# Security
SUPABASE_JWT_SECRET=your-shared-jwt-secret
POSTGRES_PASSWORD=your-local-password

# Frontend (use secure WebSocket for TLS)
NEXT_PUBLIC_NATS_WS_URL=wss://100.64.1.20:9223
