# PMOVES-BoTZ - Tailscale Mesh Deployment
# Deploy on: 100.64.1.30 (pmoves-botz, Remote Office)

# Network Mode
DEPLOYMENT_MODE=distributed
DOCKED_MODE=false
STANDALONE_NETWORK=true

# Tailscale sidecar
TAILSCALE_ENABLED=true
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxxx
TAILSCALE_HOSTNAME=pmoves-botz
TAILSCALE_ADVERTISE_ROUTES=172.32.0.0/16

# This host (Tailscale IP)
BOTZ_HOST=100.64.1.30
GATEWAY_PORT=2091
MCP_BRIDGE_PORT=8100

# Authentication (required for cross-network)
SUPABASE_JWT_SECRET=your-shared-jwt-secret

# TensorZero (home office primary)
TENSORZERO_HOST=100.64.1.10
TENSORZERO_URL=http://100.64.1.10:3030

# DoX (home office)
DOX_HOST=100.64.1.20
DOX_BACKEND_URL=http://100.64.1.20:8484

# Tokenism (data center)
TOKENISM_HOST=100.64.1.40
TOKENISM_URL=http://100.64.1.40:5000

# NATS (home office primary)
NATS_HOST=100.64.1.10
NATS_URL=nats://100.64.1.10:4222

# Hi-RAG (home office primary)
HIRAG_HOST=100.64.1.10
HIRAG_URL=http://100.64.1.10:8086

# Supabase (home office primary)
SUPABASE_HOST=100.64.1.10
SUPABASE_URL=http://100.64.1.10:3010

# Ollama (local for VL Sentinel)
OLLAMA_HOST=localhost
OLLAMA_BASE_URL=http://localhost:11434
VL_PROVIDER=ollama
VL_MODEL=llava

# GPU Settings
DEFAULT_DEVICE=cuda
