# PMOVES-Tokenism - Tailscale Mesh Deployment
# Deploy on: 100.64.1.40 (pmoves-tokenism, Data Center)

# Network Mode
DEPLOYMENT_MODE=distributed
DISTRIBUTED_SERVICES=true

# Service Identity
SERVICE_NAME=pmoves-tokenism
SERVICE_SLUG=tokenism
TIER=worker

# Tailscale sidecar
TAILSCALE_ENABLED=true
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxxx
TAILSCALE_HOSTNAME=pmoves-tokenism
TAILSCALE_ADVERTISE_ROUTES=172.33.0.0/16

# This host (Tailscale IP)
TOKENISM_HOST=100.64.1.40
TOKENISM_PORT=5000
TOKENISM_URL=http://100.64.1.40:5000

# NATS (home office primary)
NATS_HOST=100.64.1.10
NATS_PORT=4222
NATS_URL=nats://100.64.1.10:4222
NATS_JETSTREAM=true

# TensorZero (home office primary)
TENSORZERO_HOST=100.64.1.10
TENSORZERO_URL=http://100.64.1.10:3030

# DoX Document Intelligence (home office)
DOX_HOST=100.64.1.20
DOX_PORT=8484
DOX_BACKEND_URL=http://100.64.1.20:8484

# Agent Zero (dual-instance in DoX)
AGENT_ZERO_HOST=100.64.1.20
AGENT_ZERO_HEADLESS_PORT=50051
AGENT_ZERO_URL=http://100.64.1.20:50051
AGENT_ZERO_MCP_URL=http://100.64.1.20:50051/mcp

# BoTZ MCP Gateway (remote office)
BOTZ_HOST=100.64.1.30
BOTZ_GATEWAY_PORT=2091
BOTZ_GATEWAY_URL=http://100.64.1.30:2091

# Archon Knowledge (in BoTZ)
ARCHON_HOST=100.64.1.30
ARCHON_URL=http://100.64.1.30:8091

# PMOVES-Wealth (local to Tokenism in data center)
WEALTH_HOST=100.64.1.40
WEALTH_PORT=8080
FIREFLY_API_URL=http://100.64.1.40:8080/api/v1
FIREFLY_TOKEN=your-firefly-token

# Authentication
SUPABASE_JWT_SECRET=your-shared-jwt-secret
AGENT_ZERO_MCP_TOKEN=your-mcp-token

# CPU-only mode (data center CPU server)
DEFAULT_DEVICE=cpu
