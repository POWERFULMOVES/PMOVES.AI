# PMOVES-BoTZ - Local Network Deployment
# Deploy on: 192.168.1.30 (GPU Server with RTX 5090)

# Network Mode
DEPLOYMENT_MODE=distributed
DOCKED_MODE=false
STANDALONE_NETWORK=true

# This host
BOTZ_HOST=192.168.1.30
GATEWAY_PORT=2091
MCP_BRIDGE_PORT=8100

# Authentication
SUPABASE_JWT_SECRET=your-shared-jwt-secret

# TensorZero (on primary server)
TENSORZERO_HOST=192.168.1.10
TENSORZERO_URL=http://192.168.1.10:3030

# DoX (on workstation)
DOX_HOST=192.168.1.20
DOX_BACKEND_URL=http://192.168.1.20:8484

# Tokenism (on NAS)
TOKENISM_HOST=192.168.1.40
TOKENISM_URL=http://192.168.1.40:5000

# NATS (on primary server)
NATS_HOST=192.168.1.10
NATS_URL=nats://192.168.1.10:4222

# Hi-RAG (on primary server)
HIRAG_HOST=192.168.1.10
HIRAG_URL=http://192.168.1.10:8086

# Supabase (on primary server)
SUPABASE_HOST=192.168.1.10
SUPABASE_URL=http://192.168.1.10:3010

# Ollama (local to this machine for VL Sentinel)
OLLAMA_HOST=localhost
OLLAMA_BASE_URL=http://localhost:11434
VL_PROVIDER=ollama
VL_MODEL=llava

# GPU Settings
DEFAULT_DEVICE=cuda
