# PMOVES-Tokenism - Local Network Deployment
# Deploy on: 192.168.1.40 (NAS/CPU Server)

# Network Mode
DEPLOYMENT_MODE=distributed

# This host
TOKENISM_HOST=192.168.1.40
TOKENISM_PORT=5000

# NATS (on primary server)
NATS_HOST=192.168.1.10
NATS_URL=nats://192.168.1.10:4222

# TensorZero (on primary server)
TENSORZERO_HOST=192.168.1.10
TENSORZERO_URL=http://192.168.1.10:3030

# DoX (on workstation)
DOX_HOST=192.168.1.20
DOX_BACKEND_URL=http://192.168.1.20:8484

# BoTZ (on GPU server)
BOTZ_HOST=192.168.1.30
BOTZ_GATEWAY_URL=http://192.168.1.30:2091

# Authentication
SUPABASE_JWT_SECRET=your-shared-jwt-secret

# CPU-only mode
DEFAULT_DEVICE=cpu
