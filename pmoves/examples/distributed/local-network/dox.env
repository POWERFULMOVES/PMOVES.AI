# PMOVES-DoX - Local Network Deployment
# Deploy on: 192.168.1.20 (Workstation with RTX 4090)

# Network Mode
DEPLOYMENT_MODE=distributed
DISTRIBUTED_SERVICES=true

# This host
DOX_HOST=192.168.1.20
DOX_PORT=8484

# NATS (on primary server)
NATS_HOST=192.168.1.10
NATS_PORT=4222
NATS_URL=nats://192.168.1.10:4222
NATS_TLS_ENABLED=false  # TLS optional on trusted LAN

# TensorZero (on primary server)
TENSORZERO_HOST=192.168.1.10
TENSORZERO_URL=http://192.168.1.10:3030

# BoTZ (on GPU server)
BOTZ_HOST=192.168.1.30
BOTZ_GATEWAY_URL=http://192.168.1.30:2091

# Tokenism (on NAS)
TOKENISM_HOST=192.168.1.40
TOKENISM_URL=http://192.168.1.40:5000

# Ollama (local to this machine)
OLLAMA_HOST=localhost
OLLAMA_BASE_URL=http://localhost:11434

# GPU Settings
DEFAULT_DEVICE=cuda
SEARCH_DEVICE=cuda
DOCLING_DEVICE=cuda

# Supabase (local to this instance)
POSTGRES_PASSWORD=your-local-password
SUPABASE_JWT_SECRET=your-shared-jwt-secret

# Frontend
NEXT_PUBLIC_NATS_WS_URL=ws://192.168.1.20:9223
