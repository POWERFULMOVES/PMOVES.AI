# =============================================================================
# PMOVES Agent Tier Environment Variables
# =============================================================================
# Services: agent-zero, archon, mesh-agent, supaserch, deepresearch,
#           consciousness-service, archon-agent-work-orders, botz-gateway,
#           publisher-discord, messaging-gateway, jellyfin-bridge, chat-relay
# =============================================================================

# Agent tier services handle orchestration and coordination
# They connect to internal services (Hi-RAG, NATS, Supabase)
# NO direct access to external LLM API keys (use TensorZero)

# ---------------------------------------------------------------------------
# Dynamic Port Registry (Agent Tier)
# ---------------------------------------------------------------------------
BOTZ_GATEWAY_PORT=8054
EVO_CONTROLLER_PORT=8113
TOKENISM_PORT=8100
TOKENISM_HOST_PORT=8103
GITHUB_RUNNER_CTL_PORT=8104

# ---------------------------------------------------------------------------
# NATS Message Bus (internal)
# ---------------------------------------------------------------------------
NATS_URL=nats://nats:pmoves@nats:4222

# ---------------------------------------------------------------------------
# Supabase (internal)
# ---------------------------------------------------------------------------
SUPABASE_URL=http://supabase-kong:8000
SUPABASE_SERVICE_ROLE_KEY=  # REQUIRED: From Supabase CLI
SUPA_REST_URL=http://supabase-kong:8000/rest/v1

# ---------------------------------------------------------------------------
# Hi-RAG Gateway (internal)
# ---------------------------------------------------------------------------
HIRAG_URL=http://hi-rag-gateway-v2:8086
HIRAG_V2_URL=http://hi-rag-gateway-v2:8086

# ---------------------------------------------------------------------------
# TensorZero Gateway (internal - model access)
# ---------------------------------------------------------------------------
# Agents call TensorZero for LLM access, NOT external providers directly
TENSORZERO_URL=http://tensorzero-gateway:3000

# ---------------------------------------------------------------------------
# Open Notebook (in-network from containers)
# ---------------------------------------------------------------------------
OPEN_NOTEBOOK_API_URL=http://open-notebook:5055
OPEN_NOTEBOOK_API_TOKEN=  # Optional: API token for Open Notebook

# ---------------------------------------------------------------------------
# Agent Zero Settings
# ---------------------------------------------------------------------------
AGENT_ZERO_API_BASE=http://127.0.0.1:80
AGENTZERO_JETSTREAM=true

# ---------------------------------------------------------------------------
# Archon Settings
# ---------------------------------------------------------------------------
ARCHON_SERVER_PORT=8091
ARCHON_MCP_PORT=8051
ARCHON_SUPABASE_BASE_URL=

# ---------------------------------------------------------------------------
# Archon — Claude / gh live-workflow auth (Issue #2217)
# ---------------------------------------------------------------------------
# The TS server exits(1) at boot if no Claude auth is present. The compose
# file wires the following tokens to the `archon` service env. Set at least
# one of CLAUDE_API_KEY or CLAUDE_CODE_OAUTH_TOKEN; leave the others empty.
#
# CLAUDE_BIN_PATH: path to the Claude CLI binary inside the archon container.
#   Default empty (uses $PATH). The upstream Archon Dockerfile installs Claude
#   at /usr/local/bin/claude; set this only if your image builds Claude at a
#   non-standard path or you want to pin a specific binary.
#
# GH_TOKEN: GitHub PAT for `gh auth` inside the container. Scopes: repo, workflow.
#   Non-fatal warning if absent (workflows that need gh will fail at use-time).
CLAUDE_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_USE_GLOBAL_AUTH=false
CLAUDE_BIN_PATH=
GH_TOKEN=

# ---------------------------------------------------------------------------
# DeepResearch Settings
# ---------------------------------------------------------------------------
DEEPRESEARCH_MODE=tensorzero
DEEPRESEARCH_TIMEOUT=600
DEEPRESEARCH_TENSORZERO_BASE_URL=http://tensorzero-gateway:3000
DEEPRESEARCH_NOTEBOOK_EMBED=true

# ---------------------------------------------------------------------------
# Discord Publisher (optional)
# ---------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=  # Optional: Discord webhook for notifications

# ---------------------------------------------------------------------------
# Agent Zero MCP server token (CANONICAL_NAMES.md §5)
# ---------------------------------------------------------------------------
# Canonical home for the MCP/a2a token. Compose intentionally does NOT set
# A0_SET_mcp_server_token in its env list — pin it here to make it durable,
# or leave unset and Agent Zero auto-generates one at startup.
# A0_SET_mcp_server_token=
