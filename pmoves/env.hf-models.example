# =============================================================================
# PMOVES.AI Local Model Stack Environment Variables
# =============================================================================
# Hugging Face integration and local model configuration
#
# Add this to your pmoves/env.shared or source it separately
# =============================================================================

# =============================================================================
# Hugging Face Configuration
# =============================================================================

# Hugging Face Hub API token (required for gated models)
# Get your token at: https://huggingface.co/settings/tokens
HUGGINGFACE_HUB_TOKEN=

# Hugging Face cache directories
HF_HOME=/mnt/models/hf
HF_HUB_CACHE=/mnt/models/hf/hub

# Enable HF transfer acceleration (recommended)
HF_HUB_ENABLE_HF_TRANSFER=1

# =============================================================================
# vLLM Configuration
# =============================================================================

# Tensor parallelism (multi-GPU)
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_MODEL_LEN=32768

# vLLM Docker image (optional override)
VLLM_DOCKER_IMAGE=vllm/vllm-openai:latest

# =============================================================================
# Model Selection (BoTZ Components)
# =============================================================================

# Orchestrator (Opus planning - complex reasoning)
BOTZ_ORCHESTRATOR_MODEL=qwen2.5-14b
BOTZ_ORCHESTRATOR_MODEL_FALLBACK=qwen2.5-7b

# Builder (Sonnet execution - balanced speed/quality)
BOTZ_BUILDER_MODEL=qwen2.5-7b
BOTZ_BUILDER_MODEL_FALLBACK=qwen2.5-3b

# Auditor (Haiku review - fast, cost-effective)
BOTZ_AUDITOR_MODEL=qwen2.5-3b
BOTZ_AUDITOR_MODEL_FALLBACK=gemma-2-2b

# Coding (specialized code generation)
BOTZ_CODING_MODEL=qwen2.5-coder-7b
BOTZ_CODING_MODEL_FALLBACK=deepseek-coder-6.7b

# VL Sentinel (vision-language processing)
BOTZ_VL_MODEL=qwen2-vl:7b
BOTZ_VL_MODEL_FALLBACK=qwen3-vl-8b

# Cipher Memory (persistent memory with reasoning)
BOTZ_CIPHER_MEMORY_MODEL=qwen2.5-14b
BOTZ_CIPHER_MEMORY_MODEL_FALLBACK=qwen2.5-7b

# =============================================================================
# TensorZero Local Model Integration
# =============================================================================

# Local model provider priority
# Options: ollama, vllm
TENSORZERO_LOCAL_PROVIDER=ollama

# Ollama configuration
OLLAMA_BASE_URL=http://pmoves-ollama:11434
OLLAMA_URL=http://pmoves-ollama:11434

# vLLM base URLs (for model-specific endpoints)
VLLM_QWEN_7B_URL=http://vllm-qwen-7b:8000/v1
VLLM_QWEN_14B_URL=http://vllm-qwen-14b:8000/v1
VLLM_QWEN_32B_URL=http://vllm-qwen-32b:8000/v1
VLLM_CODER_7B_URL=http://vllm-coder-7b:8000/v1
VLLM_VL_8B_URL=http://vllm-vl-8b:8000/v1

# =============================================================================
# Hugging Face MCP Server
# =============================================================================

# HF MCP server endpoint
HF_MCP_SERVER_URL=http://hf-mcp-server:8096
HF_MCP_SERVER_PORT=8096

# HF MCP server health and metrics endpoints
# Health check: GET http://hf-mcp-server:8096/healthz
# Prometheus metrics: GET http://hf-mcp-server:8096/metrics

# =============================================================================
# Model Path Configuration
# =============================================================================

# Base path for all model storage
HF_MODEL_PATH=/mnt/models/hf

# =============================================================================
# Quantization Preferences
# =============================================================================

# Default quantization for model downloads
# Options: q4_0, q4_k_m, q5_0, q8_0, f16
HF_DEFAULT_QUANTIZATION=q4_k_m

# =============================================================================
# Hardware Profile (auto-detected, can be overridden)
# =============================================================================
# Options: cpu_only_edge, consumer_gpu_8gb, midrange_16gb,
#          midrange_24gb, ai_workstation_32gb, ai_workstation_48gb,
#          multi_gpu_2x40gb
HF_HARDWARE_PROFILE=auto
