# PMOVES.AI — ActivePieces self-host env template.
#
# Copy to env.activepieces and fill the SECRET values via the PMOVES secrets
# pipeline (never hand-write secrets — add them to the secrets manifest and let
# secrets-rotate emit them). Non-secret defaults are safe to keep as-is.
#
#   cp env.activepieces.example env.activepieces   # then hydrate the secrets

# ---- Non-secret defaults ----
AP_BIND=127.0.0.1
AP_APP_PORT=8087
AP_FRONTEND_URL=http://localhost:8087
AP_EXECUTION_MODE=UNSANDBOXED
AP_TELEMETRY_ENABLED=false
AP_POSTGRES_DATABASE=activepieces
AP_POSTGRES_USERNAME=activepieces

# ---- Edition / Git Sync ----
# Git Sync (flows-as-code → pmoves/activepieces/flows) is an Enterprise feature.
# For the hosted↔self-host Git Sync connection, set AP_EDITION=ee and supply a
# license key. Leave AP_EDITION=ce to run Community (no Git Sync; use the
# export→commit→import fallback documented in README.md).
AP_EDITION=ce
# AP_LICENSE_KEY=            # SECRET — required only when AP_EDITION=ee

# ---- SECRETS (emit via the PMOVES secrets pipeline; do NOT commit real values) ----
# AP_ENCRYPTION_KEY=         # 32 hex chars (256-bit) — e.g. `openssl rand -hex 16`
# AP_JWT_SECRET=             # random string — e.g. `openssl rand -hex 32`
# AP_POSTGRES_PASSWORD=      # strong password for the local activepieces postgres
