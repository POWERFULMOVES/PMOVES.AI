# ============================================================================
# PMOVES.AI Shared Environment Variables - Provider Key Additions
# ============================================================================
# Generated: 2026-07-09
# Purpose:   Add missing key slots to env.shared for cloud-hybrid tier
# Pipeline:  local.env -> CHIT -> make secrets-funnel
# WARNING:   This file contains ONLY placeholder defaults.
#            NEVER commit actual key values.
#            ALL key values come from local.env or CHIT source.
# Reference: pmoves/docs/operations/CANONICAL_NAMES.md
#            pmoves/config/provider_catalog.yaml (single source of truth)
# ============================================================================

# ============================================================================
# CLOUD-HYBRID TIER: AGNOTE4482 Critical Keys (Priority 1)
# All keys EMPTY on node as of 2026-07-03 (B850-CLAUDE assessment).
# Fill via KEY_RECEIPT_FORM.md -> local.env -> make secrets-funnel
# ============================================================================

# --- Z_AI_API_KEY: Zhipu AI / Z.AI / GLM Coding Plan ---
# Canonical per CANONICAL_NAMES.md §Provider keys (2026-07-02)
# Alias: ZAI_API_KEY (sunset: 2026-10-01)
# Provider: zai | API base: https://api.z.ai/api/coding/paas/v4
# Model suits: glm-4-plus, glm-4.7, glm-5.1, glm-4-air, glm-4-flash, glm-5-turbo
# TensorZero: agent_zero, coding_glm, orchestrator, deepresearch, vl_sentinel
# How to obtain: https://z.ai/manage-apikey/apikey-list
Z_AI_API_KEY=

# --- MOONSHOT_API_KEY: Moonshot AI / Kimi ---
# Canonical per CANONICAL_NAMES.md §Provider keys (2026-07-02)
# Alias: KIMI_API_KEY (sunset: 2026-10-01)
# Provider: moonshot | API base: https://api.moonshot.ai/v1
# Model suit: kimi-k2
# TensorZero: agent_zero, langextract
# How to obtain: https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=

# --- ALIBABA_PRO_CODING_PLAN: Alibaba / DashScope / Qwen ---
# Canonical per CANONICAL_NAMES.md §Provider keys (2026-07-02)
# Aliases: ALIBABA_API_KEY, DASHSCOPE_API_KEY (sunset: 2026-10-01)
# Provider: alibaba | API base: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Key pattern: sk- + 32 hex chars (disambiguates from OpenAI sk-proj-)
# TensorZero: agent_zero, coding_alibaba (primary), archon_work_orders, deepresearch
# How to obtain: https://dashscope.console.aliyun.com/
ALIBABA_PRO_CODING_PLAN=

# --- KILOCODE_API_KEY: Kilo Code Coding Plan ---
# Born canonical 2026-07-02 (cloud-hybrid tier addition)
# No deprecated aliases
# Provider: kilocode | API base: https://api.kilocode.ai/api/openrouter
# TensorZero: pmoves_orchestrator_coding (secondary)
# How to obtain: https://api.kilocode.ai
KILOCODE_API_KEY=

# --- OLLAMA_API_KEY: Ollama Pro Cloud ---
# Born canonical 2026-07-02 (cloud-hybrid tier addition)
# No deprecated aliases
# Provider: ollama_cloud | API base: https://ollama.com/v1
# NOTE: This is OLLAMA PRO CLOUD (distinct from OLLAMA_BASE_URL for local Ollama)
# TensorZero: pmoves_orchestrator_chat (primary), pmoves_orchestrator_coding (fallback)
# How to obtain: https://ollama.com/settings/keys
OLLAMA_API_KEY=

# --- HF_TOKEN: HuggingFace Inference Router ---
# Canonical per CANONICAL_NAMES.md §Provider keys (2026-07-02)
# Alias: HUGGINGFACE_TOKEN (sunset: 2026-10-01)
# Provider: huggingface | API base: https://router.huggingface.co/v1
# Key pattern: hf_ + 34 alphanumeric chars
# TensorZero: pmoves_orchestrator_coding (fallback)
# Additional use: Model weight downloads (Unsloth, GGUF repos)
# How to obtain: https://huggingface.co/settings/tokens
HF_TOKEN=

# --- MINIMAX_API_KEY: MiniMax Token Plan ---
# Canonical per registry.json (no aliases)
# Provider: minimax | API base: https://api.minimaxi.chat/v1
# Model suits: minimax-m2.7 (primary long-context), minimax-m2.1 (efficient overflow)
# TensorZero: coding_minimax (primary, weight 0.8)
# Note: Model suits reference MINIMAX_TOKEN_PLAN_API_KEY as primary but
#       canonical per provider_catalog.yaml and registry.json is MINIMAX_API_KEY
# How to obtain: https://platform.minimax.io/docs/token-plan/intro
MINIMAX_API_KEY=

# --- OPENROUTER_API_KEY: OpenRouter Multi-Model Aggregator ---
# Canonical (no aliases)
# Provider: openrouter | API base: https://openrouter.ai/api/v1
# Key pattern: sk-or- + 28 chars
# TensorZero: agent_zero, langextract, coding_codex (fallback), coding_alibaba (fallback)
# How to obtain: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ============================================================================
# INFRASTRUCTURE: MCP_SERVER_TOKEN (A2A Enablement)
# ============================================================================

# --- MCP_SERVER_TOKEN: MCP Server Authentication ---
# Canonical per CANONICAL_NAMES.md §5
# Maps to: MCP_CLIENT_SECRET in compose interpolation
# Status: NOT_PINNED (ephemeral token used this session)
# Action: Generate durable token and pin in env.tier-agent
# Generation: openssl rand -base64 48 | tr -d '\n=' | cut -c1-64
# Compose note: Remove from compose env list; let env_file: env.tier-agent provide it
# See: pmoves/docs/operations/CANONICAL_NAMES.md §5
MCP_SERVER_TOKEN=
MCP_CLIENT_SECRET=

# ============================================================================
# ADDITIONAL PROVIDER KEYS (Priority 2 - Optional but Recommended)
# These slots already exist in env.shared.example but are included here
# for completeness in the canonical inventory.
# ============================================================================

# --- Cloudflare Workers AI ---
# Requires both API token and account ID
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Venice AI ---
VENICE_API_KEY=

# --- NVIDIA NGC / NIM ---
NGC_API_KEY=

# ============================================================================
# COMPOSE SENTINEL: unset-pending-key (formerly local-disabled)
# ============================================================================
# Per AGNOTE4482 and CANONICAL_NAMES policy, the sentinel value indicating
# a key slot is intentionally empty (pending operator fill) has been renamed
# from "local-disabled" to "unset-pending-key" to better reflect its meaning
# in the cloud-hybrid era.
#
# When a key is not yet populated, compose should use:
#   KEY_NAME=${KEY_NAME:-unset-pending-key}
#
# This sentinel is detected by the secrets funnel pipeline and logged as
# "pending-fill" rather than "active" or "disabled".
# ============================================================================
