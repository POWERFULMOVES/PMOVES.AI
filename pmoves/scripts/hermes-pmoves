#!/usr/bin/env bash
# hermes-pmoves — one-shot PMOVES-aware Hermes Agent launcher
# Runs hermes-bootstrap (profile + MCP + CHIT + verification) then launches Hermes
set -euo pipefail

REPO_ROOT=""
for candidate in \
  "$(git rev-parse --show-toplevel 2>/dev/null)" \
  "$HOME/pinokio/api/PMOVES.AI" \
  "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"; do
  if [ -f "$candidate/pmoves/Makefile" ]; then
    REPO_ROOT="$candidate"
    break
  fi
done

# ---------------------------------------------------------------------------
# NODE IDENTITY + CIPHER CARRY -- added 2026-09-16.
#
# This launcher previously told its agent NOTHING: not which node it was on, not
# which registered identity it wears, and not whether cipher would record its
# memories as itself. Measured across the nine launchers that day, only the two
# CLAUDE ones carried the full set. Cipher is shared by every agent on a node --
# auth.ts files an uncarried write under `bootstrap`, "shared with every other
# agent on the node, attributed to none" (crush-pmoves) -- so an unwired harness
# does not merely lose its own attribution, it pollutes everyone's.
#
# Both measurements are SHARED FRAGMENTS, never copied blocks: that is the rule
# pm-python.sh and pm-cipher-identity.sh were extracted under, and copying into
# eight files is named there as the cause of this family's last three defects.
#
# FAIL-OPEN, ALWAYS LOUD. Neither call can cost the launch, and every path prints
# its reason -- an unbound session is degraded, not broken, but never silent.
# ---------------------------------------------------------------------------
# NOTE: this block MUST sit after root discovery (below `done`), not inside the
# candidate loop -- running it per-candidate both repeats the work and silently
# no-ops when the first candidate lacks pmoves/Makefile.
if [ -f "$REPO_ROOT/pmoves/scripts/pm-node-identity.sh" ]; then
  # shellcheck source=./pm-node-identity.sh
  . "$REPO_ROOT/pmoves/scripts/pm-node-identity.sh"
  pm_node_identity "$REPO_ROOT" hermes hermes-pmoves || true
  echo "${PM_IDENT_LINE}" >&2
  if [ -f "$REPO_ROOT/pmoves/scripts/pm-cipher-token-bind.sh" ]; then
    # shellcheck source=./pm-cipher-token-bind.sh
    . "$REPO_ROOT/pmoves/scripts/pm-cipher-token-bind.sh"
    pm_cipher_token_bind "$REPO_ROOT" "${PM_IDENT_CIPHER_ID:-}" || true
    echo "[hermes-pmoves] ${PM_CARRY_BIND_LINE}" >&2
  fi
  if [ -f "$REPO_ROOT/pmoves/scripts/pm-cipher-identity.sh" ]; then
    # shellcheck source=./pm-cipher-identity.sh
    . "$REPO_ROOT/pmoves/scripts/pm-cipher-identity.sh"
    pm_cipher_identity "$REPO_ROOT" "${PM_IDENT_CIPHER_ID:-${PMOVES_NODE_IDENTITY:-}}" ${PM_IDENT_PY[@]+"${PM_IDENT_PY[@]}"} || true
    echo "[hermes-pmoves] ${PM_CARRY_LINE}" >&2
  fi
fi

if [ -z "$REPO_ROOT" ]; then
  echo "ERROR: Could not find PMOVES.AI repo root" >&2
  exit 1
fi

# Default to the elder-melchor profile if no profile is set
HERMES_PROFILE="${PMOVES_HERMES_PROFILE:-pmoves-hermes-elder}"

echo "◇ hermes-pmoves → bootstrapping from $REPO_ROOT (profile: $HERMES_PROFILE)"

# Clear stale DOCKER_HOST so Docker MCP tools work (Windows Docker Desktop uses named pipe)
if [ -n "${DOCKER_HOST:-}" ] && [[ "${DOCKER_HOST}" == *"tcp://localhost:2375"* ]]; then
  echo "◇ Clearing stale DOCKER_HOST=${DOCKER_HOST}"
  unset DOCKER_HOST
  export DOCKER_HOST=""
fi

PMOVES_HERMES_PROFILE="$HERMES_PROFILE" make -C "$REPO_ROOT/pmoves" hermes-bootstrap

echo ""
echo "◇ Launching Hermes..."
exec hermes --profile "$HERMES_PROFILE" "$@"
