#!/usr/bin/env bash
# crush-pmoves — one-shot PMOVES-aware Crush launcher
# Runs crush-bootstrap (config + CHIT + MCP) then launches Crush
set -euo pipefail

REPO_ROOT=""
for candidate in \
  "$(git rev-parse --show-toplevel 2>/dev/null)" \
  "$HOME/pinokio/api/PMOVES.AI"; do
  if [ -f "$candidate/pmoves/Makefile" ]; then
    REPO_ROOT="$candidate"
    break
  fi
done

if [ -z "$REPO_ROOT" ]; then
  echo "ERROR: Could not find PMOVES.AI repo root" >&2
  exit 1
fi

echo "◇ crush-pmoves → sourcing PMOVES tier env..."
source "$REPO_ROOT/pmoves/scripts/crush-env.sh"

# ---------------------------------------------------------------------------
# NODE IDENTITY — the crush twin of claude-pmoves's block. The registry and
# node-vocabulary.yaml already describe this node's crush identity
# (knuckles.default_identity.crush); the launcher's job is to resolve it and
# put it where the SESSION can read it. Crush has no --append-system-prompt,
# so the delivery mechanism is a context file: the configurator lists
# pmoves/data/identity/node-identity.md in context_paths, and Crush loads
# context files into the system prompt. Written BEFORE crush-bootstrap so the
# configurator's exists() check sees it on the very first run.
# Losing the identity must never cost the launch; losing it SILENTLY is the
# defect, so every failure mode writes its reason into the file instead.
# ---------------------------------------------------------------------------
IDENTITY_FILE="$REPO_ROOT/pmoves/data/identity/node-identity.md"
# Resolution moved to the shared fragment (2026-09-16). It was ~30 lines here
# and again in claude-pmoves.sh, and nowhere in the other seven launchers --
# the same shape pm-python.sh and pm-cipher-identity.sh were extracted for.
# Behaviour unchanged: same tool, same --harness crush, same fail-open rule.
# shellcheck source=./pm-node-identity.sh
. "$REPO_ROOT/pmoves/scripts/pm-node-identity.sh"
pm_node_identity "$REPO_ROOT" crush crush-pmoves || true
IDENT_PY=(${PM_IDENT_PY[@]+"${PM_IDENT_PY[@]}"})
echo "${PM_IDENT_LINE}" >&2
mkdir -p "$(dirname "$IDENTITY_FILE")"

# EVERY BRANCH WRITES. crush reads its context from this file, so a path that
# skips the write leaves the PREVIOUS launch's identity sitting in front of the
# model -- a confidently wrong identity, which is worse than none.
#
# Regression caught by tests/test_crush_node_identity.py on the first cut of the
# fragment migration: extracting resolution dropped the write count from 4 to 1,
# because the resolver-failed and resolver-unavailable branches each carried
# their own write and the extraction took them with it. The fragment always sets
# PM_IDENT_OK and PM_IDENT_LINE precisely so the caller can branch here instead.
if [ "${PM_IDENT_OK:-0}" = "1" ]; then
  {
    echo "# Node identity (generated at launch)"
    echo ""
    echo "You are running on PMOVES node \`${PMOVES_NODE}\`."
    echo "Your registered identity in \`pmoves/config/agent_registry.yaml\` is \`${PMOVES_NODE_IDENTITY}\`."
    echo "Disclose it at session start rather than rediscovering it."
  } > "$IDENTITY_FILE"
else
  # The reason, not just the absence: an unbound session is recoverable, a
  # silent one is not. PM_IDENT_LINE already carries why.
  {
    echo "# Node identity (generated at launch) — UNRESOLVED; launching unbound."
    echo ""
    echo "${PM_IDENT_LINE}"
    echo ""
    echo "Declare one in \`pmoves/configs/node-vocabulary.yaml\` (\`default_identity.crush\`)"
    echo "or set PMOVES_NODE_IDENTITY — do not guess an identity."
  } > "$IDENTITY_FILE"
fi
# The block above tells crush who it IS. It does not say who cipher will think
# it is, and those have been different on every node: auth.ts:46 @ e24f1323
# forks on a 'cipher_' bearer prefix, and without it every write is filed under
# 'bootstrap' -- shared with every other agent on the node, attributed to none.
#
# Wired here and not only in claude-pmoves because CRUSH runs on this fleet too
# and was getting no verdict at all. The measurement is shared (pm-cipher-identity.sh)
# so the two harnesses cannot drift into telling their agents different things.
# shellcheck source=./pm-cipher-identity.sh
. "$REPO_ROOT/pmoves/scripts/pm-cipher-identity.sh"
pm_cipher_identity "$REPO_ROOT" "${PMOVES_NODE_IDENTITY:-}" ${IDENT_PY[@]+"${IDENT_PY[@]}"} || true
echo "[crush-pmoves] ${PM_CARRY_LINE}" >&2
# crush has no --append-system-prompt; its context arrives through IDENTITY_FILE,
# so the verdict goes where crush will actually read it.
{
  echo ""
  if [ "${PM_CARRY_OK:-0}" = "1" ]; then
    echo "Cipher memory writes are attributed to \`${PM_CARRY_ID}\` — your own identity."
  else
    echo "**IDENTITY CARRY GAP.** Cipher will file your memory writes under"
    echo "\`${PM_CARRY_ID:-an advisory id you declare per call}\`, not \`${PMOVES_NODE_IDENTITY:-unresolved}\`."
    echo "Reason: ${PM_CARRY_WHY}"
    echo "Treat anything you recall as possibly another agent's. Road: \`make -C pmoves cipher-identity\`."
  fi
} >> "$IDENTITY_FILE"

echo "◇ crush-pmoves → bootstrapping from $REPO_ROOT"
make -C "$REPO_ROOT/pmoves" crush-bootstrap

# Re-source env after bootstrap (which runs secrets-funnel, may populate new values)
source "$REPO_ROOT/pmoves/scripts/crush-env.sh"

echo ""
echo "◇ Launching Crush..."
exec crush "$@"
