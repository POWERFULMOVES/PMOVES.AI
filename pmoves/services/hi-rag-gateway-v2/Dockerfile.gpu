FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04

ARG TORCH_CUDA=cu128
ARG TORCH_VERSION=2.9.0
ARG TORCHAUDIO_VERSION=2.9.0

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app:/app/libs \
    HF_HOME=/app/.cache/hf \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence-transformers \
    PATH="/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
    LD_LIBRARY_PATH="/usr/local/cuda/lib64:/usr/local/cuda/lib:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip \
        build-essential git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install --upgrade pip

WORKDIR /app

# Install torch/torchaudio with CUDA wheels, then laion-clap and service deps
RUN python3 -m pip install --index-url https://download.pytorch.org/whl/${TORCH_CUDA} \
      torch==${TORCH_VERSION} torchaudio==${TORCHAUDIO_VERSION}

# Base requirements
COPY services/hi-rag-gateway-v2/requirements.txt /app/requirements.txt
RUN python3 -m pip install -r /app/requirements.txt

# Preload default embedding model so runtime does not wait on external model downloads.
RUN python3 - <<'PY'
import os
from sentence_transformers import SentenceTransformer

model = os.environ.get("SENTENCE_MODEL_PRELOAD", "all-MiniLM-L6-v2")
cache = os.environ.get("SENTENCE_TRANSFORMERS_HOME")
SentenceTransformer(model, cache_folder=cache)
print(f"Preloaded sentence-transformer model: {model}")
PY

# CLAP (uses torch)
RUN python3 -m pip install laion-clap==1.1.4

COPY libs /app/libs
COPY services/hi-rag-gateway-v2 /app/
COPY services/common /app/services/common
COPY tools/__init__.py /app/tools/__init__.py
COPY tools/chit_security.py /app/tools/chit_security.py

# PMOVES Python namespace packages (for the in-image `from pmoves.chit`
# and `from pmoves.tools.*` imports used by services.common.shape_store,
# services.common.geometry_decoder, services.common.branch_trail, etc.).
#
# History:
#   - 30efedfb77f: CPU `Dockerfile` added the `pmoves.chit` namespace copy.
#     The GPU `Dockerfile.gpu` never picked it up; PR #3382 closed that gap.
#   - 2026-10-17 follow-up: verification surfaced a SECOND missing
#     namespace -- `pmoves.tools` -- imported by tools/chit_security.py
#     (line 25: `from pmoves.tools.chit_common import canon`), services/
#     common/geometry_decoder.py (line 75-76), services/common/branch_trail.
#     py (lines 146-147), services/common/model_fitness.py (line 22). Without
#     `pmoves.tools`, `/geometry/event` returns 500 (`ModuleNotFoundError:
#     No module named 'pmoves.tools'`) and CGP emit degrades to cgp_ok=false.
#
# The ratchet at pmoves/tests/test_dockerfile_packages_pmoves_chit.py
# pins BOTH namespaces; update the ratchet whenever a new `pmoves.*`
# import lands in services/*.
RUN mkdir -p /app/pmoves \
    && printf '"""Minimal pmoves namespace for Docker."""\n' > /app/pmoves/__init__.py \
    && mkdir -p /app/pmoves/tools \
    && printf '"""pmoves.tools namespace for Docker."""\n' > /app/pmoves/tools/__init__.py
COPY chit /app/pmoves/chit
COPY tools/__init__.py /app/pmoves/tools/__init__.py
COPY tools/chit_common.py /app/pmoves/tools/chit_common.py
COPY tools/chit_security.py /app/pmoves/tools/chit_security.py
COPY tools/sign_trail.py /app/pmoves/tools/sign_trail.py

# Make wait-for-deps.sh executable
RUN chmod +x /app/scripts/wait-for-deps.sh

# Create wrapper entrypoint with two-phase startup:
#   Phase 1: wait-for-deps.sh blocks until Supabase realtime is ready
#            (exec's /bin/true which returns immediately after deps are ready)
#   Phase 2: NVIDIA entrypoint initializes GPU environment and runs CMD
RUN printf '#!/bin/bash\nset -e\n/app/scripts/wait-for-deps.sh /bin/true\nexec /opt/nvidia/nvidia_entrypoint.sh "$@"\n' > /app/entrypoint-wrapper.sh && \
    chmod +x /app/entrypoint-wrapper.sh

# Security: Run as non-root user (GPU services need video group for device access)
RUN groupadd -r pmoves --gid=65532 && \
    useradd -r -g pmoves -G video --uid=65532 --home-dir=/app --shell=/sbin/nologin pmoves && \
    chown -R pmoves:pmoves /app

USER pmoves:pmoves

# Keep runtime online-capable by default so reranker can resolve from hub
# if RERANK_MODEL_PATH is not mounted. Offline mode can be set via env.
ENV HIRAG_HTTP_PORT=8086

EXPOSE 8086

ENTRYPOINT ["/app/entrypoint-wrapper.sh"]

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8086/ || exit 1
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8086"]
