# ============================================================================
# PMOVES Sidecar — DGX Spark (GB10 Grace-Blackwell) Environment
# ============================================================================
# Copy to env.spark-sidecar and fill in values. Do NOT commit env.spark-sidecar.
# ============================================================================

# --- Topology ---
TOPOLOGY_MODE=standalone
DOCKED_MODE=false
PARENT_SYSTEM=PMOVES.AI
PARENT_VERSION=1.0.0-hardened

# --- CHIT (dev mode) ---
CHIT_PASSPHRASE=dev-local-sidecar-override
CHIT_REQUIRE_SIGNATURE=false
CHIT_DECRYPT_ANCHORS=false

# --- Model overrides (optional — defaults in compose) ---
# SPARK_CHAT_MODEL=qwen3.5:35b-a3b-q4_K_M
# SPARK_UTIL_MODEL=qwen3.5:35b-a3b-q4_K_M
# SPARK_BROWSER_MODEL=qwen3.5:35b-a3b-q4_K_M
# SPARK_EMBED_MODEL=nomic-embed-text

# --- Optional: Moonshot Kimi mode (uncomment to use cloud instead of local Ollama) ---
# Copy MOONSHOT_API_KEY from pmoves/env.shared or your secrets store.
# MOONSHOT_API_KEY=...
# SPARK_CHAT_MODEL=kimi-k2.7-code
# SPARK_UTIL_MODEL=kimi-k2.7-code
# SPARK_BROWSER_MODEL=kimi-k2.7-code
# SPARK_CHAT_API_BASE=https://api.moonshot.ai/v1
# SPARK_UTIL_API_BASE=https://api.moonshot.ai/v1
# SPARK_BROWSER_API_BASE=https://api.moonshot.ai/v1

# --- Port bindings ---
SPARK_BIND=127.0.0.1
SPARK_PORT=8093
SPARK_UI_PORT=8094

# --- Data directories (on host) ---
SPARK_MEMORY_DIR=./data/spark/memory
SPARK_KNOWLEDGE_DIR=./data/spark/knowledge
SPARK_INSTRUMENTS_DIR=./data/spark/instruments
SPARK_LOG_DIR=./data/spark/logs
SPARK_RUNTIME_DIR=./data/spark/runtime
SPARK_USR_DIR=./usr

# --- Ollama ---
PMOVES_OLLAMA_IMAGE=ollama/ollama:0.18.0
OLLAMA_DNS_PRIMARY=1.1.1.1
OLLAMA_DNS_SECONDARY=8.8.8.8
