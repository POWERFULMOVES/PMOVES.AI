# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
playwright-report
# playwright.launcher.config.ts (per-server distDirs + its own output dirs)
/test-results-launcher
/playwright-report-launcher
/.next-e2e-*/
# Generated by `next dev` when agentRules is on (next.config.mjs turns it off).
# Scoped to pmoves/ui: the repo-root and .claude CLAUDE.md files are real.
/CLAUDE.md
/AGENTS.md

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
