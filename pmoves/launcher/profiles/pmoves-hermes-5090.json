{
  "launcher_profile_version": "1.0.0",
  "node_id": "pmoves-5090",
  "display_name": "PMOVES HERMES 5090",
  "description": "GPU inference specialist workstation (RTX 5090, 32GB VRAM, 192GB RAM). Primary local-lane compute for coding (KiloCode GLM) and voice studio rooms. Heavy inference stays local via Ollama; cloud fallback follows env.shared order (ollama_cloud first).",
  "platform": "win32",
  "pmoves_profile": "desktop-9950xd",
  "hermes_profile": "PMOVES-HERMES-5090",
  "room": {
    "room_id": "5090-kilocode.room.studio",
    "stage": "rehearsal",
    "suits": [
      "5090-kilocode",
      "5090-voice",
      "pmoves-hermes"
    ]
  },
  "requirements": {
    "min_ram_gb": 64,
    "gpu_required": true,
    "docker_desktop": true,
    "ollama": true,
    "hermes_cli": true
  },
  "env_secrets": [
    "OLLAMA_HOST",
    "OLLAMA_CLOUD_BASE_URL",
    "OLLAMA_CLOUD_API_KEY",
    "TELEGRAM_BOT_TOKEN",
    "DISCORD_BOT_TOKEN"
  ],
  "skills": [
    "minimax-agent-trails",
    "minimax-bringup-audit",
    "minimax-cgp-generate",
    "minimax-multimodal",
    "minimax-submodule-parity"
  ],
  "launcher_refs": [
    "secrets-funnel",
    "up-agents",
    "up-monitoring",
    "a0-model-sync",
    "up-darkxside-sidecar"
  ],
  "model_routing": {
    "default": "local",
    "local": {
      "provider": "ollama",
      "model": "qwen3-coder:30b",
      "base_url": "http://localhost:11434"
    },
    "fallback": {
      "provider": "openai",
      "model": "glm-5.2",
      "base_url": "https://ollama.com/v1",
      "api_key_env": "OLLAMA_CLOUD_API_KEY"
    }
  },
  "platform_toolsets": [
    "telegram",
    "discord"
  ],
  "notes": [
    "Ollama tags byte-verified live on the node (pmoves-5090 :11434, 2026-10-25): qwen3-coder:30b, gpt-oss:20b, qwen3.5:9b, gemma3:12b, mistral-small3.2:24b, hermes3:8b; embeds nomic-embed-text (latest + v1.5), Qwen3-Embedding-4B Q8_0. Use only tags that exist in the node registry (see #3402: 3 of 4 suit tags were 404).",
    "Alternate local chat lane: gpt-oss:20b. Embedding lane: nomic-embed-text:latest.",
    "pmoves_profile uses the canonical id desktop-9950xd; the workstation_5090 yaml is a deprecated alias.",
    "Room stage stays rehearsal as the room manifests define it; flip via the room manifest, not this profile.",
    "A0 presets for this node are generator-owned: make a0-model-sync (registry = config authority); hand presets survive per #3396 hybrid contract.",
    "The Hermes profile itself must be created on the node (hermes profile use PMOVES-HERMES-5090); this launcher profile declares and seeds it.",
    "Cloud fallback follows env.shared order: ollama_cloud first. No API-burn lanes by default.",
    "Profile is local-only; never commit secret values."
  ],
  "hermes_config_overrides": {
    "model": {
      "default": "qwen3-coder:30b",
      "provider": "ollama",
      "base_url": "http://localhost:11434",
      "api_key": "",
      "context_length": 32768,
      "ollama_num_ctx": 32768
    },
    "model_gpu": {
      "provider": "ollama",
      "model": "qwen3-coder:30b",
      "base_url": "http://localhost:11434",
      "api_key": "",
      "context_length": 32768,
      "ollama_num_ctx": 32768
    },
    "models": {
      "local": {
        "provider": "ollama",
        "model": "qwen3-coder:30b",
        "base_url": "http://localhost:11434",
        "api_key": ""
      },
      "remote_gpu": {
        "provider": "ollama",
        "model": "qwen3-coder:30b",
        "base_url": "http://localhost:11434",
        "api_key": ""
      }
    },
    "agent": {
      "max_turns": 90,
      "verbose": false,
      "reasoning_effort": "medium"
    },
    "terminal": {
      "backend": "local",
      "cwd": "D:\\PMOVES.AI\\PMOVES.AI",
      "timeout": 300,
      "home_mode": "auto",
      "container_cpu": 2,
      "container_memory": 8192,
      "container_disk": 51200,
      "container_persistent": true,
      "docker_mount_cwd_to_workspace": false,
      "lifetime_seconds": 300
    },
    "delegation": {
      "model": "qwen3-coder:30b",
      "provider": "ollama",
      "base_url": "http://localhost:11434",
      "api_key": "",
      "max_iterations": 50,
      "remote_model": "remote_gpu",
      "subagent_auto_approve": false
    },
    "platform_toolsets": {
      "cli": [
        "browser",
        "clarify",
        "code_execution",
        "computer_use",
        "cronjob",
        "delegation",
        "file",
        "image_gen",
        "kanban",
        "memory",
        "session_search",
        "skills",
        "terminal",
        "todo",
        "tts",
        "vision",
        "web"
      ],
      "telegram": [
        "hermes-telegram"
      ],
      "discord": [
        "hermes-discord"
      ]
    },
    "fallback_model": {
      "provider": "openai",
      "model": "glm-5.2",
      "base_url": "https://ollama.com/v1",
      "api_key": "${OLLAMA_CLOUD_API_KEY}"
    },
    "security": {
      "redact_secrets": true,
      "tirith_enabled": true,
      "tirith_path": "tirith",
      "tirith_timeout": 5,
      "tirith_fail_open": false
    },
    "memory": {
      "memory_enabled": true,
      "user_profile_enabled": true,
      "memory_char_limit": 2200,
      "user_char_limit": 1375,
      "nudge_interval": 10,
      "flush_min_turns": 6
    },
    "display": {
      "compact": false,
      "busy_input_mode": "interrupt",
      "bell_on_complete": false,
      "show_reasoning": false,
      "streaming": true,
      "skin": "default",
      "interim_assistant_messages": true,
      "tool_progress": "all",
      "cleanup_progress": false,
      "long_running_notifications": true,
      "busy_ack_detail": true,
      "background_process_notifications": "all"
    },
    "compression": {
      "enabled": true,
      "threshold": 0.5,
      "target_ratio": 0.2,
      "protect_last_n": 20,
      "protect_first_n": 3
    }
  }
}
