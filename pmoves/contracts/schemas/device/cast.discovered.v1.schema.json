{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "device.cast.discovered.v1",
  "description": "Published when Cast device discovery completes, reporting current device inventory.",
  "type": "object",
  "required": ["devices", "count", "timestamp"],
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "ip", "address"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Friendly device name."
          },
          "ip": {
            "type": "string",
            "description": "Device IP address."
          },
          "address": {
            "type": "string",
            "description": "Full address including port."
          }
        },
        "additionalProperties": false
      },
      "description": "List of discovered Cast devices."
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of discovered devices."
    },
    "timestamp": {
      "type": "string",
      "description": "ISO8601 timestamp of discovery."
    },
    "new_devices": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Device names that appeared since last discovery."
    },
    "lost_devices": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Device names that disappeared since last discovery."
    },
    "forced": {
      "type": "boolean",
      "description": "Whether this was a forced (manual) discovery."
    }
  },
  "additionalProperties": false
}
