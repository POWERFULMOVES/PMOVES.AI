{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToKenism Settlement Requested v1",
  "type": "object",
  "required": [
    "settlement_id",
    "source_subject",
    "cgp_spec",
    "cgp_hash",
    "week",
    "status",
    "settlement_profile",
    "instructions",
    "totals",
    "created_at",
    "agent_id",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "settlement_id": { "type": "string", "pattern": "^settlement_[a-f0-9]{16}$" },
    "source_subject": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string" },
    "cgp_spec": { "type": "string", "enum": ["chit.cgp.v0.2", "chit.cgp.v1.0"] },
    "cgp_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "week": { "type": "integer", "minimum": 0 },
    "status": { "type": "string", "enum": ["planned", "approved"] },
    "settlement_profile": { "type": "string", "minLength": 1 },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instruction" }
    },
    "totals": {
      "type": "object",
      "required": ["instruction_count", "amount", "asset"],
      "additionalProperties": false,
      "properties": {
        "instruction_count": { "type": "integer", "minimum": 1 },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "asset": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "agent_id": { "type": "string", "minLength": 1 },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "instruction": {
      "type": "object",
      "required": [
        "instruction_id",
        "idempotency_key",
        "lane",
        "action",
        "address",
        "amount",
        "asset",
        "source_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "instruction_id": { "type": "string", "pattern": "^settle_inst_[a-f0-9]{16}$" },
        "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,180}$" },
        "lane": { "type": "string", "enum": ["firefly", "contract", "manual"] },
        "action": {
          "type": "string",
          "enum": [
            "grotoken_mint",
            "foodusd_transfer",
            "reward_distribute",
            "group_purchase_settle",
            "vault_stake",
            "governance_record"
          ]
        },
        "address": { "type": "string", "minLength": 1 },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "asset": { "type": "string", "minLength": 1 },
        "source_ref": {
          "type": "object",
          "required": ["cgp_hash", "contributor_weight"],
          "additionalProperties": false,
          "properties": {
            "cgp_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
            "merkle_root": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
            "contributor_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "raw_contribution": { "type": "number" }
          }
        },
        "firefly": { "type": "object", "additionalProperties": true },
        "contract": { "type": "object", "additionalProperties": true },
        "metadata": { "type": "object", "additionalProperties": true }
      }
    },
    "signature": {
      "type": "object",
      "required": ["alg", "kid", "hmac"],
      "additionalProperties": true,
      "properties": {
        "alg": { "type": "string", "minLength": 1 },
        "kid": { "type": "string", "minLength": 1 },
        "hmac": { "type": "string", "minLength": 1 }
      }
    }
  }
}
