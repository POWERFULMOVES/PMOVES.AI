{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content Raw",
  "type": "object",
  "required": [
    "content_id",
    "text",
    "source_ref"
  ],
  "properties": {
    "content_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "content_type": {
      "type": "string"
    },
    "lane": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "favorite_words": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta": {
      "type": "object"
    }
  }
}
