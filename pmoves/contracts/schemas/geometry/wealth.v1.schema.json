{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wealth Tokenism Geometry Packet (geometry.wealth.v1)",
  "description": "CGP payload representing compute/capital tokens as geometry points for A2UI.",
  "type": "object",
  "required": [
    "spec",
    "type",
    "super_nodes"
  ],
  "additionalProperties": true,
  "properties": {
    "spec": {
      "type": "string",
      "enum": ["chit.cgp.v0.2"]
    },
    "type": {
      "type": "string",
      "enum": ["geometry.wealth.v1"]
    },
    "id": { "type": "string" },
    "label": { "type": "string" },
    "source": { "type": "string" },
    "ts": { "type": ["number", "string"] },
    "super_nodes": {
      "type": "array",
      "minItems": 1
    },
    "control_plane": {
      "type": "object",
      "properties": {
        "state_vector": {
          "type": "object",
          "properties": {
            "delta": { "type": "number", "description": "Velocity of money/Compute utilization" },
            "kappa": { "type": "number", "description": "Capital retention/Curvature of supply" },
            "Hz": { "type": "number", "description": "Burn rate / Spectral Density of transactions" },
            "A": { "type": "number", "description": "Attribution/Stake weight" },
            "F": { "type": "number", "description": "Portfolio ROI/Swarm Fitness" }
          }
        }
      }
    }
  }
}
