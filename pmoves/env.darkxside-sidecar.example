# ============================================================================
# PMOVES Sidecar — DARKXSIDE Environment
# ============================================================================
# Copy to env.darkxside-sidecar and fill in values. Do NOT commit env.darkxside-sidecar.
# ============================================================================

# --- Topology ---
TOPOLOGY_MODE=standalone
DOCKED_MODE=false
PARENT_SYSTEM=PMOVES.AI
PARENT_VERSION=1.0.0-hardened

# --- CHIT (dev mode) ---
CHIT_PASSPHRASE=dev-local-sidecar-override
CHIT_REQUIRE_SIGNATURE=false
CHIT_DECRYPT_ANCHORS=false

# --- Model overrides (optional — defaults in compose) ---
# DARKXSIDE_BROWSER_MODEL=qwen3.5-35b-a3b
# DARKXSIDE_EMBED_MODEL=qwen3-embedding:4b

# --- Port bindings ---
DARKXSIDE_BIND=127.0.0.1
DARKXSIDE_PORT=8092

# --- Data directories (on host) ---
DARKXSIDE_MEMORY_DIR=./data/darkxside/memory
DARKXSIDE_KNOWLEDGE_DIR=./data/darkxside/knowledge
DARKXSIDE_INSTRUMENTS_DIR=./data/darkxside/instruments
DARKXSIDE_LOG_DIR=./data/darkxside/logs
DARKXSIDE_RUNTIME_DIR=./data/darkxside/runtime
DARKXSIDE_USR_DIR=./usr
