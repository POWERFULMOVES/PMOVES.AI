# =============================================================================
# SEMANTIC CACHE — Issue #1427 (docker-compose.cache.yml overlay)
# =============================================================================
# These variables configure the semantic-cache service that intercepts LLM
# requests for similarity-based caching via pgvector (Layer 1) and Cipher
# Memory (Layer 0).
#
# Loaded by: docker-compose.cache.yml (environment: block)
# Tier:      api  (depends on Supabase, TensorZero, Hi-RAG, NATS)
#
# SECURITY: All values are env-driven; no hardcoded credentials.
# =============================================================================

# --- Service binding ---
SEMANTIC_CACHE_BIND=127.0.0.1          # Host bind address (0.0.0.0 for LAN)
SEMANTIC_CACHE_HOST_PORT=8107          # Host-facing port (8107 avoids conflict with github-branch-cleanup:8100)

# --- Supabase / pgvector (Layer 1) ---
# SUPABASE_URL is set above in the shared stack section (http://supabase-kong:8000)
# SUPABASE_SERVICE_ROLE_KEY is set in env.tier-supabase
# CACHE_DATABASE_URL is optional (direct postgres:// fallback); leave empty for REST-only

# --- Cache behaviour ---
CACHE_MAX_ENTRIES=10000                # LRU eviction ceiling
CACHE_SIMILARITY_THRESHOLD=0.92        # Cosine similarity threshold (0.0–1.0)
CACHE_TTL_CHAT_SECS=3600               # Chat completion cache TTL (seconds)
CACHE_TTL_EMBED_SECS=3600              # Embedding cache TTL (seconds)
MAX_CACHEABLE_TEMPERATURE=0.5          # Max temperature for cacheable requests
CACHE_EMBEDDING_MODEL=BAAI/bge-m3      # Default embedding model identifier
CACHE_EMBEDDING_DIM=1024               # Dense vector dimension (BGE-M3 = 1024)

# --- Cipher Layer 0 ---
CIPHER_LAYER_ENABLED=true              # Enable Cipher Memory pre-check
CIPHER_MCP_URL=http://cipher-api:3000/mcp/sse

# --- Tokenism attribution ---
CACHE_TOKENISM_ENABLED=true            # Publish cache-hit cost savings to Tokenism

# --- Circuit breaker ---
CACHE_CB_FAILURE_THRESHOLD=5           # Consecutive failures before opening circuit
CACHE_CB_RESET_SECS=60                 # Seconds before half-open probe

# --- Hi-RAG Gateway v2 (embedding backend) ---
HIRAG_GATEWAY_URL=http://hi-rag-gateway-v2:8086
# HIRAG_EMBEDDINGS_URL=                  # Direct embeddings endpoint override (optional)

# --- NATS ---
# NATS_URL is set above in the shared stack section (nats://nats:***@nats:4222)

# --- TensorZero ---
# TENSORZERO_URL is set above in the shared stack section (http://tensorzero-gateway:3000)
