# =============================================================================
# PMOVES.AI Shared Environment Template
# =============================================================================
# This is a template file with placeholder values.
# Copy this file and fill in your actual credentials locally.
# DO NOT commit actual credentials to git.
#
# Usage:
#   1. Copy this file: cp env.shared env.local
#   2. Fill in your actual values in env.local
#   3. Run: python3 -m pmoves.tools.chit_encode_secrets
#   4. This creates: pmoves/data/chit/env.cgp.json with encoded secrets
# =============================================================================

# ============================================================================
# LLM Provider API Keys
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here
GOOGLE_API_KEY=your-key-here
GEMINI_API_KEY=your-key-here
OPENROUTER_API_KEY=sk-or-your-key-here
GROQ_API_KEY=gsk-your-key-here
DEEPSEEK_API_KEY=sk-your-key-here
MISTRAL_API_KEY=your-key-here
PERPLEXITYAI_API_KEY=pplx-your-key-here
TOGETHER_AI_API_KEY=tgp_v1-your-key-here
COHERE_API_KEY=your-key-here
FIREWORKS_AI_API_KEY=fw_your-key-here
XAI_API_KEY=xai-your-key-here
ELEVENLABS_API_KEY=sk-your-key-here
NVIDIA_API_KEY=nvapi-your-key-here

# ============================================================================
# Service Configuration
# ============================================================================
OLLAMA_BASE_URL=http://ollama:11434
OPENAI_COMPATIBLE_BASE_URL=http://localhost:1234/v1
OPENAI_API_BASE=

# ============================================================================
# Supabase (local development)
# ============================================================================
SUPABASE_URL=http://host.docker.internal:65421
SUPABASE_ANON_KEY=sb_your-anon-key-here
SUPABASE_SERVICE_KEY=eyJyour-service-key-here
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ============================================================================
# Open Notebook
# ============================================================================
OPEN_NOTEBOOK_API_URL=http://localhost:5055
OPEN_NOTEBOOK_API_TOKEN=your-token-here
OPEN_NOTEBOOK_PASSWORD=your-password-here
SURREAL_URL=ws://open-notebook-surrealdb-ext:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root

# ============================================================================
# External Integrations
# ============================================================================
DISCORD_WEBHOOK_URL=your-discord-webhook-url-here
DISCORD_USERNAME=POWERFULMOVES
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_BOT_NAME=@your-bot-name

# ============================================================================
# Database & Storage
# ============================================================================
POSTGRES_DB=pmoves
POSTGRES_HOSTNAME=supabase-db
POSTGRES_PORT=5432
MEILI_MASTER_KEY=your-meilisearch-master-key-here
MINIO_USER=pmoves
MINIO_PASSWORD=your-minio-password-here

# ============================================================================
# Service User Credentials
# ============================================================================
SERVICE_PASSWORD_ADMIN=your-admin-password-here
SERVICE_PASSWORD_POSTGRES=your-postgres-password-here
SERVICE_USER_ADMIN=pmovesadmin
VALID_API_KEYS=164482

# ============================================================================
# Feature Flags
# ============================================================================
TENSORZERO_API_KEY=
HUGGINGFACE_HUB_TOKEN=
VOYAGE_API_KEY=
WGER_API_TOKEN=your-wger-token-here

# ============================================================================
# Jellyfin (if using)
# ============================================================================
JELLYFIN_API_KEY=your-jellyfin-api-key-here
JELLYFIN_URL=http://localhost:8096
JELLYFIN_USER_ID=your-jellyfin-user-id-here
JELLYFIN_PUBLISHED_URL=http://localhost:8096

# =============================================================================
# End of shared environment template
# =============================================================================
