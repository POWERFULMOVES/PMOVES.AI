{
  "manifest_version": 3,
  "name": "PMOVES.AI - YouTube RAG Processor",
  "version": "1.0.0",
  "description": "One-click YouTube video processing with PMOVES.AI: ingest, transcribe, search knowledge, GPU orchestration, TTS, and multi-agent coordination.",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "http://localhost:3030/*",
    "http://localhost:8200/*",
    "http://localhost:8086/*",
    "http://localhost:8077/*",
    "http://localhost:8080/*",
    "http://localhost:8055/*",
    "http://localhost:9090/*",
    "http://localhost:8085/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options/options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
