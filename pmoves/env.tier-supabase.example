# =============================================================================
# PMOVES Supabase Environment Variables
# =============================================================================
# Services: Supabase (DB, GoTrue, PostgREST, Kong, Realtime, Storage, Studio,
#           imgproxy, Meta, Edge Functions, Analytics, Vector, Supavisor)
# Scope: Self-hosted Supabase stack (13 services)
#
# Naming convention: Standard Supabase names are PRIMARY (JWT_SECRET, ANON_KEY,
# SERVICE_ROLE_KEY). SUPABASE_* prefixed aliases are kept for backward compat.
#
# Copy to `env.tier-supabase` and fill in real values. The file is gitignored.
# Generate secrets: make -C pmoves supa-init  OR  scripts/supabase/generate-keys.sh
# =============================================================================

# =============================================================================
# Core Secrets (REQUIRED — generate with: openssl rand -base64 32)
# =============================================================================

# JWT signing secret — shared by GoTrue, PostgREST, Realtime, Storage, Kong, Edge Functions
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=3600
JWT_ALGORITHM=HS256

# Public/anon key — JWT signed with JWT_SECRET, role=anon
ANON_KEY=your_anon_key_here

# Service role key — JWT signed with JWT_SECRET, role=service_role (admin access)
SERVICE_ROLE_KEY=your_service_role_key_here

# Backward-compatible aliases (consumed by some PMOVES services)
# NOTE: Docker env_file does NOT interpolate ${VAR} — copy the actual values here.
# generate-keys.sh outputs the real values for these aliases automatically.
SUPABASE_JWT_SECRET=your_jwt_secret_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =============================================================================
# Database Connection
# =============================================================================

POSTGRES_USER=pmoves
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=pmoves

# Aliases for PMOVES compose services that use SUPABASE_DB_* naming
# NOTE: Docker env_file does NOT interpolate ${VAR} — copy the actual values here.
SUPABASE_DB_USER=pmoves
SUPABASE_DB_PASSWORD=your_secure_password_here
SUPABASE_DB_NAME=pmoves

# =============================================================================
# URLs
# =============================================================================

SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000

# Legacy aliases (duplicate the values above — env_file does NOT interpolate)
SUPABASE_SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_API_EXTERNAL_URL=http://localhost:9999

# =============================================================================
# PostgREST
# =============================================================================

SUPABASE_SCHEMA=public,pmoves_core,pmoves_kb
# Make non-public schemas reachable by table name without requiring Accept-Profile.
PGRST_DB_EXTRA_SEARCH_PATH=pmoves_core,pmoves_kb,public
SUPABASE_ANON_ROLE=anon
SUPABASE_MAX_ROWS=1000
SUPABASE_DB_POOL=30
SUPABASE_DB_POOLER_ENABLED=true
SUPABASE_POOL_TIMEOUT=5

# Extra search_path for PostgREST so views/tables in pmoves_core and pmoves_kb
# are addressable without fully-qualified names. Must be kept in sync with
# the PGRST_DB_EXTRA_SEARCH_PATH value in docker-compose.yml.
PGRST_DB_EXTRA_SEARCH_PATH=pmoves_core,pmoves_kb,public

# =============================================================================
# New Service Secrets (Phase 1 additions)
# =============================================================================

# Realtime + Supavisor shared encryption key (generate: openssl rand -base64 48)
SECRET_KEY_BASE=your_secret_key_base_here

# Supavisor vault encryption key (32+ chars, generate: openssl rand -hex 16)
VAULT_ENC_KEY=your_vault_enc_key_here

# Postgres-meta encryption key (32+ chars, generate: openssl rand -hex 16)
PG_META_CRYPTO_KEY=your_pg_meta_crypto_key_here

# Analytics (Logflare) access tokens
LOGFLARE_PUBLIC_ACCESS_TOKEN=your_logflare_public_token_here
LOGFLARE_PRIVATE_ACCESS_TOKEN=your_logflare_private_token_here

# imgproxy
IMGPROXY_ENABLE_WEBP_DETECTION=true

# Edge Functions
FUNCTIONS_VERIFY_JWT=true

# Realtime secret (legacy — use SECRET_KEY_BASE for new deployments)
SUPABASE_REALTIME_SECRET=your_realtime_secret_here

# Supavisor connection pooler
POOLER_TENANT_ID=default-tenant
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5

# =============================================================================
# Ports (override if needed)
# =============================================================================

SUPABASE_DB_PORT=54322
SUPABASE_STUDIO_PORT=54323
SUPABASE_GOTRUE_PORT=9999
SUPABASE_POSTGREST_PORT=3000
SUPABASE_REALTIME_PORT=4010
SUPABASE_STORAGE_PORT=5000
SUPABASE_KONG_PROXY_PORT=8000
SUPABASE_KONG_ADMIN_PORT=8001
SUPABASE_POOLER_PORT=54329
SUPABASE_POOLER_TRANSACTION_PORT=6543

# =============================================================================
# PMOVES Extensions
# =============================================================================

DOCKED_MODE=true
PARENT_SYSTEM=PMOVES.AI
PARENT_VERSION=1.0.0
