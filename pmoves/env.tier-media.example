# =============================================================================
# PMOVES Media Tier Environment Variables
# =============================================================================
# Services: pmoves-yt, ffmpeg-whisper, media-video, media-audio
# Scope: MinIO for storage, NATS for events, Supabase for metadata
#
# Copy to `env.tier-media` and fill in real values. The file is gitignored.
# =============================================================================

# ----- NATS (Event Bus) -----
NATS_URL=nats://nats:pmoves@nats:4222

# ----- MinIO (Media Storage) -----
# Left UNSET so docker-compose's ${MINIO_ENDPOINT:-${S3_ENDPOINT:-minio:9000}} governs:
# set S3_ENDPOINT (env.shared) to flip ALL consumers to juicefs-gateway:9000 at once.
# Uncomment below only to pin THIS tier to a specific endpoint (overrides the switch).
# MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=assets
MINIO_OUTPUT_BUCKET=outputs

# ----- Supabase (Metadata) -----
SUPA_REST_URL=http://host.docker.internal:65421/rest/v1
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ----- PMOVES.YT -----
YT_CHANNEL_CHECK_INTERVAL=3600
YT_INGEST_URL=http://pmoves-yt:8077/yt/ingest

# ----- FFmpeg-Whisper -----
WHISPER_MODEL=small

# ----- Biometric Data Controls (Cyber Defence Initiative) -----
# Per docs/biometric-data-handling-policy.md — T4 classification
# Defaults are opt-IN for biometrics. NEVER flip to true without policy review.
WHISPER_DIARIZE=false
VIDEO_FACE_DETECT=false
AUDIO_EMOTION_MODE=text_only
BIOMETRIC_LOG_REDACT=true
BIOMETRIC_STRICT_MODE=true

WHISPER_LANGUAGE=en

# ----- Media Analysis -----
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.25
FRAME_SAMPLE_RATE=5

# ----- Indexer Namespace -----
INDEXER_NAMESPACE=pmoves
