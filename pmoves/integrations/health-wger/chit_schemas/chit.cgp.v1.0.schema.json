{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pmoves.ai/schemas/chit.cgp.v1.0.schema.json",
  "title": "CHIT Geometry Packet (CGP) v1.0",
  "description": "Geometric protocol for information encoding with holographic compression and provenance tracking",
  "type": "object",
  "required": ["spec", "meta", "super_nodes"],
  "properties": {
    "spec": {
      "type": "string",
      "const": "chit.cgp.v1.0",
      "description": "Protocol version identifier"
    },
    "meta": {
      "type": "object",
      "description": "Metadata about the CGP packet",
      "required": ["source", "units_mode", "K", "bins", "backend"],
      "properties": {
        "source": {
          "type": "string",
          "enum": ["docx", "text", "latent", "image", "audio", "video"],
          "description": "Content source type"
        },
        "units_mode": {
          "type": "string",
          "enum": ["paragraphs", "sentences", "tokens", "frames", "samples"],
          "description": "Granularity of content units"
        },
        "K": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of constellations (typically 4-16)"
        },
        "bins": {
          "type": "integer",
          "minimum": 1,
          "description": "Spectrum resolution (typically 5-12)"
        },
        "backend": {
          "type": "string",
          "description": "Embedding model used"
        },
        "mhep": {
          "type": "number",
          "description": "Multi-scale Hyperbolic Entropy Product"
        },
        "Hg_traj": {
          "type": "array",
          "items": {"type": "number"},
          "description": "Global entropy trajectory"
        },
        "Hs_traj": {
          "type": "array",
          "items": {"type": "number"},
          "description": "Slab entropy trajectory"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp of creation"
        },
        "encoder_version": {
          "type": "string",
          "description": "Encoder software version"
        },
        "zeta_filtering": {
          "type": "boolean",
          "description": "Whether Zeta spectral filtering was applied"
        }
      }
    },
    "sig": {
      "type": "object",
      "description": "HMAC-SHA256 signature for verification",
      "required": ["alg", "kid", "ts", "hmac"],
      "properties": {
        "alg": {
          "type": "string",
          "const": "HMAC-SHA256",
          "description": "Signature algorithm"
        },
        "kid": {
          "type": "string",
          "minLength": 16,
          "maxLength": 32,
          "description": "Key identifier"
        },
        "ts": {
          "type": "integer",
          "description": "Unix timestamp of signature"
        },
        "hmac": {
          "type": "string",
          "description": "Base64-encoded HMAC signature"
        }
      }
    },
    "super_nodes": {
      "type": "array",
      "description": "Super nodes containing constellations",
      "items": {
        "type": "object",
        "required": ["id", "constellations"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique super node identifier"
          },
          "label": {
            "type": "string",
            "description": "Human-readable label"
          },
          "summary": {
            "type": "string",
            "description": "Semantic cluster description"
          },
          "x": {
            "type": "number",
            "description": "2D layout X coordinate (PCA/UMAP)"
          },
          "y": {
            "type": "number",
            "description": "2D layout Y coordinate (PCA/UMAP)"
          },
          "r": {
            "type": "number",
            "description": "Radius for visualization"
          },
          "hyperbolic": {
            "type": "object",
            "description": "Poincaré disk encoding",
            "properties": {
              "poincare": {
                "type": "array",
                "items": {"type": "number"},
                "minItems": 2,
                "maxItems": 2,
                "description": "Poincaré disk coordinates [x, y]"
              },
              "curvature": {
                "type": "number",
                "const": -1.0,
                "description": "Hyperbolic curvature (fixed at -1.0)"
              }
            }
          },
          "constellations": {
            "type": "array",
            "description": "Geometric constellations",
            "items": {
              "type": "object",
              "required": ["id", "anchor", "radial_minmax", "spectrum"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Unique constellation identifier"
                },
                "label": {
                  "type": "string",
                  "description": "Constellation label"
                },
                "summary": {
                  "type": "string",
                  "description": "Topic keywords or semantic summary"
                },
                "anchor": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 1,
                  "description": "Anchor direction (unit vector in embedding space)"
                },
                "radial_minmax": {
                  "type": "array",
                  "items": {"type": "number"},
                  "minItems": 2,
                  "maxItems": 2,
                  "description": "Radial bounds along anchor [min, max]"
                },
                "spectrum": {
                  "type": "array",
                  "items": {"type": "number", "minimum": 0},
                  "description": "Energy spectrum (histogram over radial bins)"
                },
                "spectrum_zeta": {
                  "type": "array",
                  "items": {"type": "number", "minimum": 0},
                  "description": "Zeta-filtered spectrum"
                },
                "points": {
                  "type": "array",
                  "description": "Content points (optional for geometry-only mode)",
                  "items": {
                    "type": "object",
                    "required": ["id"],
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "Unique point identifier"
                      },
                      "x": {
                        "type": "number",
                        "description": "2D visualization X coordinate"
                      },
                      "y": {
                        "type": "number",
                        "description": "2D visualization Y coordinate"
                      },
                      "proj": {
                        "type": "number",
                        "description": "Projection onto anchor"
                      },
                      "conf": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Assignment confidence (max p_ij)"
                      },
                      "text": {
                        "type": "string",
                        "description": "Original unit text"
                      },
                      "text_b64": {
                        "type": "string",
                        "description": "Base64 encoded text"
                      },
                      "char_len": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Character length"
                      },
                      "word_count": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Word count"
                      },
                      "embedding": {
                        "type": "array",
                        "items": {"type": "number"},
                        "description": "Raw embedding vector"
                      },
                      "contributor_id": {
                        "type": "string",
                        "description": "Contributor identifier for attribution"
                      },
                      "merkle_proof": {
                        "type": "array",
                        "items": {"type": "string"},
                        "description": "Merkle proof for tamper evidence"
                      },
                      "weight": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1,
                        "description": "Attribution weight"
                      }
                    }
                  }
                },
                "maca_consensus": {
                  "type": "object",
                  "description": "MACA (Multi-Agent Constellation Attribution) consensus",
                  "properties": {
                    "entropy_delta": {
                      "type": "number",
                      "description": "Entropy change from consensus"
                    },
                    "votes": {
                      "type": "array",
                      "items": {"type": "integer", "minimum": 0},
                      "description": "Vote counts per option"
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1,
                      "description": "Consensus confidence level"
                    }
                  }
                },
                "anchor_enc": {
                  "type": "object",
                  "description": "AES-GCM encrypted anchor",
                  "required": ["alg", "iv", "salt", "ct"],
                  "properties": {
                    "alg": {
                      "type": "string",
                      "const": "AES-GCM",
                      "description": "Encryption algorithm"
                    },
                    "iv": {
                      "type": "string",
                      "description": "Base64-encoded initialization vector"
                    },
                    "salt": {
                      "type": "string",
                      "description": "Base64-encoded salt"
                    },
                    "ct": {
                      "type": "string",
                      "description": "Base64-encoded ciphertext"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "nats": {
      "type": "object",
      "description": "NATS publishing metadata",
      "properties": {
        "subject": {
          "type": "string",
          "description": "NATS subject for publishing"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601 timestamp"
        },
        "publisher_id": {
          "type": "string",
          "description": "Publisher identifier"
        },
        "stream": {
          "type": "string",
          "description": "JetStream stream name"
        }
      }
    }
  }
}
