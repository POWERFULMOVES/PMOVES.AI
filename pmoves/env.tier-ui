SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhdWQiOlsic2VydmljZV9yb2xlIl0sImV4cCI6MTc5MjU1NTQyMywiaWF0IjoxNzYxMDE5NDIzLCJpc3MiOiJzdXBhYmFzZSIsInJvbGUiOiJzZXJ2aWNlX3JvbGUifQ.mWGd-dmPTYbv0yG6UCXKiAgFQK5flQCvRV5Pm8DgLDY

# Service URLs (for server-side API calls)
# Agent Services
AGENT_ZERO_URL=http://agent-zero:8080
ARCHON_URL=http://archon:8091

# Knowledge & Search
HIRAG_URL=http://hi-rag-gateway-v2:8086
OPEN_NOTEBOOK_API_URL=http://open-notebook:5055
TENSORZERO_URL=http://tensorzero-gateway:3000

# Media & Ingestion
PRESIGN_URL=http://presign:8088
PMOVES_YT_BASE_URL=http://pmoves-yt:8077

# Voice/TTS
FLUTE_GATEWAY_URL=http://flute-gateway:8055

# Token Economy
TOKENISM_URL=http://tokenism-simulator:8100

# Frontend Environment (Next.js)
NODE_ENV=production

# =============================================================================
# Integration Service Credentials
# =============================================================================
# External integration submodules (wger, firefly, open-notebook, jellyfin)

# Firefly III (Personal Finance Manager)
# Generate with: openssl rand -base64 32
FIREFLY_APP_KEY=

# Open Notebook SurrealDB
# NOTE: Compose uses "SURREL" (not "SURREAL") - keep this spelling
SURREL_USER=root
SURREL_PASS=${SURREL_PASS:-your_surrealdb_password_here}

# Jellyfin Media Server
JELLYFIN_PUBLISHED_URL=http://localhost:8096
JELLYFIN_MEDIA_ROOT=/media
