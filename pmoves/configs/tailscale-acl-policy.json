// PMOVES.AI Tailscale ACL policy - production hardening stance (HuJSON).
// Source of truth: applied to the tailnet by .github/workflows/deploy-tailscale-acl.yml
// (gitops-pusher rejects non-standard fields like "$schema"/"_comment"/per-rule
// "comment", so all documentation here is HuJSON // comments).
{
  // group:tenants = third-party tenant USERS subject to SSH check-mode (browser
  // re-auth) on their OWN devices. Owner/admins are intentionally excluded so fleet
  // ops never hit re-auth. Empty until tenants enroll (an empty group means the SSH
  // check rule below matches no one yet).
  "groups": {
    "group:tenants": []
  },

  "tagOwners": {
    "tag:pmoves": ["autogroup:admin"],
    "tag:gpu": ["autogroup:admin"],
    "tag:vps": ["autogroup:admin"],
    "tag:lab": ["autogroup:admin"],
    "tag:exit": ["autogroup:admin"],
    "tag:partner": ["autogroup:admin"],
    "tag:guest": ["autogroup:admin"],
    // Travel-router / subnet gateways (GL.iNet Slate). Advertise a LAN subnet + use a
    // KVM exit node; the routes auto-approver + exit-consume rule below let their WiFi
    // clients reach the internet through the exit node.
    "tag:gateway": ["autogroup:admin"]
  },

  "acls": [
    // Full mesh: all PMOVES nodes can reach each other on all ports.
    {
      "action": "accept",
      "src": ["tag:pmoves"],
      "dst": ["tag:pmoves:*"]
    },
    // Lab nodes can reach GPU nodes for inference.
    {
      "action": "accept",
      "src": ["tag:lab"],
      "dst": ["tag:gpu:*"]
    },
    // Partner access: Agent Zero API + UI, TensorZero Gateway only.
    {
      "action": "accept",
      "src": ["tag:partner"],
      "dst": ["tag:gpu:3030", "tag:gpu:8080", "tag:gpu:8081"]
    },
    // Guest demo: Agent Zero UI only.
    {
      "action": "accept",
      "src": ["tag:guest"],
      "dst": ["tag:gpu:8081"]
    },
    // Exit node consume: pmoves + lab + gateway. tag:gateway = travel-router subnet
    // gateways whose LAN clients egress to the internet via a KVM exit node. Traffic
    // from an advertised subnet is attributed to the gateway node's identity, so
    // WITHOUT tag:gateway here the clients connect but get NO internet. tag:partner
    // and tag:guest stay excluded per the RUSTDESK_SELF_HOSTED.md role matrix.
    {
      "action": "accept",
      "src": ["tag:pmoves", "tag:lab", "tag:gateway"],
      "dst": ["autogroup:internet:*"]
    },
    // DGX Spark: Ollama inference + NIM API.
    {
      "action": "accept",
      "src": ["tag:pmoves"],
      "dst": ["tag:gpu:11434", "tag:gpu:8200"]
    },
    // DGX Spark: Lab nodes can access inference.
    {
      "action": "accept",
      "src": ["tag:lab"],
      "dst": ["tag:gpu:11434", "tag:gpu:8200"]
    },
    // GPU nodes can reach PMOVES mesh services (NATS, Supabase, etc).
    {
      "action": "accept",
      "src": ["tag:gpu"],
      "dst": ["tag:pmoves:*"]
    },
    // Admins + Owner (DARKXSIDE) have full network access. Owner is listed explicitly
    // because Tailscale SSH requires BOTH a network-access rule (this) AND an ssh rule;
    // the owner is distinct from autogroup:admin, so without owner here the SSH
    // exemption below is denied at the network layer (port 22 never reached).
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:owner"],
      "dst": ["*:*"]
    }
  ],

  "ssh": [
    // SSH between PMOVES nodes - non-root only for hardening.
    {
      "action": "accept",
      "src": ["tag:pmoves"],
      "dst": ["tag:pmoves"],
      "users": ["autogroup:nonroot"]
    },
    // Admin + Owner SSH (root allowed for provisioning). Owner role is DISTINCT from
    // Admin and must be listed explicitly, else owner SSH falls through to the tenant
    // check rule below. SSH dst does NOT accept the "*" wildcard (only tags +
    // autogroup:self, unlike network ACLs which take "*:*"), so the fleet is enumerated
    // by tag. autogroup:self lets admins/owner reach their own untagged devices.
    {
      "action": "accept",
      "src": ["autogroup:admin", "autogroup:owner"],
      "dst": [
        "autogroup:self",
        "tag:pmoves",
        "tag:gpu",
        "tag:vps",
        "tag:lab",
        "tag:exit",
        "tag:partner",
        "tag:guest"
      ],
      "users": ["root", "autogroup:nonroot"]
    },
    // Tenants SSH into their OWN devices in check mode (browser re-auth). checkPeriod
    // omitted: it is Premium/Enterprise-gated in the policy-syntax reference and the
    // value we wanted (12h) is already the default, so omitting it keeps the policy
    // applyable on Standard/free tailnets. Scoped to group:tenants, NOT
    // autogroup:member, because Tailscale evaluates check BEFORE accept
    // (most-restrictive-first, regardless of rule order) - so excluding owner/admins
    // from this src is the only way to exempt fleet ops from re-auth.
    {
      "action": "check",
      "src": ["group:tenants"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"]
    }
  ],

  "nodeAttrs": [
    // Exit nodes can use Tailscale Funnel for public ingress.
    {
      "target": ["tag:exit"],
      "attr": ["funnel"]
    }
  ],

  "autoApprovers": {
    "exitNode": ["tag:exit"],
    "routes": {
      "0.0.0.0/0": ["tag:exit"],
      "::/0": ["tag:exit"]
      // NOTE: a tag:gateway travel-router's LAN subnet route is auto-approvable here,
      // but the literal CIDR is kept OUT of the repo per the no-LAN-IPs policy. Add
      // it in the admin console (Machines -> router -> approve subnet), or maintain a
      // local, uncommitted ACL overlay. tag:gateway is already granted autogroup:internet
      // above, which is what lets its clients egress once the route is approved.
    }
  }
}
