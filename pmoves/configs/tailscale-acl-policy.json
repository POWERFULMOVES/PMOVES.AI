{
  "$schema": "https://tailscale.com/api/v2/tailnet/-/acl",
  "_comment": "PMOVES.AI Tailscale ACL policy \u2014 production hardening stance. Apply at https://login.tailscale.com/admin/acls",
  "tagOwners": {
    "tag:pmoves": [
      "autogroup:admin"
    ],
    "tag:gpu": [
      "autogroup:admin"
    ],
    "tag:vps": [
      "autogroup:admin"
    ],
    "tag:lab": [
      "autogroup:admin"
    ],
    "tag:exit": [
      "autogroup:admin"
    ],
    "tag:partner": [
      "autogroup:admin"
    ],
    "tag:guest": [
      "autogroup:admin"
    ]
  },
  "acls": [
    {
      "action": "accept",
      "src": [
        "tag:pmoves"
      ],
      "dst": [
        "tag:pmoves:*"
      ],
      "comment": "Full mesh: all PMOVES nodes can reach each other on all ports"
    },
    {
      "action": "accept",
      "src": [
        "tag:lab"
      ],
      "dst": [
        "tag:gpu:*"
      ],
      "comment": "Lab nodes can reach GPU nodes for inference"
    },
    {
      "action": "accept",
      "src": [
        "tag:partner"
      ],
      "dst": [
        "tag:gpu:3030",
        "tag:gpu:8080",
        "tag:gpu:8081"
      ],
      "comment": "Partner access: Agent Zero API + UI, TensorZero Gateway only"
    },
    {
      "action": "accept",
      "src": [
        "tag:guest"
      ],
      "dst": [
        "tag:gpu:8081"
      ],
      "comment": "Guest demo: Agent Zero UI only"
    },
    {
      "action": "accept",
      "src": [
        "tag:pmoves",
        "tag:lab"
      ],
      "dst": [
        "autogroup:internet:*"
      ],
      "comment": "Exit node consume: pmoves + lab only. tag:partner and tag:guest intentionally excluded — partner is limited to 3030/8080/8081 and guest to 8081 per RUSTDESK_SELF_HOSTED.md role matrix; granting them full internet egress would be a privilege escalation vs the documented role limits."
    },
    {
      "action": "accept",
      "src": [
        "tag:pmoves"
      ],
      "dst": [
        "tag:gpu:11434",
        "tag:gpu:8200"
      ],
      "comment": "DGX Spark: Ollama inference + NIM API"
    },
    {
      "action": "accept",
      "src": [
        "tag:lab"
      ],
      "dst": [
        "tag:gpu:11434",
        "tag:gpu:8200"
      ],
      "comment": "DGX Spark: Lab nodes can access inference"
    },
    {
      "action": "accept",
      "src": [
        "tag:gpu"
      ],
      "dst": [
        "tag:pmoves:*"
      ],
      "comment": "GPU nodes can reach PMOVES mesh services (NATS, Supabase, etc)"
    },
    {
      "action": "accept",
      "src": [
        "autogroup:admin"
      ],
      "dst": [
        "*:*"
      ],
      "comment": "Admins (DARKXSIDE) have full access"
    }
  ],
  "ssh": [
    {
      "action": "accept",
      "src": [
        "tag:pmoves"
      ],
      "dst": [
        "tag:pmoves"
      ],
      "users": [
        "autogroup:nonroot"
      ],
      "comment": "SSH between PMOVES nodes \u2014 non-root only for hardening"
    },
    {
      "action": "accept",
      "src": [
        "autogroup:admin"
      ],
      "dst": [
        "*"
      ],
      "users": [
        "root",
        "autogroup:nonroot"
      ],
      "comment": "Admin SSH access (root allowed for provisioning)"
    }
  ],
  "nodeAttrs": [
    {
      "target": [
        "tag:exit"
      ],
      "attr": [
        "funnel"
      ],
      "comment": "Exit nodes can use Tailscale Funnel for public ingress"
    }
  ],
  "autoApprovers": {
    "exitNode": [
      "tag:exit"
    ],
    "routes": {
      "0.0.0.0/0": [
        "tag:exit"
      ],
      "::/0": [
        "tag:exit"
      ]
    }
  }
}
