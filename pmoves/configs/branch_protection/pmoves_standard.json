    "POWERFULMOVES/PMOVES-hermes-agent": {
      "profile": "fork",
      "branch": "PMOVES.AI-Edition-Hardened",
      "ruleset_overrides": {
        "[ main ]": {
          "rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "required_status_checks": [
                  { "context": "check-attribution" },
                  { "context": "check-common-ancestor" },
                  { "context": "ruff + ty diff" },
                  { "context": "ruff enforcement (blocking)" },
                  { "context": "Windows footguns (blocking)" },
                  { "context": "changes" },
                  { "context": "e2e" },
                  { "context": "Check PyPI dependency upper bounds" },
                  { "context": "Scan PR for critical supply chain risks" }
                ],
                "strict_required_status_checks_policy": true
              }
            }
          ]
        }
      }
    },
    "POWERFULMOVES/PMOVES-pinokio": {
      "profile": "fork",
      "_note": "branch tracks .gitmodules, NOT the GitHub default. The parent pins PMOVES.AI-Edition-Hardened; protecting `main` here left the tracked branch open, which is the exact gap this file exists to close.",
      "branch": "PMOVES.AI-Edition-Hardened",
      "ruleset_overrides": {
        "[ main ]": {
          "rules": [
            {
              "type": "required_status_checks",
              "parameters": {
                "required_status_checks": [
                  { "context": "CodeRabbit" }
                ],
                "strict_required_status_checks_policy": true
              }
            }
          ]
        }
      }
    },
    "POWERFULMOVES/PMOVES-nats-server": {
      "profile": "fork",
      "branch": "main"
    }
  }
