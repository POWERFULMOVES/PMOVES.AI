{
  "$schema": "KiloCode opencode.json — Field Agent Node (4090 Laptop)",
  "mcpServers": {
    "pmoves-cipher": {
      "type": "sse",
      "url": "http://${TS_Z890}:8105/sse",
      "description": "Agent memory (Neo4j knowledge graph) via Tailscale"
    },
    "agent-zero": {
      "type": "http",
      "url": "http://${TS_Z890}:8080/mcp",
      "description": "Agent Zero orchestrator via Tailscale"
    }
  },
  "modes": {
    "default": "pmoves-code",
    "available": [
      "pmoves-code",
      "pmoves-ask",
      "pmoves-debug",
      "pmoves-review",
      "pmoves-crush"
    ]
  },
  "modelOverrides": {
    "primary": "claude-sonnet-4",
    "fallback": "claude-haiku-4-5"
  },
  "node": {
    "identity": "4090",
    "role": "field-agent",
    "services": [
      "ollama:11434",
      "agent-zero:8080",
      "tensorzero:3030"
    ]
  }
}
