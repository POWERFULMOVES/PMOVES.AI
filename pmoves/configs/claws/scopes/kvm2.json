{
  "identity": {
    "node": "kvm2",
    "role": "exit-proxy",
    "description": "Exit proxy node \u2014 network edge, Cloudflare, headscale, VPN",
    "hostname": "kvm2"
  },
  "openclaw_overrides": {
    "agents.defaults.model.primary": "claude-haiku-4-5",
    "tools.profile": "restricted",
    "tools.exec.ask": "confirm",
    "channels": {}
  },
  "exec_approvals": {
    "main": {
      "allowlist": [
        {
          "pattern": "/usr/bin/tailscale",
          "note": "Tailscale management"
        },
        {
          "pattern": "/usr/bin/wg",
          "note": "WireGuard diagnostics"
        },
        {
          "pattern": "/usr/bin/cloudflared",
          "note": "Cloudflare tunnel management"
        },
        {
          "pattern": "/usr/bin/dig",
          "note": "DNS lookups"
        },
        {
          "pattern": "/usr/bin/traceroute",
          "note": "Network path diagnostics"
        },
        {
          "pattern": "/usr/bin/curl",
          "note": "HTTP probes and health checks"
        },
        {
          "pattern": "/usr/bin/ss",
          "note": "Socket statistics"
        },
        {
          "pattern": "/usr/bin/ip",
          "note": "Network interface inspection"
        }
      ]
    }
  },
  "mcp_servers": {
    "pmoves-cipher": {
      "description": "Agent memory (Neo4j knowledge graph)",
      "type": "sse",
      "url": "http://${TS_Z890}:8105/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${CIPHER_API_TOKEN}"
      }
    },
    "agent-zero": {
      "description": "Agent Zero orchestrator",
      "type": "http",
      "url": "http://${TS_Z890}:8080/mcp"
    },
    "tailscale": {
      "description": "Tailscale network administration",
      "command": "npx",
      "args": [
        "-y",
        "tailscale-mcp@2026.4.10-1"
      ],
      "env": {
        "TAILSCALE_API_KEY": "${TAILSCALE_API_KEY}",
        "TAILSCALE_TAILNET": "${TAILSCALE_TAILNET}"
      }
    }
  },
  "damage_control_hooks": true,
  "sign_trail": false
}
