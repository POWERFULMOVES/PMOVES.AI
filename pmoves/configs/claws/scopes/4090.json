{
  "identity": {
    "node": "4090",
    "role": "field-agent",
    "description": "Field agent — UI/CLI specialist, Crush companion, testing/evidence playbooks",
    "hostname": "pmoves-laptop"
  },
  "openclaw_overrides": {
    "agents.defaults.model.primary": "claude-sonnet-4",
    "tools.profile": "restricted",
    "tools.exec.ask": "auto",
    "channels": {
      "telegram": { "enabled": true },
      "discord": { "enabled": true }
    }
  },
  "exec_approvals": {
    "main": {
      "allowlist": [
        { "pattern": "/usr/bin/git", "note": "Git operations" },
        { "pattern": "/usr/bin/gh", "note": "GitHub CLI — PR and issue management" },
        { "pattern": "/usr/bin/curl", "note": "Health checks and API calls" },
        { "pattern": "/usr/bin/node", "note": "Node.js runtime" },
        { "pattern": "/usr/bin/python3", "note": "Python runtime" },
        { "pattern": "/usr/bin/nvidia-smi", "note": "GPU monitoring (RTX 4090 Laptop)" },
        { "pattern": "/usr/bin/ollama", "note": "Local model serving (GPU)" },
        { "pattern": "/usr/bin/tailscale", "note": "Tailscale mesh status" }
      ]
    }
  },
  "mcp_servers": {
    "pmoves-cipher": {
      "type": "sse",
      "url": "http://${TS_Z890}:8096/sse"
    },
    "agent-zero": {
      "type": "http",
      "url": "http://${TS_Z890}:8080/mcp"
    }
  },
  "damage_control_hooks": true,
  "sign_trail": true
}
