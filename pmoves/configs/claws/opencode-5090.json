{
  "$schema": "KiloCode opencode.json — GPU Inference Node (5090)",
  "mcpServers": {
    "pmoves-cipher": {
      "type": "sse",
      "url": "http://${TS_Z890}:8105/mcp/sse",
      "description": "Agent memory (Neo4j knowledge graph) via Tailscale"
    },
    "agent-zero": {
      "type": "http",
      "url": "http://${TS_Z890}:8080/mcp",
      "description": "Agent Zero orchestrator via Tailscale"
    },
    "docker": {
      "command": "docker",
      "args": ["run", "--rm", "-i", "--mount", "type=bind,src=//var/run/docker.sock,dst=/var/run/docker.sock", "mcp/docker"],
      "description": "Docker container management"
    },
    "zai-vision": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@z_ai/mcp-server"],
      "env": {
        "Z_AI_API_KEY": "${Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      },
      "description": "GLM-4.6V vision analysis, OCR, UI-to-code"
    },
    "zai-web-search": {
      "type": "streamable-http",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "description": "LLM-optimized web search"
    },
    "zai-web-reader": {
      "type": "streamable-http",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "description": "Full webpage content extraction"
    },
    "zai-zread": {
      "type": "streamable-http",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "description": "GitHub repo search and file reading"
    }
  },
  "modes": {
    "default": "pmoves-code",
    "available": [
      "pmoves-code",
      "pmoves-architect",
      "pmoves-ask",
      "pmoves-debug",
      "pmoves-review",
      "pmoves-frontend",
      "pmoves-portal",
      "pmoves-crush",
      "pmoves-glm",
      "pmoves-cocreate",
      "pmoves-minimax"
    ]
  },
  "modelOverrides": {
    "primary": "zai/glm-5.2",
    "fallback": "zai/glm-5-turbo"
  },
  "node": {
    "identity": "5090",
    "role": "gpu-inference",
    "services": [
      "ollama:11434",
      "agent-zero:8080",
      "tensorzero:3030",
      "nats:4222"
    ]
  }
}
