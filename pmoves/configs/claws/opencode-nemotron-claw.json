{
  "$schema": "KiloCode opencode.json \u2014 Nemotron Claw GPU Node",
  "mcpServers": {
    "pmoves-cipher": {
      "type": "sse",
      "url": "http://${TS_Z890}:8105/mcp/sse",
      "description": "Agent memory via Tailscale"
    },
    "agent-zero": {
      "type": "http",
      "url": "http://${TS_Z890}:8080/mcp",
      "description": "Agent Zero orchestrator via Tailscale"
    }
  },
  "modes": {
    "default": "pmoves-code",
    "available": [
      "pmoves-code",
      "pmoves-architect",
      "pmoves-ask",
      "pmoves-debug",
      "pmoves-review"
    ]
  },
  "modelOverrides": {
    "primary": "nvidia/llama-3_3-nemotron-super-49b-v1",
    "provider": "openai-compatible",
    "endpoint": "http://localhost:8000/v1",
    "fallback": "tensorzero"
  },
  "node": {
    "identity": "nemotron-claw",
    "role": "gpu-agentic",
    "services": [
      "nvidia-nim:8000",
      "tensorzero:3030",
      "agent-zero:8080",
      "nats:4222"
    ]
  }
}
