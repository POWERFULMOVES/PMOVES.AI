# PMOVES Shared Environment Configuration
# ============================================================================
# This file contains shared defaults for PMOVES services.
# Copy from env.shared.example and fill in your values.
# IMPORTANT: This file is gitignored - never commit actual secrets here.
#
# For production deployment:
# - Use Docker secrets, Vault, or your secret management system
# - Override sensitive values via env.tier-* files or runtime secrets
# - See docs/SECRETS.md for complete secret management guide
# ============================================================================

## Supabase (remote / hybrid mode)
# For local development, use default values. For production, override via
# Docker secrets or your secret management system.
SUPABASE_URL=https://your-supabase.example.com
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPA_REST_URL=http://localhost:3010
POSTGRES_HOSTNAME=supabase-db
POSTGRES_PORT=5432
POSTGRES_DB=cataclysm_pmoves
PGRST_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

## Provider API keys
# Add your API keys for OpenAI, Anthropic, Groq, etc. here or in tier files.
# See env.shared.example for the full list of supported providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

## TensorZero Gateway
TENSORZERO_BASE_URL=http://tensorzero-gateway:3000
TENSORZERO_API_KEY=

## Data storage endpoints
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=pmoves_chunks_qwen3
MEILI_URL=http://meilisearch:7700
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

## Agent services
NEXT_PUBLIC_AGENT_ZERO_URL=http://localhost:8080
NEXT_PUBLIC_ARCHON_URL=http://localhost:8091
NEXT_PUBLIC_AGENT_ZERO_UI_URL=http://localhost:8081
NEXT_PUBLIC_ARCHON_UI_URL=http://localhost:3737

## Open Notebook
OPEN_NOTEBOOK_API_URL=http://cataclysm-open-notebook:5055
OPEN_NOTEBOOK_API_TOKEN=
SURREAL_URL=ws://cataclysm-open-notebook-surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root

## Hi-RAG v2
HIRAG_V2_HOST_PORT=8086
HIRAG_V2_GPU_HOST_PORT=8087
RERANK_ENABLE=true
RERANK_TOPN=50
RERANK_K=10
SENTENCE_MODEL=all-MiniLM-L6-v2

## Console mode
SINGLE_USER_MODE=1
NEXT_PUBLIC_SINGLE_USER_MODE=1

## Smoke/health
SMOKE_SHARED_SECRET=change-me-for-local-smoke

## CHIT (production defaults - override for actual deployments)
CHIT_PASSPHRASE=
CHIT_REQUIRE_SIGNATURE=false

## Discord publisher
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=PMOVES Publisher

## Jellyfin
JELLYFIN_PUBLIC_BASE_URL=http://localhost:8096
JELLYFIN_URL=http://cataclysm-jellyfin:8096

## MinIO/S3 storage
# For local development, use MinIO. For production, point to Supabase Storage.
MINIO_ENDPOINT=minio:9000
MINIO_REGION=local
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
