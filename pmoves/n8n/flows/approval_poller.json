              "index": 0
            }
          ],
          [
            {
              "node": "No Pending Approvals",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Prepare Publish Envelope": {
        "main": [
          [
            {
              "node": "Publish Approval Event",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Publish Approval Event": {
        "main": [
          [
            {
              "node": "Mark Publish Requested",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Mark Publish Requested": {
        "main": [
          [
            {
              "node": "Split Pending Approvals",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "settings": {},
