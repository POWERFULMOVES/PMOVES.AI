# n8n environment for PMOVES automation (Supabase CLI + Agent Zero + Discord)

N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678
GENERIC_TIMEZONE=America/New_York

# Supabase (CLI on host)
SUPABASE_REST_URL=http://host.docker.internal:54321/rest/v1
SUPABASE_SERVICE_ROLE_KEY=

# Agent Zero (service in pmoves compose)
AGENT_ZERO_BASE_URL=http://agent-zero:8080
AGENT_ZERO_EVENTS_TOKEN=

# Discord webhook
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_USERNAME=PMOVES Publisher
