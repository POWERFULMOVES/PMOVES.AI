# pmoves/env.mike.example -- template for PMOVES-Mike on a PMOVES node (SPARK first).
#
# Seed:     cp pmoves/env.mike.example pmoves/env.mike      (pmoves/env.mike is gitignored)
# Hydrate:  every key marked [FUNNEL] comes from the secrets funnel
#           (`make -C pmoves secrets-funnel`, CHIT source) -- never hand-commit
#           a value, never paste one into a PR, chat or log.
# Use:      make -C pmoves up-mike   (passes this file as BOTH the compose
#           --env-file for interpolation AND the backend's env_file)
#
# Full reference: pmoves/docs/integrations/MIKE_INTEGRATION.md
# Key inventory was derived from the backend SOURCE (every process.env read
# under PMOVES-Mike/backend/src at the pinned SHA), not from upstream's
# .env.example templates, which the damage-control guard keeps zero-access.

# --- Network (interpolation only; defaults shown) ------------------------------
# Loopback is the only bind make up-mike accepts while the upstream demo
# JWT/Postgres/RustFS credentials are in use (see "Demo credentials" below).
MIKE_BIND=127.0.0.1
MIKE_FRONTEND_PORT=18300
MIKE_BACKEND_PORT=18301
MIKE_GATEWAY_PORT=18321
MIKE_DB_PORT=18322
MIKE_MAILPIT_PORT=18325
MIKE_MAILPIT_SMTP_PORT=18326
MIKE_REDIS_PORT=18379
MIKE_STORAGE_PORT=18390
MIKE_STORAGE_CONSOLE_PORT=18391
# Browser-facing URLs. Change together with the ports above (or to a
# tailnet/Traefik hostname once Mike is exposed -- which also requires the
# demo credentials below to be replaced first).
MIKE_FRONTEND_URL=http://localhost:18300
MIKE_SUPABASE_PUBLIC_URL=http://localhost:18321
MIKE_STORAGE_PUBLIC_URL=http://localhost:18390
MIKE_OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
MIKE_SENTRY_DISABLED=true
MIKE_GOOGLE_AUTH_ENABLED=false

# --- Required by the backend (it refuses to serve without them) ----------------
# [FUNNEL] 32-byte hex each, DISTINCT values (`openssl rand -hex 32`).
DOWNLOAD_SIGNING_SECRET=
USER_API_KEYS_ENCRYPTION_SECRET=

# --- Optional backend secrets ----------------------------------------------------
# [FUNNEL] falls back to USER_API_KEYS_ENCRYPTION_SECRET when empty.
MCP_CONNECTORS_ENCRYPTION_SECRET=
# [FUNNEL] Ed25519 export-manifest signing (32-byte hex). Empty = unsigned exports.
#          MiSSinGLinC's evidence-chain signing reuses this module's scheme.
MANIFEST_SIGNING_KEY=

# --- Model providers (at least one, unless Ollama-only) --------------------------
# SPARK default: Ollama on the host, no key needed. [FUNNEL] any you enable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# --- External authorities --------------------------------------------------------
# [FUNNEL] CourtListener v4 token -- MiSSinGLinC's external case-law check.
COURTLISTENER_API_TOKEN=

# --- Demo credentials (upstream compose hardcodes these; listed for the record) --
# The Supabase JWT secret, anon/service_role JWTs, Postgres password ("postgres")
# and RustFS admin pair ("rustfsadmin") are upstream's well-known local demo
# values, baked into PMOVES-Mike/docker-compose.yml and docker/db-init/roles.sql.
# They are SAFE ONLY ON LOOPBACK. Before MIKE_BIND leaves 127.0.0.1, all of
# them must be regenerated and funneled together (the anon/service_role keys
# are JWTs signed with the JWT secret -- rotate as a set). That rotation is an
# open item in MIKE_INTEGRATION.md, not something this template can do alone.
