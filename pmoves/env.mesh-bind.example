# Reviewed mesh bind overrides for nodes that must accept direct Tailscale/LAN
# traffic on selected PMOVES services.
#
# Copy only the lines you need into `pmoves/env.mesh-bind.local` (ignored).
# Do not commit live bind overrides with secrets.
#
# This file is the safe split from the abandoned "flip everything to 0.0.0.0"
# stash. It intentionally carries only reviewed service surfaces.
#
# Promote durable topology changes into tracked files like `env.z890` only
# through a separate, explicit PR.

# -----------------------------------------------------------------------------
# Control-plane / gateway surfaces
# -----------------------------------------------------------------------------
#KONG_PROXY_BIND=0.0.0.0
#AGENT_ZERO_BIND=0.0.0.0
#TENSORZERO_BIND=0.0.0.0
#FLUTE_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# Retrieval / orchestration surfaces
# -----------------------------------------------------------------------------
#HIRAG_V1_BIND=0.0.0.0
#HIRAG_BIND=0.0.0.0
#DEEPRESEARCH_BIND=0.0.0.0
#SUPASERCH_BIND=0.0.0.0
#PMOVES_YT_BIND=0.0.0.0
#CHANNEL_MONITOR_BIND=0.0.0.0
#GPU_ORCHESTRATOR_BIND=0.0.0.0
#EVO_CONTROLLER_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# Media surfaces
# -----------------------------------------------------------------------------
#TTS_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# Already mesh-default in base compose (documented here so operators do not
# cargo-cult them into broader blanket edits)
# -----------------------------------------------------------------------------
#NATS_BIND=0.0.0.0
#BOTZ_BIND=0.0.0.0
#PUBLISHER_DISCORD_BIND=0.0.0.0
#PMOVES_UI_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# Never widen from this file without a separate security review
# -----------------------------------------------------------------------------
