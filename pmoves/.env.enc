# =============================================================================
# PMOVES.AI Encrypted Credentials Template
# =============================================================================
# This file is tracked in git and will be encrypted using git-crypt.
#
# SETUP:
#   1. Install git-crypt: apt install git-crypt (or brew install git-crypt)
#   2. Initialize: git-crypt init
#   3. Add your GPG key: git-crypt add-gpg-user your.email@example.com
#   4. Fill in your actual values below
#   5. Commit: git add .env.enc && git commit -m "feat: add encrypted credentials"
#   6. File will be automatically encrypted on commit
#
# USAGE:
#   Run bootstrap: source pmoves/scripts/bootstrap_credentials.sh
#   The script will detect if this file is decrypted and load credentials.
# =============================================================================

# LLM Provider Keys (fill in your actual values)
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key-here
GROQ_API_KEY=gsk-your-groq-api-key-here
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here
PERPLEXITYAI_API_KEY=pplx-your-perplexity-api-key-here
TOGETHER_AI_API_KEY=tgp_v1-your-together-api-key-here
COHERE_API_KEY=your-cohere-api-key-here
FIREWORKS_AI_API_KEY=fw_your-fireworks-api-key-here
XAI_API_KEY=xai-your-xai-api-key-here
ELEVENLABS_API_KEY=sk-your-elevenlabs-api-key-here

# Additional Services (fill in as needed)
OLLAMA_API_KEY=your-ollama-api-key-if-needed
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here

# Discord / Telegram
DISCORD_WEBHOOK_URL=your-discord-webhook-url-here
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# =============================================================================
# End of encrypted credentials template
# =============================================================================
