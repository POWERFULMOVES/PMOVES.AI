# PMOVES.AI API Tier Environment Configuration
# Source env.shared first, then source this file
# Tier: API (MCP bridge is an API tier service)

# ============================================================================
# API Tier Settings
# ============================================================================

export TIER=api
export MAX_CONCURRENT_REQUESTS=${MAX_CONCURRENT_REQUESTS:-100}
export RATE_LIMIT_ENABLED=${RATE_LIMIT_ENABLED:-true}

# ============================================================================
# MCP Bridge API Tier Configuration
# ============================================================================

# MCP bridge operates as API tier service
export MCP_BRIDGE_MODE=${MCP_BRIDGE_MODE:-true}
